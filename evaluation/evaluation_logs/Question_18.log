matplotlib.use('Agg')
def filter_tall_or_highlevel_buildings(data: list):
    import geopandas as gpd
    import pandas as pd
    
    gdf = data[0]
    # Ensure 'height' and 'building:levels' are present and convert to numeric
    gdf['height'] = pd.to_numeric(gdf['height'], errors='coerce')
    gdf['building:levels'] = pd.to_numeric(gdf['building:levels'], errors='coerce')
    
    # Filter for height > 18 or building:levels >= 7
    filtered = gdf[(gdf['height'] > 18) | (gdf['building:levels'] >= 7)]
    
    # Save to geojson
    filtered.to_file('tall_or_highlevel_buildings_bradninch.geojson', driver='GeoJSON')
    
    summary = f"Filtered buildings with height > 18m or building:levels >= 7. Total: {len(filtered)} entries."
    artifact_name = 'tall_or_highlevel_buildings_bradninch.geojson'
    artifact_description = 'GeoDataFrame of buildings in Bradninch where height > 18 metres or building:levels >= 7.'
    return [summary, artifact_name, artifact_description, filtered]

