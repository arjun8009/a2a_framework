matplotlib.use('Agg')
def plot_tall_buildings_bradninch(data: list):
    import folium
    import geopandas as gpd
    from shapely.geometry import mapping
    
    # Unpack data
    buildings = data[0].copy()
    boundary = data[1].copy()
    
    # Ensure CRS is EPSG:4326 for folium
    if buildings.crs is not None and buildings.crs.to_epsg() != 4326:
        buildings = buildings.to_crs(epsg=4326)
    if boundary.crs is not None and boundary.crs.to_epsg() != 4326:
        boundary = boundary.to_crs(epsg=4326)
    
    # Get centroid for map initialization
    centroid = buildings.unary_union.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=15, tiles='cartodbpositron')
    
    # Plot boundary
    folium.GeoJson(
        boundary,
        name='Bradninch Boundary',
        style_function=lambda x: {'color': 'blue', 'weight': 2, 'fillOpacity': 0.05}
    ).add_to(m)
    
    # Plot tall buildings
    folium.GeoJson(
        buildings,
        name='Tall Buildings',
        style_function=lambda x: {'color': 'red', 'weight': 2, 'fillOpacity': 0.4},
        tooltip=folium.GeoJsonTooltip(fields=['id', 'height', 'building:levels', 'tags'])
    ).add_to(m)
    
    folium.LayerControl().add_to(m)
    
    # Save map
    map_filename = 'tall_buildings_bradninch_map.html'
    m.save(map_filename)
    
    # Prepare summary
    summary_rows = buildings[['id', 'height', 'building:levels', 'tags']].head(5)
    summary = f"Plotted {len(buildings)} tall/high-level buildings (>18m or >=7 storeys) in Bradninch. First 5 entries:\n" + summary_rows.to_string(index=False)
    
    return [
        summary,
        'tall_buildings_bradninch_map',
        'Folium map showing tall/high-level buildings (>18m or >=7 storeys) in Bradninch with the administrative boundary.',
        map_filename
    ]

