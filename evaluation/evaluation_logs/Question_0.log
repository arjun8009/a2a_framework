2026-04-02 11:02:55,815 INFO Executing code import matplotlib
matplotlib.use('Agg')
def plot_bickington_buildings_buffer_map(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import Polygon
    from shapely.ops import unary_union
    
    # Unpack data
    bickington_gdf = data[0]
    buildings_gdf = data[1]

    # Ensure all are in the same CRS (EPSG:4326 for folium)
    bickington_gdf = bickington_gdf.to_crs(epsg=4326)
    buildings_gdf = buildings_gdf.to_crs(epsg=4326)

    # Get the Bickington polygon (should be only one row)
    bickington_poly = bickington_gdf.iloc[0].geometry

    # Create 1km buffer (1000 meters)
    # Project to a metric CRS for buffering, then back to EPSG:4326
    bickington_metric = bickington_gdf.to_crs(epsg=27700)
    buffer_1km_metric = bickington_metric.geometry.buffer(1000)
    buffer_1km = gpd.GeoSeries(buffer_1km_metric).set_crs(epsg=27700).to_crs(epsg=4326)
    buffer_1km_poly = buffer_1km.iloc[0]

    # Find buildings within 1km buffer
    buildings_within_1km = buildings_gdf[buildings_gdf.intersects(buffer_1km_poly)]

    # Create buffer ring (difference between 1km buffer and the parish polygon)
    bickington_poly_4326 = bickington_gdf.iloc[0].geometry
    buffer_ring = buffer_1km_poly.difference(bickington_poly_4326)

    # Center map on Bickington
    centroid = bickington_poly_4326.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13, tiles='cartodbpositron')

    # Add Bickington boundary (red outline, transparent fill)
    folium.GeoJson(
        bickington_poly_4326,
        name='Bickington Boundary',
        style_function=lambda x: {
            'color': 'red', 'weight': 4, 'fillOpacity': 0.05, 'fillColor': 'red'
        },
        tooltip='Bickington Civil Parish'
    ).add_to(m)

    # Add 1km buffer ring (light transparent shading)
    folium.GeoJson(
        buffer_ring,
        name='1km Buffer Zone',
        style_function=lambda x: {
            'color': 'blue', 'weight': 1, 'fillOpacity': 0.15, 'fillColor': '#99ccff'
        },
        tooltip='1km Buffer Zone'
    ).add_to(m)

    # Add buildings within 1km (semi-transparent blue)
    folium.GeoJson(
        buildings_within_1km,
        name='Buildings within 1km',
        style_function=lambda x: {
            'color': '#0033cc', 'weight': 1, 'fillOpacity': 0.4, 'fillColor': '#3399ff'
        },
        tooltip=folium.GeoJsonTooltip(fields=['id', 'building'], aliases=['Building ID', 'Type'])
    ).add_to(m)

    folium.LayerControl().add_to(m)

    # Save map
    map_filename = 'bickington_buildings_buffer_map.html'
    m.save(map_filename)

    summary = f"Map shows the Bickington parish boundary (red), a 1km buffer ring (light blue), and {len(buildings_within_1km)} buildings within the buffer. First 5 building IDs: {list(buildings_within_1km['id'].head())}."
    artifact_name = 'bickington_buildings_buffer_map'
    artifact_description = 'Interactive folium map with Bickington boundary, 1km buffer ring, and all buildings within 1km of the boundary.'
    return [summary, artifact_name, artifact_description, map_filename]

