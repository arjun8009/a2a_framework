def filter_ivybridge_boundary(data: list):
    import geopandas as gpd
    # The relevant columns for filtering are 'name' and 'boundary'.
    gdf = data[0]
    # Filter for rows where the name is 'Ivybridge' (case-insensitive, exact match)
    # and boundary is likely a polygon type (not marker, post, stone, etc.)
    # We'll include common boundary types for administrative areas.
    mask = (
        gdf['name'].str.lower() == 'ivybridge'
    ) & (
        gdf['boundary'].isin([
            'administrative', 'political', 'statistical', 'place', 'land_parcel', 'protected_area', 'ceremonial', 'historic:administrative', 'historic', 'traditional'
        ])
    )
    ivybridge_filtered = gdf[mask]
    summary = f"Filtered to {len(ivybridge_filtered)} boundary polygons for 'Ivybridge'."
    return [
        summary,
        'ivybridge_filtered_boundary',
        "GeoDataFrame containing the boundary polygon(s) for the named area 'Ivybridge' in the UK, filtered by name and appropriate boundary types.",
        ivybridge_filtered
    ]
# CODE EXECUTOR TOOL ONLY ACCEPTS THE FUNCTION SO WRITE FUNCTION AND USE CODE EXECUTOR TOOL

