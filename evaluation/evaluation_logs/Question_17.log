matplotlib.use('Agg')
def plot_ivybridge_boundary_and_3plus_buildings(data: list):
    import folium
    import geopandas as gpd
    from shapely.geometry import mapping
    
    # Unpack data
    boundary_gdf = data[0]
    buildings_gdf = data[1]
    
    # Ensure both are in EPSG:4326
    boundary_gdf = boundary_gdf.to_crs(epsg=4326)
    buildings_gdf = buildings_gdf.to_crs(epsg=4326)
    
    # Get centroid of boundary for map centering
    centroid = boundary_gdf.geometry.centroid.iloc[0]
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=14)
    
    # Plot boundary
    folium.GeoJson(
        boundary_gdf,
        name='Ivybridge Boundary',
        style_function=lambda x: {'color': 'blue', 'weight': 3, 'fillOpacity': 0}
    ).add_to(m)
    
    # Prepare summary
    summary_rows = []
    
    # Plot buildings with popups
    for idx, row in buildings_gdf.iterrows():
        geom = row['geometry']
        name = row['name'] if 'name' in row and pd.notnull(row['name']) else '(Unnamed)'
        levels = row['building:levels'] if 'building:levels' in row and pd.notnull(row['building:levels']) else row['levels'] if 'levels' in row and pd.notnull(row['levels']) else 'N/A'
        popup_text = f"Name: {name}<br>Levels: {levels}"
        folium.GeoJson(
            geom,
            name=f"Building {idx}",
            style_function=lambda x: {'color': 'red', 'weight': 2, 'fillOpacity': 0.5},
            tooltip=folium.Tooltip(popup_text)
        ).add_to(m)
        summary_rows.append({'name': name, 'levels': levels})
    
    # Save map
    map_filename = 'ivybridge_boundary_buildings_3plus.html'
    m.save(map_filename)
    
    # Prepare summary output
    summary_str = f"Plotted Ivybridge boundary and {len(buildings_gdf)} buildings with 3+ floors. First 5 buildings:\n"
    for entry in summary_rows[:5]:
        summary_str += f"- {entry['name']} (Levels: {entry['levels']})\n"
    
    artifact_name = 'ivybridge_boundary_buildings_3plus_map'
    artifact_desc = 'Folium map showing Ivybridge boundary and buildings with 3+ floors, with popups for building name and number of levels.'
    return [summary_str, artifact_name, artifact_desc, map_filename]
