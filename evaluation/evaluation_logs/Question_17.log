matplotlib.use('Agg')
def filter_buildings_3plus_levels(data: list):
    import geopandas as gpd
    import pandas as pd
    gdf = data[0]
    # Convert 'building:levels' and 'levels' to numeric, coerce errors to NaN
    gdf['building:levels_num'] = pd.to_numeric(gdf['building:levels'], errors='coerce')
    gdf['levels_num'] = pd.to_numeric(gdf['levels'], errors='coerce')
    # Filter where either column is >= 3
    filtered = gdf[(gdf['building:levels_num'] >= 3) | (gdf['levels_num'] >= 3)]
    filtered = filtered.drop(columns=['building:levels_num', 'levels_num'])
    summary = f"Filtered buildings with 3 or more levels. Number of buildings: {len(filtered)}."
    artifact_name = 'ivybridge_buildings_3plus_levels.geojson'
    artifact_description = 'GeoDataFrame of Ivybridge buildings where either building:levels or levels is greater than or equal to 3.'
    return [summary, artifact_name, artifact_description, filtered]

