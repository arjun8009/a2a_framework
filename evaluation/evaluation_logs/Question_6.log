matplotlib.use('Agg')
def plot_buildings_within_1km_of_teignmouth_boundary(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import Polygon

    # Unpack data
    buildings = data[0]
    teignmouth_boundary = data[1]

    # Ensure both are in the same CRS (convert to EPSG:4326 for folium)
    if buildings.crs != 'EPSG:4326':
        buildings = buildings.to_crs('EPSG:4326')
    if teignmouth_boundary.crs != 'EPSG:4326':
        teignmouth_boundary = teignmouth_boundary.to_crs('EPSG:4326')

    # Get the boundary polygon
    boundary_geom = teignmouth_boundary.iloc[0].geometry

    # Create a 1km (1000m) buffer around the boundary
    # Buffering should be done in meters, so project to a metric CRS first
    metric_crs = 'EPSG:3857'
    buildings_metric = buildings.to_crs(metric_crs)
    boundary_metric = teignmouth_boundary.to_crs(metric_crs)
    boundary_buffer = boundary_metric.iloc[0].geometry.buffer(1000)

    # Select buildings within the buffer
    buildings_within_buffer = buildings_metric[buildings_metric.geometry.intersects(boundary_buffer)]
    # Convert back to EPSG:4326 for plotting
    buildings_within_buffer = buildings_within_buffer.to_crs('EPSG:4326')

    # Prepare folium map centered on Teignmouth
    centroid = boundary_geom.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13)

    # Add boundary
    folium.GeoJson(teignmouth_boundary, name='Teignmouth Boundary', style_function=lambda x: {'color': 'blue', 'weight': 3, 'fillOpacity': 0.05}).add_to(m)

    # Add buildings within 1km buffer
    folium.GeoJson(buildings_within_buffer, name='Buildings within 1km', style_function=lambda x: {'color': 'red', 'weight': 1, 'fillOpacity': 0.3}).add_to(m)

    # Add buffer for context
    folium.GeoJson(gpd.GeoDataFrame(geometry=[boundary_buffer], crs=metric_crs).to_crs('EPSG:4326'), name='1km Buffer', style_function=lambda x: {'color': 'green', 'weight': 2, 'fillOpacity': 0.05, 'dashArray': '5, 5'}).add_to(m)

    folium.LayerControl().add_to(m)

    # Save map
    map_filename = 'teignmouth_buildings_within_1km.html'
    m.save(map_filename)

    # Prepare summary
    summary = f"There are {len(buildings_within_buffer)} buildings within 1km of the Teignmouth boundary. First 5 building IDs: {list(buildings_within_buffer['id'].head(5))}"
    artifact_name = 'teignmouth_buildings_within_1km_map'
    artifact_description = 'A folium map showing buildings within 1km of the Teignmouth administrative boundary, with the boundary and buffer for context.'
    return [summary, artifact_name, artifact_description, map_filename]

