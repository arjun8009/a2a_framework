matplotlib.use('Agg')
def filter_houses_with_basement(data: list):
    import geopandas as gpd
    import pandas as pd
    
    gdf = data[0]
    # Ensure all relevant columns exist
    for col in ['basement', 'building:levels:underground', 'building:part', 'level']:
        if col not in gdf.columns:
            gdf[col] = None
    
    # Apply filtering criteria
    mask = (
        (gdf['basement'].astype(str).str.lower() == 'yes') |
        (pd.to_numeric(gdf['building:levels:underground'], errors='coerce').fillna(0) > 0) |
        (gdf['building:part'].astype(str).str.lower() == 'basement') |
        (gdf['level'].astype(str) == '-1')
    )
    filtered_gdf = gdf[mask].copy()
    
    # Only return the building polygons (geometry)
    filtered_gdf = filtered_gdf[['geometry']]
    
    summary = f"Filtered {len(filtered_gdf)} houses with basement from {len(gdf)} total houses."
    artifact_name = 'houses_with_basement_in_filtered_uplowman_boundary.geojson'
    artifact_description = 'GeoDataFrame of houses with a basement in the filtered Uplowman boundary, containing only the building polygons.'
    return [summary, artifact_name, artifact_description, filtered_gdf]

