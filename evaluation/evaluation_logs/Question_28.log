matplotlib.use('Agg')
def filter_monkokehampton_data(data: list):
    import pandas as pd
    import geopandas as gpd
    
    # Assume the input is a GeoDataFrame
    gdf = data[0]
    
    # Filter using multiple columns for high-quality search
    # Check for Monkokehampton in 'name', 'tags', and possibly in 'operator' or other relevant columns
    mask = (
        gdf['name'].str.contains('Monkokehampton', case=False, na=False) |
        gdf['tags'].str.contains('Monkokehampton', case=False, na=False) |
        gdf['operator'].str.contains('Monkokehampton', case=False, na=False)
    )
    filtered = gdf[mask]
    
    summary = f"Filtered data for Monkokehampton. Number of entries: {len(filtered)}."
    artifact_name = 'filtered_monkokehampton'
    artifact_description = 'GeoDataFrame containing only entries relevant to Monkokehampton, filtered using name, tags, and operator columns.'
    artifact_data = filtered
    
    return [summary, artifact_name, artifact_description, artifact_data]

