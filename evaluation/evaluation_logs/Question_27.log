matplotlib.use('Agg')
def filter_bideford_boundary(data: list):
    import geopandas as gpd
    import pandas as pd
    
    gdf = data[0]
    # Filter for Bideford boundary in Devon, UK
    # Use multiple columns: 'name' for Bideford, 'boundary' for relevant types, and 'tags' for Devon
    # 'name' may contain 'Bideford', 'tags' may contain 'Devon', and 'boundary' should be administrative or similar
    
    # Lowercase search for robustness
    mask_name = gdf['name'].fillna('').str.lower().str.contains('bideford')
    mask_tags = gdf['tags'].fillna('').str.lower().str.contains('devon')
    mask_boundary = gdf['boundary'].isin(['administrative', 'political', 'statistical', 'historic:administrative', 'ceremonial'])
    
    filtered = gdf[mask_name & mask_boundary]
    # If not enough results, also check tags for 'devon'
    if filtered.empty:
        filtered = gdf[(mask_name & mask_tags & mask_boundary) | (mask_name & mask_boundary)]
    
    summary = f"Filtered boundary for Bideford in Devon, UK. Number of entries: {len(filtered)}."
    artifact_name = 'filtered_bideford_boundary'
    artifact_description = 'GeoDataFrame containing the boundary for Bideford in Devon, UK, filtered using name, boundary type, and tags.'
    return [summary, artifact_name, artifact_description, filtered]

