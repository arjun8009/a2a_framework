matplotlib.use('Agg')
def plot_tree_areas_within_bideford(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import mapping
    
    # Unpack data
    tree_areas = data[0]
    bideford_boundary = data[1]
    
    # Ensure CRS is EPSG:4326 for folium
    if tree_areas.crs != 'EPSG:4326':
        tree_areas = tree_areas.to_crs('EPSG:4326')
    if bideford_boundary.crs != 'EPSG:4326':
        bideford_boundary = bideford_boundary.to_crs('EPSG:4326')
    
    # Filter tree areas within the Bideford boundary
    bideford_geom = bideford_boundary.iloc[0].geometry
    tree_areas_within = tree_areas[tree_areas.geometry.within(bideford_geom)]
    
    # Center map on Bideford boundary centroid
    centroid = bideford_geom.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13, tiles='cartodbpositron')
    
    # Plot tree areas
    folium.GeoJson(
        tree_areas_within,
        name='Tree Areas',
        style_function=lambda x: {'fillColor': 'green', 'color': 'green', 'weight': 1, 'fillOpacity': 0.5},
        tooltip=folium.GeoJsonTooltip(fields=['natural', 'id'], aliases=['Type', 'OSM ID'])
    ).add_to(m)
    
    # Overlay Bideford boundary
    folium.GeoJson(
        bideford_boundary,
        name='Bideford Boundary',
        style_function=lambda x: {'fillColor': 'none', 'color': 'blue', 'weight': 3, 'fillOpacity': 0},
        tooltip=folium.GeoJsonTooltip(fields=['name'], aliases=['Boundary'])
    ).add_to(m)
    
    folium.LayerControl().add_to(m)
    m.save('tree_areas_bideford_map.html')
    
    # Prepare summary
    summary = f"Plotted {len(tree_areas_within)} tree areas within the Bideford boundary. First 5 IDs: {tree_areas_within['id'].head(5).tolist()}"
    artifact_name = 'tree_areas_bideford_map.html'
    artifact_description = 'Folium map showing all tree areas within the Bideford administrative boundary, with the boundary outlined in blue.'
    artifact_data = artifact_name
    return [summary, artifact_name, artifact_description, artifact_data]

