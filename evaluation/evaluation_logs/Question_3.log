2026-04-01 16:31:15,407 INFO Executing code import matplotlib
matplotlib.use('Agg')
def plot_buildings_within_1km_of_centroid(data: list):
    import geopandas as gpd
    from shapely.geometry import Point
    import folium
    
    # Unpack data
    buildings = data[0]
    boundary = data[1]
    
    # Ensure both are in the same CRS for spatial operations
    if buildings.crs != boundary.crs:
        buildings = buildings.to_crs(boundary.crs)
    
    # Get the centroid of the Newton St. Cyres boundary
    boundary_geom = boundary.iloc[0].geometry
    centroid = boundary_geom.centroid
    
    # Create a 1 km buffer around the centroid (buffer in meters, assuming projected CRS)
    buffer_1km = centroid.buffer(1000)
    
    # Select buildings whose geometry intersects with the buffer
    buildings_within_1km = buildings[buildings.geometry.intersects(buffer_1km)]
    
    # Convert everything to EPSG:4326 for folium
    buffer_gdf = gpd.GeoDataFrame(geometry=[buffer_1km], crs=buildings.crs).to_crs(epsg=4326)
    buildings_within_1km = buildings_within_1km.to_crs(epsg=4326)
    centroid_wgs = gpd.GeoSeries([centroid], crs=buildings.crs).to_crs(epsg=4326).iloc[0]
    
    # Create folium map centered at centroid
    m = folium.Map(location=[centroid_wgs.y, centroid_wgs.x], zoom_start=15)
    
    # Add buffer
    folium.GeoJson(buffer_gdf.geometry.iloc[0], name='1km Buffer', style_function=lambda x: {'color': 'blue', 'fill': False, 'weight': 2}).add_to(m)
    
    # Add buildings
    folium.GeoJson(buildings_within_1km, name='Buildings', style_function=lambda x: {'color': 'red', 'fill': True, 'weight': 1, 'fillOpacity': 0.4}).add_to(m)
    
    # Add centroid marker
    folium.Marker([centroid_wgs.y, centroid_wgs.x], popup='Centroid').add_to(m)
    
    # Save map
    map_filename = 'buildings_within_1km_of_centroid.html'
    m.save(map_filename)
    
    # Prepare summary
    n_buildings = len(buildings_within_1km)
    summary_rows = buildings_within_1km[['id', 'name', 'building', 'geometry']].head(5)
    summary = f"Number of buildings within 1 km of centroid: {n_buildings}. First 5 entries:\n{summary_rows}"
    
    return [summary, map_filename, 'Folium map showing all buildings within 1 km of the centroid of Newton St. Cyres boundary, with buffer and centroid marked.', map_filename]

