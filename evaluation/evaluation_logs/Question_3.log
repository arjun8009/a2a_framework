def filter_newton_st_cyres_mid_devon(data:list):
    import pandas as pd
    import geopandas as gpd
    # The input is expected to be a list with a single GeoDataFrame
    gdf = data[0]
    # Filter for name exactly 'Newton St. Cyres' (with period) and operator or tags indicating Mid Devon
    # Since 'operator' may be null, also check 'tags' for 'Mid Devon' if present
    filtered = gdf[(gdf['name'].str.strip().str.lower() == 'newton st. cyres') & (
        gdf['operator'].fillna('').str.lower().str.contains('mid devon') |
        gdf['tags'].fillna('').str.lower().str.contains('mid devon')
    )]
    summary = f"Filtered GeoDataFrame for named area 'Newton St. Cyres' within Mid Devon. Number of entries: {len(filtered)}."
    artifact_name = 'filtered_newton_st_cyres_mid_devon'
    artifact_description = "GeoDataFrame containing only the entries for 'Newton St. Cyres' specifically within Mid Devon, using both 'name' and 'operator'/'tags' columns. Includes all original columns and geometry."
    if len(filtered) == 0:
        return ["No entries found for 'Newton St. Cyres' within Mid Devon.", None, None, None]
    return [summary, artifact_name, artifact_description, filtered]

