2026-03-31 13:38:28,767 INFO Executing code import matplotlib
matplotlib.use('Agg')
import folium

def plot_exeter_buildings_over_10m(data: list):
    gdf = data[0]
    # Ensure CRS is EPSG:4326 for folium
    if gdf.crs is not None and gdf.crs.to_epsg() != 4326:
        gdf = gdf.to_crs(epsg=4326)
    # Get centroid for map center
    centroid = gdf.geometry.centroid.unary_union.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=15)
    # Add polygons to map
    folium.GeoJson(gdf, name='Buildings >10m', tooltip=folium.GeoJsonTooltip(fields=['name', 'height', 'building', 'shop', 'amenity'])).add_to(m)
    # Save map
    map_filename = 'exeter_buildings_over_10m_map.html'
    m.save(map_filename)
    # Prepare summary
    summary = (
        f"There are {len(gdf)} buildings in Exeter over 10m in height according to OSM data.\n"
        f"First 5 results:\n" + str(gdf[['name', 'height', 'building', 'shop', 'amenity']].head(5))
    )
    artifact_name = 'exeter_buildings_over_10m_map'
    artifact_description = 'A folium map showing all buildings in Exeter over 10m in height, based on OSM data.'
    return [summary, artifact_name, artifact_description, map_filename]

