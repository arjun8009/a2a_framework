matplotlib.use('Agg')
def filter_exeter_polygon(data: list):
    # The relevant columns for identifying Exeter are likely 'name1_text', 'descriptiongroup', and 'description'.
    gdf = data[0]
    # Filter for rows where the name is 'Exeter' and the type is a settlement/city/town
    filtered = gdf[
        (
            (gdf['name1_text'].str.lower() == 'exeter') &
            (gdf['descriptiongroup'].isin(['Settlement', 'Land Name', 'Other Name'])) &
            (gdf['description'].isin(['City', 'Town', 'Part Of Settlement', 'Suburban Area']))
        )
    ]
    summary = f"Filtered Exeter polygon: {len(filtered)} entries found."
    artifact_name = 'filtered_exeter_polygon'
    artifact_description = 'Polygon(s) from exeter_polygon corresponding to Exeter as a city, town, or settlement.'
    return [summary, artifact_name, artifact_description, filtered]

