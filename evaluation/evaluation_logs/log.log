def filter_topsham_ward_boundary(data: list):
    import pandas as pd
    gdf = data[0]
    # Filter for 'Topsham Ward' in the 'name' column (case-insensitive, exact match)
    filtered = gdf[gdf['name'].str.lower() == 'topsham ward']
    summary = f"Filtered Topsham Ward boundary: {len(filtered)} entries found."
    artifact_name = 'filtered_topsham_ward_boundary'
    artifact_description = (
        "GeoDataFrame containing only the boundary polygon(s) for 'Topsham Ward', "
        "filtered using the 'name' column. Columns include: "
        "'visible', 'tags', 'lon', 'timestamp', 'lat', 'version', 'id', 'changeset', 'name', "
        "'operator', 'boundary', 'marker', 'start_date', 'osm_type', 'website', 'admin_level', 'geometry'. "
        f"Number of rows: {len(filtered)}. Geometry column contains the boundary polygon(s)."
    )
    return [summary, artifact_name, artifact_description, filtered]

