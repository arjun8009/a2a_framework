matplotlib.use('Agg')
def filter_exeter_polygon(data: list):
    import geopandas as gpd
    # The relevant columns for identifying Exeter are likely 'name1_text', 'description', and 'descriptiongroup'.
    gdf = data[0]
    # Filter for rows where the main name is 'Exeter' and the type is a settlement/city/town
    filtered = gdf[
        (gdf['name1_text'].str.lower() == 'exeter') &
        (gdf['description'].str.lower().isin(['city', 'town', 'suburban area', 'part of settlement', 'village'])) &
        (gdf['descriptiongroup'].str.lower().isin(['settlement']))
    ]
    summary = f"Filtered polygon(s) for Exeter found: {len(filtered)} row(s)."
    artifact_name = 'filtered_exeter_polygon_data'
    artifact_description = 'GeoDataFrame containing only the polygon(s) corresponding to Exeter, filtered by name and settlement type.'
    return [summary, artifact_name, artifact_description, filtered]

