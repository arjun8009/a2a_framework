2026-03-31 13:36:53,500 INFO Executing code import matplotlib
matplotlib.use('Agg')
def filter_exeter_area_polygon(data: list):
    import geopandas as gpd
    # The input is a list with one GeoDataFrame
    gdf = data[0]
    # Filter for polygons most relevant to Exeter
    # Use 'name' column for 'Exeter', and also check 'boundary' and 'admin_level' for relevance
    # Typical relevant boundaries: 'administrative', 'political', 'place'
    # Typical relevant admin_levels for city: 8, 10, 11 (from OSM conventions)
    exeter_polygons = gdf[
        (gdf['name'].str.contains('Exeter', case=False, na=False)) &
        (gdf['boundary'].isin(['administrative', 'political', 'place'])) &
        (gdf['admin_level'].isin(['8', '10', '11']))
    ]
    summary = f"Filtered polygons for Exeter: {len(exeter_polygons)} entries found."
    artifact_name = 'filtered_exeter_area_polygon'
    artifact_description = 'GeoDataFrame containing polygons most relevant to the area named Exeter, filtered by name, boundary type, and admin level.'
    return [summary, artifact_name, artifact_description, exeter_polygons]

