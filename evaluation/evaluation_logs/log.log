matplotlib.use('Agg')
def filter_fish_and_chips_addresses(data: list):
    import pandas as pd
    import geopandas as gpd
    
    gdf = data[0]
    # Filter for likely fish and chips related addresses using multiple columns
    # We'll search for common fish and chips keywords in organisationname, name, subname, and fulladdress
    keywords = [
        'fish', 'chip', 'chippy', 'fryer', 'plaice', 'cod', 'catch', 'fisheries', 'seafood', 'fry', 'grill', 'takeaway', 'take away'
    ]
    
    # Combine relevant columns into a single string for each row for robust searching
    def row_contains_keywords(row):
        search_str = ' '.join([
            str(row.get('organisationname', '')),
            str(row.get('name', '')),
            str(row.get('subname', '')),
            str(row.get('fulladdress', ''))
        ]).lower()
        return any(kw in search_str for kw in keywords)
    
    filtered = gdf[gdf.apply(row_contains_keywords, axis=1)]
    
    summary = f"Filtered fish and chips related addresses in Exeter. Number of entries: {len(filtered)}."
    artifact_name = 'filtered_fish_and_chips_exeter'
    artifact_description = (
        "A GeoDataFrame containing addresses in Exeter that are likely related to fish and chips establishments. "
        "Filtering was performed using keywords in the columns: organisationname, name, subname, and fulladdress."
    )
    return [summary, artifact_name, artifact_description, filtered]

