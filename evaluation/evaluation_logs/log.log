matplotlib.use('Agg')
def filter_exeter_polygon_data(data: list):
    import geopandas as gpd
    # The relevant columns for identifying Exeter are likely 'name1_text', 'description', and 'descriptiongroup'.
    gdf = data[0]
    # Filter for polygons where the name or description is 'Exeter' and the type is relevant (e.g., City, Settlement, Town, Part Of Settlement, Suburban Area)
    exeter_names = ['Exeter']
    relevant_descriptions = ['City', 'Town', 'Part Of Settlement', 'Suburban Area', 'Settlement']
    filtered = gdf[((gdf['name1_text'].str.lower() == 'exeter') |
                    (gdf['name1_text'].str.lower().str.contains('exeter', na=False))) &
                   (gdf['description'].isin(relevant_descriptions))]
    summary = f"Filtered Exeter polygon data: {len(filtered)} entries found."
    artifact_name = 'filtered_exeter_polygon_data'
    artifact_description = 'Polygon data filtered to only include entries specifically for Exeter, using name and relevant description types.'
    return [summary, artifact_name, artifact_description, filtered]

