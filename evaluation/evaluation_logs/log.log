matplotlib.use('Agg')
def filter_buildings_height_gt_5(data: list):
    import geopandas as gpd
    # The height column is of type object, so we need to convert it to float for comparison
    gdf = data[0]
    # Remove rows where height is missing or not a valid number
    gdf_filtered = gdf.copy()
    gdf_filtered = gdf_filtered[gdf_filtered['height'].notnull()]
    # Convert height to float, coerce errors to NaN and drop those
    gdf_filtered['height'] = gdf_filtered['height'].astype(str).str.replace(',', '.').astype(float)
    gdf_filtered = gdf_filtered[gdf_filtered['height'] > 5]
    summary = f"Filtered buildings with height > 5. Number of buildings: {len(gdf_filtered)}."
    artifact_name = 'exeter_buildings_height_gt_5.geojson'
    artifact_description = 'GeoDataFrame of building polygons in Exeter where the height attribute is greater than 5.'
    return [summary, artifact_name, artifact_description, gdf_filtered]

