matplotlib.use('Agg')
def filter_houses_1floor_exeter(data: list):
    import geopandas as gpd
    # Extract the GeoDataFrame
    gdf = data[0]
    # Apply the house definition and 1 floor filter
    filtered = gdf[
        (gdf['buildinguse_addresscount_residential'] > 0) &
        (gdf['buildinguse_addresscount_total'] == 1) &
        (gdf['numberoffloors'] == 1)
    ]
    # Save to geojson
    filtered.to_file('houses_1floor_exeter.geojson', driver='GeoJSON')
    summary = f"Filtered houses with 1 floor: {len(filtered)} entries."
    description = (
        "GeoDataFrame containing houses in Exeter with exactly 1 floor. "
        "A house is defined as having buildinguse_addresscount_residential > 0 "
        "and buildinguse_addresscount_total = 1, and numberoffloors = 1. "
        "All geometry and attributes are preserved."
    )
    return [summary, 'houses_1floor_exeter.geojson', description, filtered]

