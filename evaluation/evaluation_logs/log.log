matplotlib.use('Agg')
def filter_buildings_height_gt3(data: list):
    import geopandas as gpd
    import pandas as pd
    gdf = data[0]
    # Ensure 'height' is numeric, coerce errors to NaN
    gdf['height'] = pd.to_numeric(gdf['height'], errors='coerce')
    filtered_gdf = gdf[gdf['height'] > 3].copy()
    summary = f"Filtered buildings with height > 3. Number of buildings: {len(filtered_gdf)}."
    artifact_name = 'whitchurch_buildings_height_gt3.geojson'
    artifact_description = 'GeoDataFrame of buildings in Whitchurch with height greater than 3 meters.'
    return [summary, artifact_name, artifact_description, filtered_gdf]

