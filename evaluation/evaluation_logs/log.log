matplotlib.use('Agg')
def plot_fish_and_chips_in_exeter(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import mapping
    
    # Unpack data
    fish_and_chips_gdf = data[0]
    exeter_polygon_gdf = data[1]
    
    # Ensure CRS is the same and convert to EPSG:4326 for folium
    if fish_and_chips_gdf.crs != 'EPSG:4326':
        fish_and_chips_gdf = fish_and_chips_gdf.to_crs('EPSG:4326')
    if exeter_polygon_gdf.crs != 'EPSG:4326':
        exeter_polygon_gdf = exeter_polygon_gdf.to_crs('EPSG:4326')
    
    # Get the Exeter polygon
    exeter_polygon = exeter_polygon_gdf.iloc[0].geometry
    
    # Filter fish and chips places within the Exeter polygon
    fish_and_chips_within = fish_and_chips_gdf[fish_and_chips_gdf.within(exeter_polygon)]
    
    # Create a folium map centered on Exeter
    centroid = exeter_polygon.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13)
    
    # Add Exeter boundary
    folium.GeoJson(
        mapping(exeter_polygon),
        name='Exeter Boundary',
        style_function=lambda x: {'fillColor': '#00000000', 'color': 'blue', 'weight': 2}
    ).add_to(m)
    
    # Add fish and chips locations
    for idx, row in fish_and_chips_within.iterrows():
        folium.Marker(
            location=[row.geometry.y, row.geometry.x],
            popup=row.get('organisationname', row.get('fulladdress', 'Fish & Chips Place')),
            icon=folium.Icon(color='red', icon='cutlery', prefix='fa')
        ).add_to(m)
    
    # Save map
    map_filename = 'fish_and_chips_in_exeter.html'
    m.save(map_filename)
    
    # Prepare summary
    summary_rows = fish_and_chips_within[['organisationname', 'fulladdress', 'postcode']].head(5).to_dict('records')
    summary = f"Plotted {len(fish_and_chips_within)} fish and chips places within Exeter boundary. First 5: {summary_rows}"
    artifact_name = 'fish_and_chips_in_exeter_map'
    artifact_description = 'Folium map showing locations of fish and chips places within the Exeter city boundary.'
    return [summary, artifact_name, artifact_description, map_filename]

