matplotlib.use('Agg')
def filter_buildings_height_gt_10m(data: list):
    import geopandas as gpd
    # The height column is 'height' and is of object type, so we need to convert it to float
    gdf = data[0].copy()
    # Convert height to numeric, errors='coerce' will turn non-numeric to NaN
    gdf['height'] = gdf['height'].astype(str).str.extract(r'([\d.]+)').astype(float)
    filtered_gdf = gdf[gdf['height'] > 10]
    artifact_name = 'buildings_exeter_height_gt_10m.geojson'
    # Save to geojson
    filtered_gdf.to_file(artifact_name, driver='GeoJSON')
    summary = f"Filtered buildings with height > 10m. Number of buildings: {len(filtered_gdf)}."
    description = "GeoDataFrame of buildings in Exeter with height greater than 10 meters, including all original columns and geometry."
    return [summary, artifact_name, description, filtered_gdf]

