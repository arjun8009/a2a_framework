matplotlib.use('Agg')
def plot_commercial_buildings_in_exeter(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import Polygon, MultiPolygon
    from folium import GeoJson
    
    # Unpack data
    buildings = data[0]
    exeter_polygons = data[1]
    
    # Ensure CRS is EPSG:4326 for folium compatibility
    if buildings.crs != 'EPSG:4326':
        buildings = buildings.to_crs('EPSG:4326')
    if exeter_polygons.crs != 'EPSG:4326':
        exeter_polygons = exeter_polygons.to_crs('EPSG:4326')
    
    # Find the Exeter city polygon (description == 'City' and name1_text == 'Exeter')
    exeter_city = exeter_polygons[(exeter_polygons['description'] == 'City') & (exeter_polygons['name1_text'] == 'Exeter')]
    if exeter_city.empty:
        # Fallback: use the largest polygon with name1_text == 'Exeter'
        exeter_city = exeter_polygons[exeter_polygons['name1_text'] == 'Exeter']
        if exeter_city.empty:
            # Fallback: use the largest polygon
            exeter_city = exeter_polygons.loc[[exeter_polygons['geometry_area'].idxmax()]]
    
    # Spatial join: filter buildings within Exeter polygon
    exeter_geom = exeter_city.iloc[0].geometry
    buildings_in_exeter = buildings[buildings.within(exeter_geom)]
    
    # Prepare summary statistics
    total = len(buildings_in_exeter)
    area_stats = buildings_in_exeter['geometry_area_m2'].describe()
    use_counts = buildings_in_exeter['buildinguse'].value_counts().to_dict()
    
    # Prepare folium map
    centroid = exeter_geom.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13, tiles='cartodbpositron')
    
    # Plot Exeter boundary
    folium.GeoJson(exeter_geom, name='Exeter Boundary', style_function=lambda x: {'color': 'blue', 'weight': 2, 'fillOpacity': 0.05}).add_to(m)
    
    # Plot commercial buildings
    folium.GeoJson(buildings_in_exeter[['geometry']],
                   name='Commercial Buildings',
                   style_function=lambda x: {'color': 'red', 'weight': 1, 'fillOpacity': 0.4}).add_to(m)
    
    m.save('commercial_buildings_in_exeter_map.html')
    
    # Prepare summary output
    summary = f"Total commercial buildings in Exeter: {total}.\n" \
              f"Area stats (m2): min={area_stats['min']:.1f}, max={area_stats['max']:.1f}, mean={area_stats['mean']:.1f}.\n" \
              f"Building use breakdown: {use_counts}.\n" \
              f"First 5 buildings: {buildings_in_exeter[['osid','buildinguse','geometry_area_m2']].head().to_dict('records')}"
    
    return [summary, 'commercial_buildings_in_exeter_map',
            'A folium map showing all commercial buildings within the Exeter city boundary, with summary statistics.',
            'commercial_buildings_in_exeter_map.html']

