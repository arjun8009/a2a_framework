on']}
2026-04-01 10:46:16,957 INFO Executing code import matplotlib
matplotlib.use('Agg')
def plot_topsham_ward_and_buildings(data: list):
    import folium
    import geopandas as gpd
    from shapely.geometry import mapping
    
    # Unpack data
    ward_gdf = data[0]
    buildings_gdf = data[1]
    
    # Ensure both are in EPSG:4326 for folium
    if ward_gdf.crs != 'EPSG:4326':
        ward_gdf = ward_gdf.to_crs('EPSG:4326')
    if buildings_gdf.crs != 'EPSG:4326':
        buildings_gdf = buildings_gdf.to_crs('EPSG:4326')
    
    # Get centroid of ward for map centering
    centroid = ward_gdf.geometry.centroid.iloc[0]
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=14)
    
    # Add ward boundary
    folium.GeoJson(
        ward_gdf,
        name='Topsham Ward Boundary',
        style_function=lambda x: {'color': 'blue', 'weight': 3, 'fillOpacity': 0.05}
    ).add_to(m)
    
    # Add all buildings
    folium.GeoJson(
        buildings_gdf,
        name='Buildings',
        style_function=lambda x: {'color': 'red', 'weight': 1, 'fillOpacity': 0.3}
    ).add_to(m)
    
    folium.LayerControl().add_to(m)
    
    # Save map
    map_filename = 'topsham_ward_buildings_map.html'
    m.save(map_filename)
    
    # Prepare summary
    summary = (
        f"Map of Topsham Ward boundary (1 polygon) overlaid with all buildings (total: {len(buildings_gdf)} polygons). "
        f"First 5 building IDs: {list(buildings_gdf['id'].head(5))}"
    )
    artifact_name = 'topsham_ward_buildings_map'
    artifact_description = (
        "A folium map showing the Topsham Ward boundary polygon in blue and all building polygons in red overlayed. "
        "The map is centered on the ward and includes layer controls."
    )
    return [summary, artifact_name, artifact_description, map_filename]

