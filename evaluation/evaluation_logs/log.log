2026-04-01 11:29:28,626 INFO Executing code import matplotlib
matplotlib.use('Agg')
def plot_building_footprints(data: list):
    import folium
    import geopandas as gpd
    # Get the GeoDataFrame
    gdf = data[0]
    # Ensure CRS is EPSG:4326 for folium
    if gdf.crs is not None and gdf.crs.to_string() != 'EPSG:4326':
        gdf = gdf.to_crs(epsg=4326)
    # Get centroid for map initialization
    centroid = gdf.geometry.centroid.unary_union.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=17)
    # Add building footprints
    folium.GeoJson(gdf[['geometry', 'name', 'height']],
                  name='Building Footprints',
                  tooltip=folium.GeoJsonTooltip(fields=['name', 'height'], aliases=['Name', 'Height']))\
        .add_to(m)
    # Save map
    map_filename = 'exeter_buildings_height_gt_5_map.html'
    m.save(map_filename)
    # Prepare summary
    summary = f"Plotted {len(gdf)} building footprints with height > 5m. First 5 entries: "
    preview = gdf[['id', 'name', 'height', 'building']].head(5).to_dict('records')
    summary += str(preview)
    return [summary, 'exeter_buildings_height_gt_5_map', 'Folium map showing building footprints in Exeter with height > 5m.', map_filename]

