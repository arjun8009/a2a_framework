2026-03-23 11:03:24,639 INFO Executing code import matplotlib
matplotlib.use('Agg')
def plot_houses_1floor_exeter(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import mapping
    
    # Unpack data
    houses_gdf = data[0].copy()
    exeter_gdf = data[1].copy()
    
    # Ensure CRS is EPSG:4326 for folium
    if houses_gdf.crs is not None and houses_gdf.crs.to_epsg() != 4326:
        houses_gdf = houses_gdf.to_crs(epsg=4326)
    if exeter_gdf.crs is not None and exeter_gdf.crs.to_epsg() != 4326:
        exeter_gdf = exeter_gdf.to_crs(epsg=4326)
    
    # Get centroid of Exeter for map centering
    exeter_centroid = exeter_gdf.geometry.centroid.iloc[0]
    m = folium.Map(location=[exeter_centroid.y, exeter_centroid.x], zoom_start=13)
    
    # Plot Exeter boundary
    folium.GeoJson(
        exeter_gdf.geometry.iloc[0],
        name='Exeter Boundary',
        style_function=lambda x: {'color': 'blue', 'weight': 2, 'fillOpacity': 0.05}
    ).add_to(m)
    
    # Plot houses (1 floor)
    folium.GeoJson(
        houses_gdf,
        name='Houses (1 floor)',
        style_function=lambda x: {'color': 'green', 'weight': 1, 'fillOpacity': 0.4},
        tooltip=folium.GeoJsonTooltip(fields=['osid', 'description', 'geometry_area_m2', 'buildingage_period', 'constructionmaterial'])
    ).add_to(m)
    
    folium.LayerControl().add_to(m)
    
    # Save map
    map_filename = 'houses_1floor_exeter_map.html'
    m.save(map_filename)
    
    # Prepare summary
    summary_rows = houses_gdf[['osid', 'description', 'geometry_area_m2', 'buildingage_period', 'constructionmaterial']].head(5)
    summary = f"Plotted {len(houses_gdf)} houses with exactly 1 floor in Exeter. First 5 entries:\n{summary_rows.to_string(index=False)}"
    
    return [summary, 'houses_1floor_exeter_map', 'Folium map showing all houses with exactly 1 floor in Exeter and the Exeter city boundary for context.', map_filename]

