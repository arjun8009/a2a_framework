matplotlib.use('Agg')
def filter_exeter_polygon_data(data: list):
    # The relevant columns for identifying Exeter are likely 'name1_text', 'description', and 'descriptiongroup'.
    gdf = data[0]
    # Filter for polygons where the name or description is 'Exeter' and the type is relevant (e.g., City, Settlement, Town, Part Of Settlement)
    exeter_mask = (
        (gdf['name1_text'].str.lower() == 'exeter') |
        (gdf['description'].str.lower().str.contains('city|town|settlement|part of settlement'))
    )
    filtered = gdf[exeter_mask]
    summary = f"Filtered polygon data for Exeter. Number of matching polygons: {len(filtered)}."
    artifact_name = 'filtered_exeter_polygon_data'
    artifact_description = (
        "A GeoDataFrame containing only the polygon(s) that represent Exeter, "
        "filtered using the 'name1_text' column for 'Exeter' and the 'description' column for relevant settlement types."
    )
    return [summary, artifact_name, artifact_description, filtered]

