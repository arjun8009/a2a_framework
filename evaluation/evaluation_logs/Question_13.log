matplotlib.use('Agg')
def filter_houses_pre1960(data: list):
    import pandas as pd
    import geopandas as gpd
    df = data[0]
    # Ensure columns exist, and convert to numeric where possible
    for col in ['start_date', 'building:year', 'construction_year']:
        if col in df.columns:
            df[col] = pd.to_numeric(df[col], errors='coerce')
        else:
            df[col] = None
    # Filter for houses where any of the year columns is < 1960
    filtered = df[(df['start_date'] < 1960) |
                  (df['building:year'] < 1960) |
                  (df['construction_year'] < 1960)]
    summary = f"Filtered houses built before 1960. Number of entries: {len(filtered)}."
    artifact_name = 'houses_blackawton_pre1960.geojson'
    artifact_description = 'GeoDataFrame of houses in Blackawton where start_date, building:year, or construction_year is before 1960.'
    return [summary, artifact_name, artifact_description, filtered]

