    artifact_name = 'filtered_blackawton_named_area'
    artifact_description = "GeoDataFrame containing only the named area(s) specifically for Blackawton, filtered from the original dataset."
    artifact_data = filtered
    
    return [summary, artifact_name, artifact_description, artifact_data]

