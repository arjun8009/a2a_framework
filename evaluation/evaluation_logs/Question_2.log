def filter_electricity_structures(data: list):
    import pandas as pd
    import geopandas as gpd
    # Assume the first item is the relevant GeoDataFrame
    gdf = data[0]
    # Filter for electricity-related structures: substations, transformers, power stations
    keywords = ['substation', 'transformer', 'power station']
    # Use description and address_primarydescription columns for robust filtering
    mask = (
        gdf['description'].str.lower().str.contains('|'.join(keywords), na=False) |
        gdf.get('address_primarydescription', pd.Series(['']*len(gdf))).str.lower().str.contains('|'.join(keywords), na=False)
    )
    filtered_gdf = gdf[mask]
    summary = f"Filtered {len(filtered_gdf)} electricity-related structures (substations, transformers, power stations) from {len(gdf)} total entries."
    artifact_name = 'filtered_electricity_structures_exeter'
    artifact_description = 'GeoDataFrame of electricity-related structures (substations, transformers, power stations) filtered from the original dataset.'
    return [summary, artifact_name, artifact_description, filtered_gdf]

