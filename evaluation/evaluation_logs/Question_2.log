matplotlib.use('Agg')
def filter_whitchurch_polygon(data:list):
    import pandas as pd
    import geopandas as gpd
    # The input is a list with a single GeoDataFrame
    gdf = data[0]
    # Filter for rows where 'name' contains 'Whitchurch' but NOT 'Whitchurch Canonicorum'
    mask = gdf['name'].notnull() & gdf['name'].str.contains('Whitchurch', case=False, na=False) & ~gdf['name'].str.contains('Whitchurch Canonicorum', case=False, na=False)
    filtered_gdf = gdf[mask].copy()
