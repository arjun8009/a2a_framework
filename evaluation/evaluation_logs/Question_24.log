matplotlib.use('Agg')
def filter_buildings_with_greenroof(data: list):
    import pandas as pd
    import geopandas as gpd
    import json
    
    df = data[0]
    # Ensure mask uses the same index as df
    mask = pd.Series(False, index=df.index)
    
    # Check in 'tags' column for green roof indicators
    if 'tags' in df.columns:
        tags_col = df['tags'].fillna('')
        for idx, tag in tags_col.items():
            try:
                tag_dict = json.loads(tag) if tag else {}
            except Exception:
                tag_dict = {}
            # Check for green roof indicators in tags
            if any([
                tag_dict.get('greenroof', '').lower() == 'yes',
                tag_dict.get('green_roof', '').lower() == 'yes',
                tag_dict.get('roof:material', '').lower() in ['green_roof', 'vegetated'],
                tag_dict.get('roof:greenroof', '').lower() == 'yes',
                tag_dict.get('roof:green_roof', '').lower() == 'yes',
                tag_dict.get('roof:vegetated', '').lower() == 'yes',
            ]):
                mask.at[idx] = True
    
    # Also check for explicit columns if present
    for col in df.columns:
        if col.lower() in ['greenroof', 'green_roof', 'roof:material', 'roof:greenroof', 'roof:green_roof', 'roof:vegetated']:
            mask = mask | (df[col].astype(str).str.lower().isin(['yes', 'green_roof', 'vegetated']))
    
    filtered = df[mask]
    summary = f"Found {len(filtered)} buildings with green/vegetated roof indicators in Axminster." if len(filtered) > 0 else "No buildings with green/vegetated roof indicators found in Axminster."
    if len(filtered) > 0:
        return [summary, 'buildings_with_greenroof_axminster', 'Filtered buildings in Axminster with green/vegetated roof indicators based on tags and roof-related columns.', filtered]
    else:
        return [summary, None, None, None]

