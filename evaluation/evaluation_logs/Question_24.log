matplotlib.use('Agg')
def filter_axminster_named_area(data:list):
    import pandas as pd
    import geopandas as gpd
    # Assume the input is a GeoDataFrame
    gdf = data[0]
    # Filter for rows where the 'name' column contains 'Axminster' (case-insensitive)
    filtered = gdf[gdf['name'].str.contains('Axminster', case=False, na=False)]
    summary = f"Filtered named areas containing 'Axminster'. Number of entries: {len(filtered)}."
    artifact_name = 'filtered_axminster_named_area'
