matplotlib.use('Agg')
def filter_buildings_roof_green_in_axminster(data: list):
    import pandas as pd
    import geopandas as gpd
    import json
    
    gdf = data[0]
    # Filter where 'roof:colour' column is 'green'
    mask_roof_colour = gdf.get('roof:colour', pd.Series([None]*len(gdf))) == 'green'
    
    # Filter where 'tags' column contains '"roof:colour":"green"'
    def tag_has_green_roof(tag):
        if pd.isnull(tag):
            return False
        try:
            tag_dict = json.loads(tag)
            return tag_dict.get('roof:colour', None) == 'green'
        except Exception:
            return False
    mask_tags = gdf['tags'].apply(tag_has_green_roof)
    
    filtered = gdf[mask_roof_colour | mask_tags]
    
    summary = f"Filtered buildings with green roofs: {len(filtered)} entries found."
    artifact_name = 'buildings_roof_green_in_axminster'
    artifact_description = "GeoDataFrame of buildings in Axminster where the roof colour is green, based on either the 'roof:colour' column or the 'tags' column."
    return [summary, artifact_name, artifact_description, filtered]

