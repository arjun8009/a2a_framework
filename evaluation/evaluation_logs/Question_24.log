matplotlib.use('Agg')
def filter_axminster_civil_parish(data: list):
    import pandas as pd
    import geopandas as gpd
    # Assume the input is a GeoDataFrame
    gdf = data[0]
    # Filter for rows where name is 'Axminster' and boundary is 'administrative' or 'political' or 'civil parish' or admin_level is 10 or 8 (common for civil parishes)
    filtered = gdf[(gdf['name'] == 'Axminster') & (
        (gdf['boundary'].str.lower().isin(['administrative', 'political', 'civil parish'])) |
        (gdf['admin_level'].astype(str).isin(['10', '8']))
    )]
    summary = f"Filtered for 'Axminster' with civil parish designation. Number of entries: {len(filtered)}."
    artifact_name = 'filtered_axminster_civil_parish'
    artifact_description = "GeoDataFrame containing only the 'Axminster' named area with civil parish or equivalent administrative designation. Includes all columns and geometry."
    return [summary, artifact_name, artifact_description, filtered]

