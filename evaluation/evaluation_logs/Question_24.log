matplotlib.use('Agg')
def filter_axminster_cp_named_area(data:list):
    import geopandas as gpd
    # The relevant columns for filtering are 'name' and possibly 'admin_level' or 'boundary'
    gdf = data[0]
    # Filter for rows where 'name' contains 'Axminster CP' (case-insensitive, exact match preferred)
    filtered = gdf[gdf['name'].str.contains('Axminster CP', case=False, na=False)]
    summary = f"Filtered {len(filtered)} entries for named area 'Axminster CP'."
    artifact_name = 'filtered_axminster_cp_named_area'
    artifact_description = "GeoDataFrame containing only the entries relevant to 'Axminster CP' from the original dataset."
    return [summary, artifact_name, artifact_description, filtered]

