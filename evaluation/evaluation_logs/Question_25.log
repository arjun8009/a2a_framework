matplotlib.use('Agg')
def filter_bradninch_boundary(data: list):
    import geopandas as gpd
    # The relevant columns for filtering are 'name' and 'boundary'.
    gdf = data[0]
    # Filter for rows where the name is exactly 'Bradninch' and boundary is a polygon type (likely 'administrative', 'political', 'place', etc.)
    # Since 'boundary' can have several types, we include those that could represent an area boundary.
    polygon_types = ['administrative', 'political', 'place', 'land_parcel', 'statistical', 'historic:administrative', 'ceremonial', 'traditional']
    filtered = gdf[(gdf['name'] == 'Bradninch') & (gdf['boundary'].isin(polygon_types))]
    summary = f"Filtered Bradninch boundary: {len(filtered)} entries found."
    artifact_name = 'filtered_bradninch_boundary'
    artifact_description = 'GeoDataFrame containing the exact boundary polygon(s) for the named area Bradninch.'
    return [summary, artifact_name, artifact_description, filtered]

