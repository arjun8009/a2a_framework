matplotlib.use('Agg')
def filter_bradninch_primary_schools(data: list):
    import pandas as pd
    import geopandas as gpd
    
    gdf = data[0]
    # Ensure all string columns are filled with empty string for search
    for col in ['building', 'amenity', 'name']:
        if col in gdf.columns:
            gdf[col] = gdf[col].fillna('')
    # school:level may be in tags json
    if 'school:level' not in gdf.columns:
        gdf['school:level'] = ''
        if 'tags' in gdf.columns:
            import json
            def extract_school_level(tags):
                try:
                    tags_dict = json.loads(tags) if isinstance(tags, str) else {}
                    return tags_dict.get('school:level', '')
                except Exception:
                    return ''
            gdf['school:level'] = gdf['tags'].apply(extract_school_level)
    else:
        gdf['school:level'] = gdf['school:level'].fillna('')
    # Filter logic
    mask = (
        ((gdf['building'].str.lower() == 'school') | (gdf['amenity'].str.lower() == 'school')) &
        ((gdf['school:level'].str.lower() == 'primary') | (gdf['name'].str.contains('Primary School', case=False, na=False)))
    )
    filtered = gdf[mask].copy()
    summary = f"Filtered {len(filtered)} primary school buildings from {len(gdf)} total buildings."
    artifact_name = 'bradninch_primary_schools.geojson'
    artifact_description = 'GeoDataFrame of buildings in Bradninch tagged as primary schools, filtered by (building=school OR amenity=school) AND (school:level=primary OR name contains \'Primary School\').'
    return [summary, artifact_name, artifact_description, filtered]

