matplotlib.use('Agg')
def plot_tidal_features_in_brendon_hills_ward(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import mapping
    
    # Unpack data
    ward_gdf = data[0].copy()
    tidal_gdf = data[1].copy()
    
    # Ensure CRS is EPSG:4326 for folium
    if ward_gdf.crs is None or ward_gdf.crs.to_epsg() != 4326:
        ward_gdf = ward_gdf.to_crs(epsg=4326)
    if tidal_gdf.crs is None or tidal_gdf.crs.to_epsg() != 4326:
        tidal_gdf = tidal_gdf.to_crs(epsg=4326)
    
    # Spatial filter: tidal features within ward boundary
    ward_polygon = ward_gdf.iloc[0].geometry
    tidal_within = tidal_gdf[tidal_gdf.geometry.intersects(ward_polygon)]
    
    # Create folium map centered on ward
    centroid = ward_polygon.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13)
    
    # Add ward boundary
    folium.GeoJson(
        mapping(ward_polygon),
        name='Brendon Hills Ward Boundary',
        style_function=lambda x: {'color': 'blue', 'weight': 3, 'fillOpacity': 0.1}
    ).add_to(m)
    
    # Add tidal features
    if not tidal_within.empty:
        folium.GeoJson(
            tidal_within,
            name='Tidal Water Features',
            style_function=lambda x: {'color': 'aqua', 'weight': 4}
        ).add_to(m)
    
    folium.LayerControl().add_to(m)
    
    # Save map
    map_filename = 'brendon_hills_ward_tidal_features_map.html'
    m.save(map_filename)
    
    # Prepare summary
    summary = f"Plotted Brendon Hills Ward boundary and {len(tidal_within)} tidal-related water features within the ward. First 5 features:\n"
    if not tidal_within.empty:
        summary += str(tidal_within[['id', 'waterway', 'osm_type']].head(5))
    else:
        summary += 'No tidal-related water features found within the ward.'
    
    artifact_name = 'brendon_hills_ward_tidal_features_map'
    artifact_description = 'A folium map showing the Brendon Hills Ward boundary and all tidal-related water features within the ward.'
    
    return [summary, artifact_name, artifact_description, map_filename]

