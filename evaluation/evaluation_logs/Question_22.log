matplotlib.use('Agg')
def filter_little_torrington(data: list):
    import pandas as pd
    import geopandas as gpd
    # Assume the input is a GeoDataFrame
    gdf = data[0]
    # Filter using multiple columns for high quality: name, tags, operator, boundary
    mask = (
