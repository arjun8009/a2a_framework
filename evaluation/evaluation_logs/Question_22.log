matplotlib.use('Agg')
def filter_basement_flats_little_torrington(data: list):
    import pandas as pd
    import geopandas as gpd
    
    gdf = data[0]
    # Ensure columns exist, fill missing ones with None
    for col in ['addr:unit', 'level', 'building:levels:underground']:
        if col not in gdf.columns:
            gdf[col] = None
    
    # Criteria 1: 'addr:unit' contains 'Basement' (case-insensitive)
    mask_unit = gdf['addr:unit'].astype(str).str.contains('Basement', case=False, na=False)
    # Criteria 2: 'level' == -1 (handle as string or numeric)
    mask_level = (gdf['level'].astype(str) == '-1') | (gdf['level'] == -1)
    # Criteria 3: 'building:levels:underground' >= 1 (handle as string or numeric)
    mask_underground = pd.to_numeric(gdf['building:levels:underground'], errors='coerce').fillna(0) >= 1
    
    mask = mask_unit | mask_level | mask_underground
    filtered = gdf[mask].copy()
    
    summary = f"Filtered {len(filtered)} basement flat buildings out of {len(gdf)} total buildings."
    artifact_name = 'basement_flats_little_torrington.geojson'
    artifact_description = (
        "GeoDataFrame of buildings in Little Torrington identified as basement flats. "
        "Criteria: (1) 'addr:unit' contains 'Basement', (2) 'level' == -1, or (3) 'building:levels:underground' >= 1."
    )
    return [summary, artifact_name, artifact_description, filtered]

