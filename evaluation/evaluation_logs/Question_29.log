matplotlib.use('Agg')
def plot_buildings_near_rivers(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import Polygon, MultiPolygon
    
    # Unpack data
    buildings = data[0].copy()
    rivers = data[1].copy()
    
    # Ensure CRS is the same and projected for buffering
    if buildings.crs is None:
        buildings.set_crs(epsg=4326, inplace=True)
    if rivers.crs is None:
        rivers.set_crs(epsg=4326, inplace=True)
    
    # Project to a metric CRS for buffering (British National Grid: EPSG:27700)
    buildings = buildings.to_crs(epsg=27700)
    rivers = rivers.to_crs(epsg=27700)
    
    # Create a single buffer around all rivers (150 meters)
    river_buffer = rivers.buffer(150)
    river_buffer_gdf = gpd.GeoDataFrame(geometry=gpd.GeoSeries(river_buffer), crs=27700)
    river_buffer_union = river_buffer_gdf.unary_union
    
    # Select buildings within 150m of any river
    buildings_near_river = buildings[buildings.geometry.intersects(river_buffer_union)]
    count_near = len(buildings_near_river)
    
    # Convert everything back to EPSG:4326 for folium
    buildings = buildings.to_crs(epsg=4326)
    rivers = rivers.to_crs(epsg=4326)
    buildings_near_river = buildings_near_river.to_crs(epsg=4326)
    
    # Create folium map centered on the mean of all buildings
    centroid = buildings.geometry.unary_union.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=11, tiles='cartodbpositron')
    
    # Plot all buildings (light gray)
    folium.GeoJson(
        buildings,
        name='All Buildings',
        style_function=lambda x: {'color': 'gray', 'weight': 0.5, 'fillOpacity': 0.1}
    ).add_to(m)
    
    # Plot rivers (blue)
    folium.GeoJson(
        rivers,
        name='Rivers',
        style_function=lambda x: {'color': 'blue', 'weight': 2}
    ).add_to(m)
    
    # Plot buildings within 150m of rivers (red)
    folium.GeoJson(
        buildings_near_river,
        name='Buildings within 150m of River',
        style_function=lambda x: {'color': 'red', 'weight': 1, 'fillOpacity': 0.7}
    ).add_to(m)
    
    folium.LayerControl().add_to(m)
    
    # Save map
    map_filename = 'buildings_near_rivers_map.html'
    m.save(map_filename)
    
    # Prepare summary
    summary = f"There are {count_near} buildings within 150 meters of any river. First 5 qualifying buildings: "
    if count_near > 0:
        summary += str(buildings_near_river[['id', 'name', 'building', 'addr:city', 'addr:street']].head(5).to_dict(orient='records'))
    else:
        summary += "None found."
    
    return [summary, 'buildings_near_rivers_map', 'Folium map showing all buildings, rivers, and buildings within 150m of any river in West Devon. Buildings within 150m are highlighted in red.', map_filename]

