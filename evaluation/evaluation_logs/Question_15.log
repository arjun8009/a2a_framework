matplotlib.use('Agg')
def filter_alphington_named_areas(data:list):
    import pandas as pd
    gdf = data[0]
    # Filter rows where the 'name' column contains 'Alphington' (case-insensitive)
    filtered = gdf[gdf['name'].str.contains('Alphington', case=False, na=False)]
    summary = f"Filtered for areas with 'Alphington' in the name. Number of matching entries: {len(filtered)}. Columns: {list(filtered.columns)}."
    artifact_name = 'filtered_alphington_areas'
    artifact_description = "GeoDataFrame containing all named areas where the name contains the string 'Alphington'. Includes all columns from the original data."
    return [summary, artifact_name, artifact_description, filtered]

