matplotlib.use('Agg')
def get_top10_largest_buildings(data: list):
    import geopandas as gpd
    # Assume the first (and only) item in the list is the GeoDataFrame
    gdf = data[0]
    # Calculate the footprint area for each building (in the CRS units, likely meters)
    gdf['footprint_area'] = gdf['geometry'].area
    # Sort by area in descending order and select the top 10
    top10 = gdf.sort_values('footprint_area', ascending=False).head(10)
    # Save to GeoJSON
    output_name = 'alphington_top10_largest_buildings.geojson'
    top10.to_file(output_name, driver='GeoJSON')
    summary = f"Top 10 buildings with the largest footprint areas selected. Areas range from {top10['footprint_area'].min():.2f} to {top10['footprint_area'].max():.2f} (CRS units)."
    description = "GeoDataFrame containing the 10 buildings in Alphington with the largest footprint areas, including all original attributes and a new 'footprint_area' column. Sorted in descending order by area."
    return [summary, output_name, description, top10]
