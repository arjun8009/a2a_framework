2026-04-02 08:36:04,360 INFO Executing code import matplotlib
matplotlib.use('Agg')
def plot_alphington_ward_and_top10_buildings(data: list):
    import geopandas as gpd
    import folium
    import matplotlib
    import matplotlib.cm as cm
    import matplotlib.colors as colors
    
    # Unpack data
    ward_gdf = data[0].copy()
    buildings_gdf = data[1].copy()
    
    # Ensure CRS is EPSG:4326 for folium
    if ward_gdf.crs is not None and ward_gdf.crs.to_epsg() != 4326:
        ward_gdf = ward_gdf.to_crs(epsg=4326)
    if buildings_gdf.crs is not None and buildings_gdf.crs.to_epsg() != 4326:
        buildings_gdf = buildings_gdf.to_crs(epsg=4326)
    
    # Prepare color scale for footprint_area
    norm = colors.Normalize(vmin=buildings_gdf['footprint_area'].min(), vmax=buildings_gdf['footprint_area'].max())
    cmap = cm.get_cmap('YlOrRd')
    
    # Create folium map centered on ward
    centroid = ward_gdf.geometry.centroid.iloc[0]
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=14)
    
    # Plot ward boundary
    folium.GeoJson(
        ward_gdf,
        name='Alphington Ward',
        style_function=lambda x: {'color': 'blue', 'weight': 3, 'fillOpacity': 0.05}
    ).add_to(m)
    
    # Plot buildings with color scale by footprint_area
    for idx, row in buildings_gdf.iterrows():
        color = matplotlib.colors.rgb2hex(cmap(norm(row['footprint_area'])))
        popup_text = f"Name: {row.get('name', 'N/A')}<br>Area: {row['footprint_area']:.1f} m²"
        folium.GeoJson(
            row['geometry'],
            style_function=lambda x, color=color: {'color': color, 'weight': 2, 'fillOpacity': 0.7},
            highlight_function=lambda x: {'weight': 4, 'color': 'black'},
            tooltip=popup_text
        ).add_to(m)
    
    # Add colorbar legend
    from branca.colormap import linear
    colormap = linear.YlOrRd_09.scale(buildings_gdf['footprint_area'].min(), buildings_gdf['footprint_area'].max())
    colormap.caption = 'Building Footprint Area (m²)'
    colormap.add_to(m)
    
    # Save map
    map_filename = 'alphington_ward_top10_buildings_map.html'
    m.save(map_filename)
    
    # Prepare summary
    summary_rows = buildings_gdf[['name', 'footprint_area']].head(5)
    summary = (
        f"Alphington Ward boundary and top 10 largest buildings plotted. "
        f"Buildings are colored by footprint area. "
        f"First 5 buildings:\n{summary_rows.to_string(index=False)}\n"
        f"Total buildings plotted: {len(buildings_gdf)}."
    )
    
    return [
        summary,
        'alphington_ward_top10_buildings_map',
        'Folium map showing the Alphington Ward boundary and the 10 largest buildings by footprint area, colored by area.',
        map_filename
    ]
