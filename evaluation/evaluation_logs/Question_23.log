2026-04-02 09:26:00,054 INFO Executing code import matplotlib
matplotlib.use('Agg')
def plot_hard_to_heat_buildings(data: list):
    import folium
    import geopandas as gpd
    from folium import features
    from branca.element import MacroElement
    from jinja2 import Template

    # Unpack data
    gdf_all = data[0].to_crs(epsg=4326)
    gdf_hard = data[1].to_crs(epsg=4326)

    # Center map on the centroid of all buildings
    centroid = gdf_all.unary_union.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=16, tiles='cartodbpositron')

    # Plot all buildings (light gray outline, no fill)
    folium.GeoJson(
        gdf_all,
        name='All Buildings',
        style_function=lambda x: {
            'color': 'lightgray',
            'weight': 1,
            'fillOpacity': 0
        }
    ).add_to(m)

    # Plot highlighted hard-to-heat buildings (solid red fill, semi-transparent)
    folium.GeoJson(
        gdf_hard,
        name='Likely Hard-to-Heat Residential Buildings',
        style_function=lambda x: {
            'color': 'red',
            'weight': 2,
            'fillColor': 'red',
            'fillOpacity': 0.5
        },
        highlight_function=lambda x: {'weight': 4, 'color': 'darkred'}
    ).add_to(m)

    # Add legend using MacroElement
    legend_html = '''
    <div style="position: fixed; 
                bottom: 50px; left: 50px; width: 260px; height: 90px; 
                background-color: white; border:2px solid grey; z-index:9999; font-size:14px;">
      <b>Legend</b><br>
      <svg width="30" height="15"><rect width="30" height="15" style="fill:red;fill-opacity:0.5;stroke:red;stroke-width:2"/></svg> Likely Hard-to-Heat Residential Buildings<br>
      <svg width="30" height="15"><rect width="30" height="15" style="fill:none;stroke:lightgray;stroke-width:2"/></svg> All Buildings
    </div>
    '''
    m.get_root().html.add_child(folium.Element(legend_html))

    # Add title using MacroElement
    title_html = '''
         <h3 align="center" style="font-size:20px"><b>Likely Hard-to-Heat Residential Buildings in Spreyton</b></h3>
         '''
    m.get_root().html.add_child(folium.Element(title_html))

    # Save map
    map_filename = 'hard_to_heat_buildings_spreyton.html'
    m.save(map_filename)

    # Prepare summary
    n_highlighted = len(gdf_hard)
    first5 = gdf_hard[['id', 'building', 'geometry']].head(5)
    summary = f"There are {n_highlighted} likely hard-to-heat residential buildings highlighted in red. First 5 IDs: {first5['id'].tolist()}"
    artifact_name = 'hard_to_heat_buildings_map'
    artifact_desc = 'Folium map showing all buildings in Spreyton (light gray outline) and likely hard-to-heat residential buildings (solid red fill, semi-transparent). Includes legend and title.'
    return [summary, artifact_name, artifact_desc, map_filename]

