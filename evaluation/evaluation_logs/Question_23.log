matplotlib.use('Agg')
def filter_spreyton_results(data: list):
    import pandas as pd
    import geopandas as gpd
    import re
    
    df = data[0]
    # Ensure we handle both DataFrame and GeoDataFrame
    if not isinstance(df, (pd.DataFrame, gpd.GeoDataFrame)):
        return ["Input is not a DataFrame or GeoDataFrame", None, None, None]

    # Lowercase all string columns for robust matching
    df = df.copy()
    if 'name' in df.columns:
        df['name_lower'] = df['name'].astype(str).str.lower()
    else:
        df['name_lower'] = ''
    if 'tags' in df.columns:
        df['tags_lower'] = df['tags'].astype(str).str.lower()
    else:
        df['tags_lower'] = ''
    if 'operator' in df.columns:
        df['operator_lower'] = df['operator'].astype(str).str.lower()
    else:
        df['operator_lower'] = ''

    # Search for 'spreyton' in relevant columns
    mask = (
        df['name_lower'].str.contains('spreyton', na=False) |
        df['tags_lower'].str.contains('spreyton', na=False) |
        df['operator_lower'].str.contains('spreyton', na=False)
    )
    filtered = df[mask].drop(columns=['name_lower', 'tags_lower', 'operator_lower'])

    summary = f"Filtered results for Spreyton: {len(filtered)} entries found."
    artifact_name = 'filtered_spreyton_results'
    artifact_description = "A filtered GeoDataFrame/DataFrame containing only entries relevant to Spreyton, based on 'name', 'tags', or 'operator' columns."
    return [summary, artifact_name, artifact_description, filtered]

