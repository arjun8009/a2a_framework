2026-04-02 10:32:51,117 INFO Executing code import matplotlib
matplotlib.use('Agg')
def plot_natural_land_features_with_boundary(data: list):
    import geopandas as gpd
    import folium
    from folium import GeoJson
    
    # Unpack data
    land_features = data[0]
    boundary = data[1]
    
    # Ensure CRS is EPSG:4326 for folium compatibility
    if land_features.crs != 'EPSG:4326':
        land_features = land_features.to_crs('EPSG:4326')
    if boundary.crs != 'EPSG:4326':
        boundary = boundary.to_crs('EPSG:4326')
    
    # Filter only natural land features (all rows with non-null 'natural')
    natural_features = land_features[land_features['natural'].notnull()].copy()
    
    # Prepare map centered on the boundary centroid
    centroid = boundary.geometry.centroid.iloc[0]
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=14, tiles='cartodbpositron')
    
    # Add boundary polygon
    folium.GeoJson(boundary.geometry.iloc[0], 
                   name='East Worlington Boundary', 
                   style_function=lambda x: {'color': 'blue', 'weight': 3, 'fillOpacity': 0.05}).add_to(m)
    
    # Add natural features (different colors for different types)
    color_dict = {
        'tree': 'green',
        'wood': 'darkgreen',
        'water': 'blue',
        'tree_row': 'orange',
        'peninsula': 'purple'
    }
    for nat_type, group in natural_features.groupby('natural'):
        folium.GeoJson(
            group,
            name=f'Natural: {nat_type}',
            style_function=lambda x, color=color_dict.get(nat_type, 'gray'): {
                'color': color,
                'weight': 2,
                'fillOpacity': 0.3 if nat_type in ['wood', 'water', 'peninsula'] else 0.7
            },
            marker = folium.CircleMarker(radius=3, color=color_dict.get(nat_type, 'gray')) if nat_type == 'tree' else None
        ).add_to(m)
    
    folium.LayerControl().add_to(m)
    
    # Save map
    map_filename = 'natural_land_features_east_worlington.html'
    m.save(map_filename)
    
    # Prepare summary
    summary = f"Plotted {len(natural_features)} natural land features (types: {natural_features['natural'].unique().tolist()}) within the East Worlington boundary. First 5 features:\n" + str(natural_features[['natural', 'osm_type', 'geometry']].head(5))
    artifact_name = 'natural_land_features_map'
    artifact_description = 'A folium map showing the distribution of natural land features (tree, wood, water, etc.) within the East Worlington boundary.'
    return [summary, artifact_name, artifact_description, map_filename]

