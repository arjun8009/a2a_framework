matplotlib.use('Agg')
def filter_templeton_named_areas(data: list):
    import pandas as pd
    import geopandas as gpd
    
    gdf = data[0]
    # Ensure we are working with a GeoDataFrame
    if not isinstance(gdf, (gpd.GeoDataFrame, pd.DataFrame)):
        return ["Input is not a DataFrame or GeoDataFrame", None, None, None]
    
    # Filter for relevant named areas for Templeton
    # Use multiple columns: 'name', 'tags', and 'operator' for higher quality
    mask_name = gdf['name'].str.contains('Templeton', case=False, na=False)
    mask_tags = gdf['tags'].str.contains('Templeton', case=False, na=False)
    mask_operator = gdf['operator'].str.contains('Templeton', case=False, na=False)
    
    filtered = gdf[mask_name | mask_tags | mask_operator]
    
    summary = f"Filtered results for Templeton: {len(filtered)} entries found. Columns: {list(filtered.columns)}."
    artifact_name = 'filtered_templeton_results'
    artifact_description = "GeoDataFrame of named areas relevant to Templeton, filtered using 'name', 'tags', and 'operator' columns."
    
    return [summary, artifact_name, artifact_description, filtered]

