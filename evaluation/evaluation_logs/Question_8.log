matplotlib.use('Agg')
def filter_rewe_devon_named_area(data: list):
    import pandas as pd
    import geopandas as gpd
    
    gdf = data[0]
    # Filter for name exactly 'Rewe', boundary as 'administrative', and in Devon
    filtered = gdf[
        (gdf['name'].str.lower() == 'rewe') &
        (gdf['boundary'].str.lower() == 'administrative') &
        (gdf['tags'].str.contains('devon', case=False, na=False))
    ]
    # If not found, try fallback: name 'Rewe', boundary 'administrative', admin_level likely for parish (8 or 10), and in Devon
    if filtered.empty:
        filtered = gdf[
            (gdf['name'].str.lower() == 'rewe') &
            (gdf['boundary'].str.lower() == 'administrative') &
            (gdf['admin_level'].isin(['8', '10'])) &
            (gdf['tags'].str.contains('devon', case=False, na=False))
        ]
    # If still not found, try just name and boundary
    if filtered.empty:
        filtered = gdf[
            (gdf['name'].str.lower() == 'rewe') &
            (gdf['boundary'].str.lower() == 'administrative')
        ]
    # Return only the first match if multiple
    if not filtered.empty:
        filtered = filtered.iloc[[0]]
        summary = f"Filtered to the named area 'Rewe' that is an administrative parish in Devon. 1 entry returned."
        artifact_name = 'filtered_rewe_devon_named_area'
        artifact_description = "GeoDataFrame containing the single entry for the named area 'Rewe' that is an administrative parish in Devon. Includes all columns and geometry."
        return [summary, artifact_name, artifact_description, filtered]
    else:
        return ["No entry found for 'Rewe' as an administrative parish in Devon.", None, None, None]

