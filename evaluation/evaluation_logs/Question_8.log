matplotlib.use('Agg')
def filter_buildings_with_solar_panels(data: list):
    import geopandas as gpd
    import pandas as pd
    import json
    
    gdf = data[0]
    # Ensure 'tags' is a string and parse it as JSON if possible
    def has_solar_tags(tags):
        if not isinstance(tags, str):
            return False
        try:
            tags_dict = json.loads(tags)
        except Exception:
            return False
        # Check for any of the required solar tags
        if (
            tags_dict.get('roof:solar_panel', '').lower() == 'yes' or
            tags_dict.get('generator:source', '').lower() == 'solar' or
            tags_dict.get('solar_panels', '').lower() == 'yes'
        ):
            return True
        return False
    
    filtered_gdf = gdf[gdf['tags'].apply(has_solar_tags)]
    
    # Save to geojson
    filtered_gdf.to_file('buildings_with_solar_panels_in_filtered_rewe_devon_named_area.geojson', driver='GeoJSON')
    
    summary = f"Filtered {len(filtered_gdf)} buildings with solar panel tags out of {len(gdf)} total buildings."
    artifact_name = 'buildings_with_solar_panels_in_filtered_rewe_devon_named_area.geojson'
    artifact_description = (
        "GeoDataFrame of buildings in the filtered Rewe Devon named area that have any of the following tags: "
        "roof:solar_panel=yes, generator:source=solar, or solar_panels=yes. "
        "Saved as a GeoJSON file."
    )
    return [summary, artifact_name, artifact_description, filtered_gdf]

