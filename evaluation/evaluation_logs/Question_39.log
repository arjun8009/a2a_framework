def filter_north_tawton_data(data: list):
    import pandas as pd
    import geopandas as gpd
    
    df = data[0]
    # Use multiple columns to increase search quality
    # We'll search for 'North Tawton' in the 'name' column (if present), and also check 'tags' for any mention
    mask_name = df['name'].fillna('').str.contains('North Tawton', case=False, na=False)
    mask_tags = df['tags'].fillna('').str.contains('North Tawton', case=False, na=False)
    # Combine masks
    mask = mask_name | mask_tags
    filtered = df[mask]
    
    summary = f"Filtered data for North Tawton. Number of entries: {len(filtered)}. Columns: {list(filtered.columns)}."
    artifact_name = 'north_tawton_filtered'
    artifact_description = 'Filtered data from north_tawton_search containing only entries relevant to North Tawton, using both name and tags columns.'
    
    return [summary, artifact_name, artifact_description, filtered]

