matplotlib.use('Agg')
def filter_devon_named_area(data:list):
    import pandas as pd
    import geopandas as gpd
    
    df = data[0]
    # Ensure we handle both DataFrame and GeoDataFrame
    if not isinstance(df, (pd.DataFrame, gpd.GeoDataFrame)):
        return ["Input is not a DataFrame or GeoDataFrame", None, None, None]

    # Filter using multiple columns for relevance to Devon
    mask = (
        (df['name'].str.contains('Devon', case=False, na=False)) |
        (df['tags'].str.contains('devon', case=False, na=False)) |
        (df['website'].str.contains('devon', case=False, na=False)) |
        (df['operator'].str.contains('devon', case=False, na=False))
    )
    filtered = df[mask]
    summary = f"Filtered data for Devon. Number of entries: {len(filtered)}. Columns: {list(filtered.columns)}."
    artifact_name = 'filtered_devon_named_area'
    artifact_description = 'Filtered data from devon_named_area containing only entries relevant to Devon, using name, tags, website, and operator columns.'
    return [summary, artifact_name, artifact_description, filtered]

