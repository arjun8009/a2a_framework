def filter_west_devon_data(data: list):
    import pandas as pd
    import geopandas as gpd
    
    df = data[0]
    # Ensure we handle both DataFrame and GeoDataFrame
    if not isinstance(df, (pd.DataFrame, gpd.GeoDataFrame)):
        return ["Input is not a DataFrame or GeoDataFrame", None, None, None]
    
    # Filter using multiple columns for high quality: 'name', 'tags', 'website', 'operator'
    mask = (
        df['name'].fillna('').str.contains('West Devon', case=False, na=False) |
        df['tags'].fillna('').str.contains('west devon', case=False, na=False) |
        df['website'].fillna('').str.contains('westdevon.gov.uk', case=False, na=False) |
        df['operator'].fillna('').str.contains('West Devon', case=False, na=False)
    )
    filtered = df[mask]
    summary = f"Filtered data for West Devon. Number of entries: {len(filtered)}. Columns: {list(filtered.columns)}."
    artifact_name = 'filtered_west_devon_data'
    artifact_description = 'Filtered data from west_devon_data containing only entries relevant to West Devon, using name, tags, website, and operator columns.'
    return [summary, artifact_name, artifact_description, filtered]

