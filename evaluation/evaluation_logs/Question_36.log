matplotlib.use('Agg')
def filter_bungalow_results(data: list):
    import pandas as pd
    import geopandas as gpd
    
    df = data[0]
    # Columns to search for 'Bungalow'
    search_columns = [
        'addr:housename', 'addr:street', 'addr:place', 'addr:full', 'name'
    ]
    # Ensure columns exist and fillna with empty string for search
    for col in search_columns:
        if col not in df.columns:
            df[col] = ''
        else:
            df[col] = df[col].fillna('')
    # Filter rows where any of the columns contain 'Bungalow' (case-insensitive)
    mask = df[search_columns].apply(lambda row: row.str.contains('Bungalow', case=False, na=False)).any(axis=1)
    filtered = df[mask]
    summary = f"Filtered results containing 'Bungalow' in address or place columns. Number of entries: {len(filtered)}."
    description = "A filtered GeoDataFrame containing only rows where any of the address or place columns (addr:housename, addr:street, addr:place, addr:full, name) contain the word 'Bungalow'."
    return [summary, 'filtered_bungalow_results', description, filtered]

