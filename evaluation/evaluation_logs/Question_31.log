matplotlib.use('Agg')
def filter_mid_devon_named_areas(data: list):
    import pandas as pd
    import geopandas as gpd
    import ast
    
    gdf = data[0]
    # Ensure 'tags' is parsed as dict for searching
    def parse_tags(val):
        if pd.isnull(val):
            return {}
        try:
            return ast.literal_eval(val)
        except Exception:
            return {}
    gdf['tags_dict'] = gdf['tags'].apply(parse_tags)
    # Filter rows where 'Mid Devon' appears in 'name', 'tags', or 'operator'
    mask_name = gdf['name'].fillna('').str.contains('Mid Devon', case=False, na=False)
    mask_operator = gdf['operator'].fillna('').str.contains('Mid Devon', case=False, na=False)
    mask_tags = gdf['tags_dict'].apply(lambda d: any('mid devon' in str(v).lower() for v in d.values()))
    filtered = gdf[mask_name | mask_operator | mask_tags].copy()
    filtered = filtered.drop(columns=['tags_dict'])
    summary = f"Filtered results for 'Mid Devon': {len(filtered)} entries found. The filtered data includes only the named areas or features relevant to 'Mid Devon', using the 'name', 'tags', and 'operator' columns for accuracy."
    artifact_name = 'filtered_mid_devon_results'
    artifact_description = "GeoDataFrame containing only the named areas or features relevant to 'Mid Devon', filtered by the 'name', 'tags', and 'operator' columns."
    return [summary, artifact_name, artifact_description, filtered]

