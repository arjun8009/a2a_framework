2026-04-02 10:04:43,339 INFO Executing code import matplotlib
matplotlib.use('Agg')
def plot_buildings_near_hospitals(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import Point
    from shapely.ops import unary_union
    
    # Load data
    buildings = data[0].copy()
    hospitals = data[1].copy()
    
    # Ensure CRS is set and consistent (assume both are projected, reproject to EPSG:4326 for folium)
    if buildings.crs is None:
        buildings.set_crs(epsg=27700, inplace=True)  # Assume British National Grid if not set
    if hospitals.crs is None:
        hospitals.set_crs(epsg=27700, inplace=True)
    
    # Filter hospitals to only those with amenity 'hospital'
    hospital_gdf = hospitals[hospitals['amenity'] == 'hospital']
    
    # Create a 500m buffer around all hospital geometries
    hospital_buffer = hospital_gdf.to_crs(epsg=27700).buffer(500)
    hospital_buffer_union = unary_union(hospital_buffer)
    
    # Find buildings within 500m of any hospital
    buildings_proj = buildings.to_crs(epsg=27700)
    buildings_within_500m = buildings_proj[buildings_proj.intersects(hospital_buffer_union)]
    
    # Prepare for mapping: convert all to EPSG:4326
    buildings = buildings.to_crs(epsg=4326)
    hospital_gdf = hospital_gdf.to_crs(epsg=4326)
    buildings_within_500m = buildings_within_500m.to_crs(epsg=4326)
    
    # Create folium map centered on the mean location of buildings
    centroid = buildings.geometry.unary_union.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13)
    
    # Plot all buildings
    folium.GeoJson(buildings, name='All Buildings', style_function=lambda x: {'color': 'gray', 'weight': 1, 'fillOpacity': 0.2}).add_to(m)
    # Plot hospitals
    folium.GeoJson(hospital_gdf, name='Hospitals', style_function=lambda x: {'color': 'blue', 'weight': 3, 'fillOpacity': 0.1}).add_to(m)
    # Highlight buildings within 500m
    folium.GeoJson(buildings_within_500m, name='Buildings within 500m', style_function=lambda x: {'color': 'red', 'weight': 2, 'fillOpacity': 0.5}).add_to(m)
    
    folium.LayerControl().add_to(m)
    
    # Save map
    map_filename = 'buildings_near_hospitals_map.html'
    m.save(map_filename)
    
    # Prepare summary
    n_within = len(buildings_within_500m)
    ids_within = list(buildings_within_500m['id'].head(5))
    summary = f"{n_within} buildings are within 500m of a hospital. First 5 building IDs: {ids_within}"
    artifact_desc = "Folium map showing all buildings, hospitals, and highlighting buildings within 500m of any hospital. Includes summary of building IDs within 500m."
    return [summary, map_filename, artifact_desc, map_filename]

