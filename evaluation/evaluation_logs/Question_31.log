matplotlib.use('Agg')
def filter_colebrooke_named_areas(data: list):
    import pandas as pd
    import geopandas as gpd
    
    # Assume input is a GeoDataFrame
    gdf = data[0]
    
    # Filter for rows where 'name' contains 'Colebrooke' (case-insensitive)
    # Also check in 'tags' for any mention of 'Colebrooke' for completeness
    mask_name = gdf['name'].fillna('').str.contains('colebrooke', case=False, na=False)
    mask_tags = gdf['tags'].fillna('').str.contains('colebrooke', case=False, na=False)
    filtered = gdf[mask_name | mask_tags]
    
    summary = f"Filtered results for 'Colebrooke': {len(filtered)} entries found. Columns: {list(filtered.columns)}."
    artifact_name = 'filtered_colebrooke_results'
    artifact_description = "GeoDataFrame containing only the named areas or features relevant to 'Colebrooke', filtered by both the 'name' and 'tags' columns."
    
    return [summary, artifact_name, artifact_description, filtered]

