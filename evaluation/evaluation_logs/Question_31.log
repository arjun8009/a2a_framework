def filter_colebrooke_addresses(data: list):
    import pandas as pd
    import numpy as np
    df = data[0]
    # Define columns that may indicate a specific address or named institution
    address_cols = [
        'name', 'addr:housename', 'addr:housenumber', 'addr:street', 'addr:postcode', 'addr:city', 'amenity'
    ]
    # Filter for rows where at least one of these columns is not null or empty
    mask = (
        df['name'].notnull() & (df['name'].astype(str).str.strip() != '') |
        df['addr:housename'].notnull() & (df['addr:housename'].astype(str).str.strip() != '') |
        df['addr:housenumber'].notnull() & (df['addr:housenumber'].astype(str).str.strip() != '') |
        df['addr:street'].notnull() & (df['addr:street'].astype(str).str.strip() != '') |
        df['addr:postcode'].notnull() & (df['addr:postcode'].astype(str).str.strip() != '') |
        df['addr:city'].notnull() & (df['addr:city'].astype(str).str.strip() != '')
    )
    filtered = df[mask].copy()
    summary = f"Filtered {len(filtered)} entries with specific addresses or named institutions out of {len(df)} total entries."
    artifact_name = 'filtered_colebrooke_addresses'
    artifact_description = 'Entries from colebrooke_addresses with specific addresses or named institutions, using name, address, and amenity columns.'
    return [summary, artifact_name, artifact_description, filtered]

