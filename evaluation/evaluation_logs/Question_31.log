2026-04-02 10:01:42,483 INFO Executing code import matplotlib
matplotlib.use('Agg')
def filter_mid_devon_hospitals(data: list):
    import pandas as pd
    import geopandas as gpd
    df = data[0]
    # Ensure we work with a GeoDataFrame
    if not isinstance(df, (gpd.GeoDataFrame, pd.DataFrame)):
        return ["Input is not a DataFrame or GeoDataFrame", None, None, None]
    # Filter for hospitals, clinics, or healthcare facilities using 'amenity' and 'tags' columns
    amenity_mask = df['amenity'].fillna('').str.lower().isin(['hospital', 'clinic'])
    # Also check for healthcare-related keywords in the 'tags' column
    tags_mask = df['tags'].fillna('').str.contains('healthcare', case=False, na=False)
    filtered = df[amenity_mask | tags_mask]
    summary = f"Filtered {len(filtered)} entries related to hospitals, clinics, or healthcare facilities out of {len(df)} total entries."
    return [summary, 'filtered_mid_devon_hospitals', 'Entries from mid_devon_hospitals related to hospitals, clinics, or healthcare facilities, filtered using amenity and tags columns.', filtered]

