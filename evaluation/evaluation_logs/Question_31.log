matplotlib.use('Agg')
def filter_hospitals_only(data: list):
    import pandas as pd
    import geopandas as gpd
    
    # Assume the input is a list with a single GeoDataFrame
    gdf = data[0]
    # Filter for hospitals using the 'amenity' column
    # Acceptable values for hospitals in OSM are typically 'hospital', 'clinic', 'doctors', 'healthcare', etc.
    hospital_keywords = ['hospital', 'clinic', 'doctors', 'healthcare']
    filtered = gdf[gdf['amenity'].isin(hospital_keywords)]
    
    summary = f"Filtered hospital-related entries: {len(filtered)} found."
    artifact_name = 'filtered_hospital_results'
    artifact_description = (
        "A GeoDataFrame containing only entries related to hospitals, clinics, doctors, or healthcare facilities "
        "filtered from the original search results using the 'amenity' column."
    )
    return [summary, artifact_name, artifact_description, filtered]

