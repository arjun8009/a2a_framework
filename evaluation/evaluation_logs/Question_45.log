matplotlib.use('Agg')
def filter_exeter_polygon(data: list):
    gdf = data[0]
    # Filter for polygons where name1_text is 'Exeter' and description is 'City' or 'Town' or 'Settlement' or 'Part Of Settlement'
    filtered = gdf[(gdf['name1_text'].str.lower() == 'exeter') &
                   (gdf['description'].isin(['City', 'Town', 'Settlement', 'Part Of Settlement']))]
