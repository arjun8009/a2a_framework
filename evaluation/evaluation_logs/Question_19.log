matplotlib.use('Agg')
def filter_natural_material_buildings(data: list):
    import geopandas as gpd
    # Extract the GeoDataFrame
    gdf = data[0]
    # Define material lists
    roof_materials = ['thatch', 'reed', 'straw', 'wood', 'shingles', 'grass']
    building_materials = ['wood', 'timber']
    cladding_materials = ['timber', 'wood']
    # Check for columns existence and handle missing columns
    roof_col = 'roof:material' if 'roof:material' in gdf.columns else None
    building_col = 'building:material' if 'building:material' in gdf.columns else None
    cladding_col = 'cladding' if 'cladding' in gdf.columns else None
    # Build mask safely
    mask = False
    if roof_col:
        mask = mask | gdf[roof_col].isin(roof_materials)
    if building_col:
        mask = mask | gdf[building_col].isin(building_materials)
    if cladding_col:
        mask = mask | gdf[cladding_col].isin(cladding_materials)
    filtered_gdf = gdf[mask].copy()
    summary = f"Filtered {len(filtered_gdf)} buildings using natural materials out of {len(gdf)} total buildings."
    artifact_name = 'natural_material_buildings_hatherleigh.geojson'
    artifact_description = (
        "GeoDataFrame of building polygons in Hatherleigh where the roof:material is in ['thatch','reed','straw','wood','shingles','grass'], "
        "OR building:material is in ['wood','timber'], OR cladding is in ['timber','wood']. "
        f"Contains {len(filtered_gdf)} features."
    )
    return [summary, artifact_name, artifact_description, filtered_gdf]
# CODE EXECUTOR TOOL ONLY ACCEPTS THE FUNCTION SO WRITE FUNCTION AND USE CODE EXECUTOR TOOL
