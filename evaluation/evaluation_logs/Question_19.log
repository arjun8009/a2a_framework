matplotlib.use('Agg')
def filter_hatherleigh_named_areas(data: list):
    import pandas as pd
    import geopandas as gpd
    
    # Assume the input is a GeoDataFrame
    gdf = data[0]
    
    # Filter for relevant named area data for 'Hatherleigh'
    # Use multiple columns: 'name', 'tags', and 'boundary' for higher quality
    mask_name = gdf['name'].str.contains('Hatherleigh', case=False, na=False)
    mask_tags = gdf['tags'].str.contains('Hatherleigh', case=False, na=False)
    # Named areas are likely to have boundary types like 'administrative', 'place', 'protected_area', etc.
    named_area_types = [
        'administrative', 'place', 'protected_area', 'land_parcel', 'statistical',
        'historic:administrative', 'traditional', 'ceremonial', 'historic'
    ]
    mask_boundary = gdf['boundary'].isin(named_area_types)
    
    # Combine masks for high quality filtering
    mask = (mask_name | mask_tags) & mask_boundary
    filtered = gdf[mask]
    
    summary = f"Filtered to {len(filtered)} relevant named area entries for 'Hatherleigh'."
    artifact_name = 'filtered_hatherleigh_results'
    artifact_description = (
        "GeoDataFrame containing only the relevant named area data for 'Hatherleigh', "
        "filtered using the 'name', 'tags', and 'boundary' columns. Includes only entries "
        "with boundary types likely to represent named areas."
    )
    return [summary, artifact_name, artifact_description, filtered]

