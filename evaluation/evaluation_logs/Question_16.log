matplotlib.use('Agg')
def filter_torbay_named_area(data: list):
    import pandas as pd
    import geopandas as gpd
    import ast
    
    gdf = data[0]
    # Ensure all string columns are lowercase for consistent searching
    for col in ['name', 'operator', 'website', 'tags']:
        if col in gdf.columns:
            gdf[col] = gdf[col].astype(str).str.lower()
    
    # Filter for 'torbay' in relevant columns
    mask = (
        gdf['name'].str.contains('torbay', na=False) |
        gdf['operator'].str.contains('torbay', na=False) |
        gdf['website'].str.contains('torbay', na=False) |
        gdf['tags'].str.contains('torbay', na=False)
    )
    filtered = gdf[mask].copy()
    
    summary = f"Filtered named areas related to 'Torbay'. Number of entries found: {len(filtered)} out of {len(gdf)}. Columns used for filtering: name, operator, website, tags."
    artifact_name = 'filtered_torbay_named_area'
    artifact_description = ("A GeoDataFrame containing only those named areas from the original data that are specifically related to 'Torbay', "
                           "filtered using the columns 'name', 'operator', 'website', and 'tags'.")
    return [summary, artifact_name, artifact_description, filtered]

