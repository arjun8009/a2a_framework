def filter_devon_and_torbay_named_area(data: list):
    import pandas as pd
    import geopandas as gpd
    import json
    
    gdf = data[0]
    # Lowercase search for robustness
    def contains_devon_and_torbay(row):
        search_terms = ['devon and torbay', 'torbay and devon']
        # Check in 'name', 'operator', 'website', 'tags'
        for col in ['name', 'operator', 'website']:
            val = row[col]
            if pd.notnull(val):
                val_lower = str(val).lower()
                if any(term in val_lower for term in search_terms):
                    return True
        # Check in tags (JSON string)
        tags = row['tags']
        if pd.notnull(tags):
            try:
                tags_dict = json.loads(tags)
                for v in tags_dict.values():
                    if any(term in str(v).lower() for term in search_terms):
                        return True
            except Exception:
                pass
        return False
    
    filtered = gdf[gdf.apply(contains_devon_and_torbay, axis=1)]
    summary = f"Filtered named areas related to 'Devon and Torbay'. Number of entries found: {len(filtered)} out of {len(gdf)}. Columns used for filtering: name, operator, website, tags."
    artifact_name = 'filtered_devon_and_torbay_named_area'
    artifact_description = ("A GeoDataFrame containing only those named areas from the original data that are specifically related to 'Devon and Torbay', "
                           "filtered using the columns 'name', 'operator', 'website', and 'tags'.")
    return [summary, artifact_name, artifact_description, filtered]

