matplotlib.use('Agg')
def filter_car_park_results(data: list):
    import pandas as pd
    import geopandas as gpd
    import json
    
    df = data[0]
    # Car parks may be indicated by 'amenity' == 'parking' or 'parking' column not null
    # Also check 'tags' for car park related keywords
    mask_amenity = df['amenity'].fillna('').str.lower().str.contains('parking|car park')
    mask_parking_col = df['parking'].notnull() & (df['parking'].astype(str).str.lower().str.contains('car|public|surface|multi|underground|garage'))
    # Check tags for car park related keywords
    def tag_has_car_park(tag):
        if pd.isnull(tag):
            return False
        try:
            tag_dict = json.loads(tag)
            for k, v in tag_dict.items():
                if 'car' in str(k).lower() or 'car' in str(v).lower() or 'park' in str(k).lower() or 'park' in str(v).lower():
                    return True
        except Exception:
            return False
        return False
    mask_tags = df['tags'].apply(tag_has_car_park)
    # Combine all masks
    mask = mask_amenity | mask_parking_col | mask_tags
    filtered = df[mask]
    summary = f"Filtered car park results: {len(filtered)} entries found out of {len(df)}."
    artifact_name = 'filtered_car_park_results'
    artifact_description = 'Entries from car_park_results related to car parks, filtered using amenity, parking, and tags columns.'
    return [summary, artifact_name, artifact_description, filtered]

