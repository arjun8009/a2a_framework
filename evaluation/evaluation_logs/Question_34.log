matplotlib.use('Agg')
def filter_knowstone_named_area(data: list):
    import pandas as pd
    import geopandas as gpd
    
    # The input is expected to be a list with a single GeoDataFrame
    gdf = data[0]
    
    # Filter for relevant named area data for Knowstone
    # Use multiple columns: 'name', 'tags', and 'boundary' for higher quality
    # We want to find entries where 'Knowstone' appears in the 'name' or in the 'tags' (if tags is a string containing Knowstone)
    # Also, restrict to relevant boundary types for named areas
    mask = (
        (gdf['name'].str.contains('Knowstone', case=False, na=False)) |
        (gdf['tags'].str.contains('Knowstone', case=False, na=False))
    ) & (
        gdf['boundary'].isin([
            'protected_area', 'land_parcel', 'maritime', 'political',
            'administrative', 'ceremonial', 'historic', 'statistical',
            'historic:administrative', 'traditional', 'place', 'fire'
        ])
    )
    filtered = gdf[mask]
    
    summary = f"Filtered Knowstone named area results: {len(filtered)} entries found."
    artifact_name = 'filtered_knowstone_results'
    artifact_description = (
        "GeoDataFrame containing only the relevant named area data for Knowstone, "
        "filtered using the 'name', 'tags', and 'boundary' columns. Includes all relevant boundary types."
    )
    return [summary, artifact_name, artifact_description, filtered]

