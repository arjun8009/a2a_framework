def filter_school_places(data: list):
    import pandas as pd
    # Assume the input is a list with a single GeoDataFrame
    gdf = data[0]
    # Filter rows where the 'name' column contains 'School' (case-insensitive)
    filtered = gdf[gdf['name'].str.contains('School', case=False, na=False)]
    summary = f"Filtered results contain {len(filtered)} entries with 'School' in the name."
    artifact_name = 'filtered_school_results'
    artifact_description = "A GeoDataFrame containing only the places whose names contain 'School' from the original search results."
    return [summary, artifact_name, artifact_description, filtered]

