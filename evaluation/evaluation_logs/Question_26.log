matplotlib.use('Agg')
def filter_chittlehamholt_entries(data: list):
    import pandas as pd
    import geopandas as gpd
    # Assume the input is a GeoDataFrame
    gdf = data[0]
    # Filter using multiple columns for high quality: 'name', 'tags', 'operator', 'boundary', 'marker', 'admin_level'
    # Chittlehamholt may appear in 'name', 'tags', or possibly in 'operator'
    mask = (
        gdf['name'].fillna('').str.contains('Chittlehamholt', case=False, na=False) |
        gdf['tags'].fillna('').str.contains('Chittlehamholt', case=False, na=False) |
        gdf['operator'].fillna('').str.contains('Chittlehamholt', case=False, na=False)
    )
    filtered = gdf[mask]
    summary = f"Filtered results for Chittlehamholt: {len(filtered)} entries found."
    artifact_name = 'filtered_chittlehamholt_results'
    artifact_description = 'GeoDataFrame containing all entries relevant to Chittlehamholt, filtered using name, tags, and operator columns.'
    return [summary, artifact_name, artifact_description, filtered]

