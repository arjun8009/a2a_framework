n    ).add_to(m)\n    \n    # Add landuse_natural_areas\n    folium.GeoJson(\n        landuse_natural_areas_clip,\n        name=\'Natural Areas (Land Use)\',\n        style_function=lambda x: {\'color\': \'orange\', \'weight\': 2, \'fillOpacity\': 0.3}\n    ).add_to(m)\n    \n    folium.LayerControl().add_to(m)\n    \n    # Save map\n    map_filename = \'natural_areas_exeter_map.html\'\n    m.save(map_filename)\n    \n    # Prepare summary\n    summary = (\n        f"Map of natural areas in Exeter.\\n"\n        f"- Land Natural Land Features: {len(land_natural_land_features_clip)} polygons\\n"\n        f"- Landform Natural Land Features: {len(landform_natural_land_features_clip)} polygons\\n"\n        f"- Landuse Natural Areas: {len(landuse_natural_areas_clip)} polygons\\n"\n        f"First 5 Land Natural Land Features: {land_natural_land_features_clip[\'description\'].head(5).tolist()}\\n"\n        f"First 5 Landform Natural Land Features: {landform_natural_land_features_clip[\'description\'].head(5).tolist()}\\n"\n        f"First 5 Landuse Natural Areas: {landuse_natural_areas_clip[\'description\'].head(5).tolist()}"\n    )\n    \n    return [\n        summary,\n        \'natural_areas_exeter_map\',\n        \'Folium map showing natural land features, landform features, and natural land use areas within the Exeter city boundary.\',\n        map_filename\n    ]\n', 'artifact_names': ['land_natural_land_features_exeter', 'landform_natural_land_features_exeter', 'landuse_natural_areas_exeter', 'filtered_exeter_area_polygon']}
2026-02-06 10:53:41,452 INFO Executing code import matplotlib
matplotlib.use('Agg')
def plot_natural_areas_exeter(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import mapping
    
    # Unpack the data
    land_natural_land_features = data[0]
    landform_natural_land_features = data[1]
    landuse_natural_areas = data[2]
    exeter_polygon = data[3]
    
    # Ensure all are in EPSG:4326
    land_natural_land_features = land_natural_land_features.to_crs(epsg=4326)
    landform_natural_land_features = landform_natural_land_features.to_crs(epsg=4326)
    landuse_natural_areas = landuse_natural_areas.to_crs(epsg=4326)
    exeter_polygon = exeter_polygon.to_crs(epsg=4326)
    
    # Clip all features to Exeter polygon
    exeter_geom = exeter_polygon.iloc[0].geometry
    land_natural_land_features_clip = gpd.clip(land_natural_land_features, exeter_geom)
    landform_natural_land_features_clip = gpd.clip(landform_natural_land_features, exeter_geom)
    landuse_natural_areas_clip = gpd.clip(landuse_natural_areas, exeter_geom)
    
    # Get centroid for map
    centroid = exeter_geom.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=12, tiles='cartodbpositron')
    
    # Add Exeter boundary
    folium.GeoJson(
        mapping(exeter_geom),
        name='Exeter Boundary',
        style_function=lambda x: {'color': 'black', 'weight': 3, 'fillOpacity': 0}
    ).add_to(m)
    
    # Add land_natural_land_features
    folium.GeoJson(
        land_natural_land_features_clip,
