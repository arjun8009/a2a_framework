matplotlib.use('Agg')
import folium
import geopandas as gpd
from shapely.geometry import mapping

def plot_teignbridge_solar_potential(data: list):
    # Unpack data
    buildings = data[0]
    boundary = data[1]

    # Ensure CRS is EPSG:4326 for folium
    if buildings.crs != 'EPSG:4326':
        buildings = buildings.to_crs('EPSG:4326')
    if boundary.crs != 'EPSG:4326':
        boundary = boundary.to_crs('EPSG:4326')

    # Clip buildings to boundary (in case there are any outside)
    boundary_shape = boundary.iloc[0].geometry
    buildings_in_boundary = buildings[buildings.geometry.within(boundary_shape)]

    # Create folium map centered on Teignbridge
    centroid = boundary_shape.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=11, tiles='cartodbpositron')

    # Add boundary
    folium.GeoJson(
        boundary,
        name='Teignbridge Boundary',
        style_function=lambda x: {'color': 'blue', 'weight': 2, 'fillOpacity': 0.05}
    ).add_to(m)

    # Add buildings layer
    folium.GeoJson(
        buildings_in_boundary,
        name='Buildings (South-facing or Flat Roofs)',
        style_function=lambda x: {'color': 'orange', 'weight': 1, 'fillOpacity': 0.4}
    ).add_to(m)

    folium.LayerControl().add_to(m)

    # Save map
    map_filename = 'teignbridge_solar_potential_map.html'
    m.save(map_filename)

    # Prepare summary
    total_buildings = len(buildings_in_boundary)
    first5 = buildings_in_boundary.head(5)
    summary = (
        f"Total buildings with good solar power potential: {total_buildings}. "
        "Criteria: south-facing roof orientation or flat roofs. "
        f"First 5 building IDs: {list(first5['id'])}"
    )
    artifact_name = 'teignbridge_solar_potential_map'
    artifact_description = (
        "Folium map showing buildings in Teignbridge with good solar power potential (south-facing or flat roofs) "
        "overlaid on the Teignbridge district boundary. Buildings are shown in orange, boundary in blue."
    )
    return [summary, artifact_name, artifact_description, map_filename]

