matplotlib.use('Agg')
def filter_teignbridge_roof_orientation_or_flat(data: list):
    import geopandas as gpd
    # The relevant columns are 'roof:orientation' and 'roof:shape'
    gdf = data[0]
    # Normalize values for robust filtering
    orientation_col = 'roof:orientation'
    shape_col = 'roof:shape'
    # Some values may be in the tags column as JSON, so we need to extract them if missing
    import json
    def extract_from_tags(row, key):
        tags = row.get('tags')
        if tags and isinstance(tags, str):
            try:
                tags_dict = json.loads(tags.replace("'", '"'))
                return tags_dict.get(key)
            except Exception:
                return None
        return None
    # Fill missing 'roof:orientation' and 'roof:shape' from 'tags' if available
    if orientation_col not in gdf.columns:
        gdf[orientation_col] = gdf.apply(lambda row: extract_from_tags(row, orientation_col), axis=1)
    else:
        gdf[orientation_col] = gdf[orientation_col].combine_first(gdf.apply(lambda row: extract_from_tags(row, orientation_col), axis=1))
    if shape_col not in gdf.columns:
        gdf[shape_col] = gdf.apply(lambda row: extract_from_tags(row, shape_col), axis=1)
    else:
        gdf[shape_col] = gdf[shape_col].combine_first(gdf.apply(lambda row: extract_from_tags(row, shape_col), axis=1))
    # Filter for roof:orientation south or 180, or roof:shape flat
    mask_orientation = gdf[orientation_col].astype(str).str.lower().isin(['south', '180'])
    mask_shape = gdf[shape_col].astype(str).str.lower() == 'flat'
    filtered_gdf = gdf[mask_orientation | mask_shape].copy()
    # Save to geojson
    filtered_gdf.to_file('teignbridge_roof_orientation_or_flat.geojson', driver='GeoJSON')
    summary = f"Filtered {len(filtered_gdf)} buildings with roof:orientation 'south' or '180', or roof:shape 'flat'."
    artifact_name = 'teignbridge_roof_orientation_or_flat.geojson'
    artifact_description = "GeoDataFrame of buildings in Teignbridge where the roof orientation is 'south' or '180', or the roof shape is 'flat'. Includes geometry and all original attributes."
    return [summary, artifact_name, artifact_description, filtered_gdf]
