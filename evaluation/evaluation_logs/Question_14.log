matplotlib.use('Agg')
def filter_teignbridge_results(data: list):
    import pandas as pd
    import geopandas as gpd
    
    gdf = data[0]
    # Filter for rows relevant to Teignbridge
    # Check for 'Teignbridge' in 'name', 'operator', or 'website' columns
    mask = (
        (gdf['name'].str.contains('Teignbridge', case=False, na=False)) |
        (gdf['operator'].str.contains('Teignbridge', case=False, na=False)) |
        (gdf['website'].str.contains('teignbridge.gov.uk', case=False, na=False))
    )
    filtered_gdf = gdf[mask]
    
    summary = f"Filtered results for Teignbridge: {len(filtered_gdf)} entries found."
    artifact_name = 'filtered_teignbridge_results'
    artifact_description = 'GeoDataFrame containing only entries relevant to Teignbridge, filtered by name, operator, or website.'
    return [summary, artifact_name, artifact_description, filtered_gdf]

