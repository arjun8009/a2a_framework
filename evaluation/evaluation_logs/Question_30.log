matplotlib.use('Agg')
def filter_yeovil_district_hospital(data: list):
    import pandas as pd
    import geopandas as gpd
    
    gdf = data[0]
    # Filter for relevant data for 'Yeovil District Hospital' using multiple columns
    # We'll check 'name' and 'operator' columns for relevant matches
    mask = (
        (gdf['name'].str.contains('Yeovil District Hospital', case=False, na=False)) |
        (gdf['operator'].str.contains('Yeovil District Hospital', case=False, na=False))
    )
    filtered = gdf[mask]
    summary = f"Filtered to relevant data for 'Yeovil District Hospital'. Number of entries: {len(filtered)}."
    artifact_name = 'yeovil_district_hospital_filtered'
    artifact_description = "GeoDataFrame containing only the rows relevant to 'Yeovil District Hospital', filtered using the 'name' and 'operator' columns. Includes all columns and geometry."
    if len(filtered) == 0:
        return ["No relevant data for 'Yeovil District Hospital' was found in the provided artifact.", None, None, None]
    return [summary, artifact_name, artifact_description, filtered]

