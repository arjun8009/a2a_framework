matplotlib.use('Agg')
def filter_exeter_named_area(data:list):
    import pandas as pd
    import geopandas as gpd
    gdf = data[0]
    # Filter for rows where the 'name' column contains 'Exeter' (case-insensitive)
    filtered = gdf[gdf['name'].str.contains('Exeter', case=False, na=False)]
    summary = f"Filtered to named area(s) containing 'Exeter'. Number of entries: {len(filtered)}."
    artifact_name = 'exeter_filtered'
    artifact_description = "GeoDataFrame containing only the rows where the named area contains 'Exeter', including all columns and geometry."
    return [summary, artifact_name, artifact_description, filtered]

