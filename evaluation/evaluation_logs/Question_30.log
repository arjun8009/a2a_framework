matplotlib.use('Agg')
def filter_exeter_hospitals(data: list):
    import pandas as pd
    import geopandas as gpd
    # The relevant columns for filtering are 'name' and 'amenity'
    gdf = data[0]
    # Filter for rows where 'name' contains 'Hospital' (case-insensitive)
    filtered = gdf[gdf['name'].str.contains('Hospital', case=False, na=False)]
    summary = f"Filtered Exeter hospitals with 'Hospital' in name: {len(filtered)} entries found."
    description = "A GeoDataFrame containing only those entries from the Exeter hospitals dataset where the place name contains 'Hospital'. Includes all columns and geometry."
    return [summary, 'filtered_exeter_hospitals', description, filtered]

