2026-04-02 09:56:17,081 INFO Executing code import matplotlib
matplotlib.use('Agg')
def plot_houses_and_hospitals_exeter(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import Point
    import os

    # Unpack data
    houses = data[0]
    hospitals = data[1]

    # Ensure CRS is EPSG:4326 for folium compatibility
    houses = houses.to_crs(epsg=4326)
    hospitals = hospitals.to_crs(epsg=4326)

    # Filter houses: building types that are residential
    residential_types = [
        'house', 'detached', 'semidetached_house', 'residential', 'terrace'
    ]
    houses_res = houses[houses['building'].isin(residential_types)]

    # Buffer hospitals by 1.5 km (1500 meters)
    hospitals_buffer = hospitals.copy()
    hospitals_buffer['geometry'] = hospitals_buffer.geometry.buffer(0.0135)  # ~1.5km in degrees (approx)

    # Find houses within 1.5 km of any hospital
    houses_within_buffer = gpd.sjoin(houses_res, hospitals_buffer[['geometry']], how='inner', predicate='intersects')
    houses_within_buffer_ids = set(houses_within_buffer.index)

    # Add a column to highlight houses within 1.5km
    houses_res['within_1_5km_hospital'] = houses_res.index.isin(houses_within_buffer_ids)

    # Create folium map centered on Exeter
    exeter_center = [50.7218, -3.5336]
    m = folium.Map(location=exeter_center, zoom_start=13, tiles='cartodbpositron')

    # Plot all houses (grey)
    folium.GeoJson(
        houses_res[~houses_res['within_1_5km_hospital']],
        name='Houses (not within 1.5km of hospital)',
        style_function=lambda x: {'color': 'grey', 'weight': 1, 'fillOpacity': 0.2}
    ).add_to(m)

    # Plot houses within 1.5km (red)
    folium.GeoJson(
        houses_res[houses_res['within_1_5km_hospital']],
        name='Houses within 1.5km of hospital',
        style_function=lambda x: {'color': 'red', 'weight': 2, 'fillOpacity': 0.5}
    ).add_to(m)

    # Plot hospitals (blue)
    folium.GeoJson(
        hospitals,
        name='Hospitals',
        style_function=lambda x: {'color': 'blue', 'weight': 3, 'fillOpacity': 0.3}
    ).add_to(m)

    # Add layer control
    folium.LayerControl().add_to(m)

    # Save map
    map_filename = 'houses_hospitals_exeter_map.html'
    m.save(map_filename)

    # Prepare summary
    summary = f"Total houses: {len(houses_res)}. Houses within 1.5km of a hospital: {houses_res['within_1_5km_hospital'].sum()}. Total hospitals: {len(hospitals)}.\n"
    summary += "First 5 houses within 1.5km:\n" + str(houses_res[houses_res['within_1_5km_hospital']][['addr:street','addr:housenumber','addr:postcode']].head(5))

    return [
        summary,
        'houses_hospitals_exeter_map',
        'A folium map showing all residential houses in Exeter, hospitals, and highlighting houses within 1.5km of any hospital. Houses within 1.5km are shown in red, others in grey, hospitals in blue.',
        map_filename
    ]
