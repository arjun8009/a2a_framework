matplotlib.use('Agg')
def filter_yeovil_named_area(data: list):
    import pandas as pd
    import geopandas as gpd
    
    gdf = data[0]
    # Filter for rows where the 'name' column contains 'Yeovil' (case-insensitive)
    filtered = gdf[gdf['name'].str.contains('Yeovil', case=False, na=False)]
    summary = f"Filtered to named area(s) containing 'Yeovil'. Number of entries: {len(filtered)}."
    artifact_name = 'yeovil_filtered'
    artifact_description = "GeoDataFrame containing only the rows where the named area contains 'Yeovil', including all columns and geometry."
    return [summary, artifact_name, artifact_description, filtered]

