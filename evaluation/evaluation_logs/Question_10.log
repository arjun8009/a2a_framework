2026-04-01 17:02:05,217 INFO Executing code import matplotlib
matplotlib.use('Agg')
def plot_dunterton_boundary_and_buildings(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import mapping
    
    # Unpack data
    boundary_gdf = data[0].copy()
    buildings_gdf = data[1].copy()
    
    # Ensure CRS is EPSG:4326 for folium
    if boundary_gdf.crs is None or boundary_gdf.crs.to_epsg() != 4326:
        boundary_gdf = boundary_gdf.to_crs(epsg=4326)
    if buildings_gdf.crs is None or buildings_gdf.crs.to_epsg() != 4326:
        buildings_gdf = buildings_gdf.to_crs(epsg=4326)

    # Get centroid for map initialization
    centroid = boundary_gdf.geometry.iloc[0].centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=14)

    # Plot boundary
    folium.GeoJson(
        boundary_gdf,
        name='Dunterton Boundary',
        style_function=lambda x: {'color': 'blue', 'weight': 3, 'fillOpacity': 0.05}
    ).add_to(m)

    # Filter buildings with at least one postal address (any addr:* column not null)
    address_cols = [col for col in buildings_gdf.columns if col.startswith('addr:')]
    has_address = buildings_gdf[address_cols].notnull().any(axis=1)
    buildings_with_address = buildings_gdf[has_address]

    # Plot buildings with addresses
    folium.GeoJson(
        buildings_with_address,
        name='Buildings with Address',
        style_function=lambda x: {'color': 'red', 'weight': 2, 'fillOpacity': 0.3},
        tooltip=folium.GeoJsonTooltip(fields=['name', 'addr:postcode'], aliases=['Name', 'Postcode'])
    ).add_to(m)

    folium.LayerControl().add_to(m)
    map_filename = 'dunterton_buildings_with_addresses_map.html'
    m.save(map_filename)

    # Prepare summary
    summary_rows = buildings_with_address[['name', 'addr:postcode']].head(5).to_dict('records')
    summary = (
        f"Plotted Dunterton area boundary and {len(buildings_with_address)} building(s) with at least one postal address. "
        f"First 5 buildings: {summary_rows}"
    )
    artifact_name = 'dunterton_buildings_with_addresses_map'
    artifact_description = (
        'A folium map showing the Dunterton area boundary (blue) and all building polygons with at least one postal address (red) within Dunterton.'
    )
    return [summary, artifact_name, artifact_description, map_filename]

