matplotlib.use('Agg')
def filter_buildings_with_addresses(data: list):
    import geopandas as gpd
    gdf = data[0]
    # List all columns that start with 'addr:'
    address_columns = [col for col in gdf.columns if col.startswith('addr:')]
    # Filter rows where at least one address column is not null
    filtered_gdf = gdf[gdf[address_columns].notnull().any(axis=1)]
    summary = f"Filtered buildings with at least one address tag present. {len(filtered_gdf)} out of {len(gdf)} buildings retained."
    artifact_name = 'buildings_with_addresses_in_filtered_dunterton.geojson'
    artifact_description = 'GeoDataFrame of building polygons in Dunterton that have at least one non-null address tag (columns starting with addr:).'
    return [summary, artifact_name, artifact_description, filtered_gdf]

