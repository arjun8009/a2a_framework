matplotlib.use('Agg')
def filter_buildings_thatch_roof_or_material(data: list):
    import geopandas as gpd
    gdf = data[0]
    # Check if 'roof:material' exists, if not, create it with None values
    if 'roof:material' not in gdf.columns:
        gdf['roof:material'] = None
    # Check if 'building:material' exists, if not, create it with None values
    if 'building:material' not in gdf.columns:
        gdf['building:material'] = None
    # Filter where 'roof:material' == 'thatch' OR 'building:material' == 'thatch'
    filtered = gdf[(gdf['roof:material'] == 'thatch') | (gdf['building:material'] == 'thatch')]
    summary = f"Filtered buildings with 'roof:material' or 'building:material' as 'thatch'. Number of entries: {len(filtered)}."
    artifact_name = 'buildings_thatch_roof_or_material_in_filtered_relation_3882437406.geojson'
    artifact_description = ("GeoDataFrame containing only buildings where either the 'roof:material' or 'building:material' "
                           "column is exactly 'thatch'. Includes all original columns and geometry.")
    if len(filtered) == 0:
        return [summary, None, None, None]
    return [summary, artifact_name, artifact_description, filtered]

