def filter_filleigh_england(data: list):
    import pandas as pd
    import geopandas as gpd
    
    gdf = data[0]
    # Filter for entries where 'name' contains 'Filleigh' (case-insensitive)
    mask_name = gdf['name'].str.contains('Filleigh', case=False, na=False)
    # Also check in 'tags' for 'Filleigh' (case-insensitive)
    mask_tags = gdf['tags'].str.contains('Filleigh', case=False, na=False)
    # Combine masks for higher quality
    mask = mask_name | mask_tags
    filtered = gdf[mask].copy()
    # Focus on relevant columns
    columns = ['name', 'tags', 'boundary', 'geometry']
    filtered = filtered[columns]
    summary = f"Filtered entries for 'Filleigh, England': {len(filtered)} found. Columns: {columns}."
    artifact_name = 'filtered_filleigh_england'
    artifact_description = "GeoDataFrame containing only the relevant entries for 'Filleigh, England', focusing on name, tags, and boundary columns."
    if len(filtered) == 0:
        return ["No entries specifically related to 'Filleigh, England' were found.", None, None, None]
    return [summary, artifact_name, artifact_description, filtered]

