def filter_filleigh_civil_parish(data: list):
    import pandas as pd
    import geopandas as gpd
    # Assume data[0] is the filleigh_civil_parish GeoDataFrame
    gdf = data[0]
    # Filter for entries where 'name' contains 'Filleigh' (case-insensitive)
    mask_name = gdf['name'].str.contains('Filleigh', case=False, na=False)
    # Also check 'tags' for 'Filleigh' (case-insensitive)
    mask_tags = gdf['tags'].str.contains('Filleigh', case=False, na=False)
    # Also check if 'boundary' is relevant (e.g., 'administrative', 'political', 'parish', etc.)
    mask_boundary = gdf['boundary'].str.contains('parish|administrative|political', case=False, na=False)
    # Combine masks for high-quality filtering
    mask = (mask_name | mask_tags) & mask_boundary
    filtered = gdf.loc[mask, ['name', 'tags', 'boundary', 'geometry']]
    summary = f"Filtered Filleigh civil parish data: {len(filtered)} entries found. Columns: name, tags, boundary, geometry."
    artifact_name = 'filtered_filleigh_civil_parish'
    artifact_description = "GeoDataFrame containing only the relevant entries for 'Filleigh' civil parish, focusing on name, tags, and boundary columns."
    return [summary, artifact_name, artifact_description, filtered]

