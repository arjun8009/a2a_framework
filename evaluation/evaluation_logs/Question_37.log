matplotlib.use('Agg')
def filter_filleigh_civil_parish_specific(data: list):
    import pandas as pd
    import geopandas as gpd
    
    gdf = data[0]
    # Filter for entries where name is exactly 'Filleigh (civil parish)'
    filtered = gdf[gdf['name'].fillna('').str.lower() == 'filleigh (civil parish)']
    # Select relevant columns
    filtered = filtered[['name', 'tags', 'boundary', 'geometry']]
    summary = f"Filtered data for 'Filleigh (civil parish)': {len(filtered)} entries found. Columns: {list(filtered.columns)}."
    artifact_name = 'filtered_filleigh_civil_parish'
    artifact_description = "GeoDataFrame containing only the entries for 'Filleigh (civil parish)', focusing on name, tags, boundary, and geometry columns."
    return [summary, artifact_name, artifact_description, filtered]

