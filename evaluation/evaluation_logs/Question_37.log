matplotlib.use('Agg')
def filter_filleigh_north_devon(data: list):
    import pandas as pd
    import geopandas as gpd
    
    df = data[0]
    # Ensure we are working with a GeoDataFrame
    if not isinstance(df, gpd.GeoDataFrame):
        df = gpd.GeoDataFrame(df)
    
    # Filter for entries related to 'Filleigh' in North Devon
    # Use 'name' for 'Filleigh', and check 'tags' or 'operator' for 'North Devon' context
    mask = (
        df['name'].str.contains('Filleigh', case=False, na=False)
    )
    # Further filter for North Devon context
    # Check if 'tags' or 'operator' mention 'North Devon'
    mask_north_devon = (
        df['tags'].str.contains('north devon', case=False, na=False) |
        df['operator'].str.contains('north devon', case=False, na=False)
    )
    filtered = df[mask & mask_north_devon]
    
    summary = f"Filtered entries for 'Filleigh' in North Devon: {len(filtered)} entries found."
    artifact_name = 'filtered_filleigh_north_devon'
    artifact_description = ("GeoDataFrame containing only the relevant entries for 'Filleigh' in North Devon, "
                           "filtered using name, tags, and operator columns.")
    return [summary, artifact_name, artifact_description, filtered]

