matplotlib.use('Agg')
def filter_houses_with_thatch_roof(data: list):
    # The relevant column is 'roof:material'
    gdf = data[0]
    # Filter for houses with thatch roof
    filtered_gdf = gdf[gdf['roof:material'] == 'thatch']
    summary = f"Filtered dataset to only include buildings with 'roof:material' as 'thatch'. Number of entries: {len(filtered_gdf)}."
    artifact_name = 'houses_with_thatch_roof_in_filtered_relation_3882437406.geojson'
    artifact_description = "GeoDataFrame containing only buildings where the 'roof:material' attribute is 'thatch' from the original dataset."
    return [summary, artifact_name, artifact_description, filtered_gdf]

