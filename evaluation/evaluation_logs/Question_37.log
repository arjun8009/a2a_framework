def filter_filleigh_named_area(data: list):
    import pandas as pd
    import geopandas as gpd
    
    # Assume the input is a GeoDataFrame
    gdf = data[0]
    
    # Filter for relevant named area data for Filleigh
    # Use multiple columns: 'name', 'tags', and possibly 'operator' for higher quality
    mask = (
        gdf['name'].str.contains('Filleigh', case=False, na=False) |
        gdf['tags'].str.contains('Filleigh', case=False, na=False) |
        gdf['operator'].str.contains('Filleigh', case=False, na=False)
    )
    filtered = gdf[mask]
    
    summary = f"Filtered results for Filleigh: {len(filtered)} entries found. Columns: {list(filtered.columns)}."
    artifact_name = 'filtered_filleigh_results'
    artifact_description = 'GeoDataFrame containing only the relevant named area data for Filleigh, filtered using name, tags, and operator columns.'
    artifact_data = filtered
    
    return [summary, artifact_name, artifact_description, artifact_data]

