matplotlib.use('Agg')
def filter_east_down_boundary(data: list):
    import geopandas as gpd
    # The relevant columns for filtering are 'name' and 'boundary'.
    gdf = data[0]
    # Filter for rows where the name is exactly 'East Down' (case-insensitive, strip whitespace)
    filtered = gdf[gdf['name'].str.strip().str.lower() == 'east down']
    summary = f"Filtered to {len(filtered)} entries for the area boundary 'East Down'."
    artifact_name = 'filtered_east_down_boundary'
    artifact_description = "GeoDataFrame containing only the boundary entries for 'East Down', including all columns and geometry."
    return [summary, artifact_name, artifact_description, filtered]

