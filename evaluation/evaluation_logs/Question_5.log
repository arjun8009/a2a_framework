l\'\n    m.save(map_filename)\n    \n    # Prepare summary\n    n_buildings = len(buildings_within_1km)\n    summary_rows = buildings_within_1km[[\'id\', \'name\', \'addr:street\', \'addr:housenumber\', \'building\']].head(5).to_dict(\'records\')\n    summary = f"There are {n_buildings} buildings within 1 km of the specified point. First 5 results: {summary_rows}"\n    \n    return [summary, \'buildings_within_1km_map\', \'Folium map showing all buildings within 1 km of the specified OS National Grid point, with buffer and point overlay.\', map_filename]\n', 'artifact_names': ['buildings_all_buildings_in_filtered_exeter_named_area']}
2026-04-01 16:38:46,921 INFO Executing code import matplotlib
matplotlib.use('Agg')
def plot_buildings_within_1km_of_point(data: list):
    import geopandas as gpd
    from shapely.geometry import Point
    import folium
    
    # Extract the buildings GeoDataFrame
    buildings_gdf = data[0]
    
    # Ensure CRS is British National Grid (EPSG:27700) for distance calculations
    if buildings_gdf.crs is None or buildings_gdf.crs.to_epsg() != 27700:
        buildings_gdf = buildings_gdf.to_crs(epsg=27700)
    
    # Define the point in OS National Grid (EPSG:27700)
    point = Point(435662.6, 121603.3)
    
    # Create a 1 km buffer around the point
    buffer = point.buffer(1000)  # 1000 meters = 1 km
    
    # Filter buildings within the buffer
    buildings_within_1km = buildings_gdf[buildings_gdf.intersects(buffer)]
    
    # Convert to WGS84 for folium plotting
    buildings_within_1km = buildings_within_1km.to_crs(epsg=4326)
    
    # Also convert the buffer and point for plotting
    buffer_wgs84 = gpd.GeoSeries([buffer], crs='EPSG:27700').to_crs(epsg=4326)
    point_wgs84 = gpd.GeoSeries([point], crs='EPSG:27700').to_crs(epsg=4326)
    
    # Create a folium map centered at the point
    center = [point_wgs84.geometry[0].y, point_wgs84.geometry[0].x]
    m = folium.Map(location=center, zoom_start=15)
    
    # Add the buffer
    folium.GeoJson(buffer_wgs84.geometry[0], name='1km Buffer', style_function=lambda x: {'color': 'blue', 'fill': False, 'weight': 2}).add_to(m)
    # Add the point
    folium.Marker(location=center, popup='Query Point', icon=folium.Icon(color='red')).add_to(m)
    # Add the buildings
    folium.GeoJson(buildings_within_1km, name='Buildings within 1km', style_function=lambda x: {'color': 'green', 'fill': True, 'weight': 1, 'fillOpacity': 0.4}).add_to(m)
    
    folium.LayerControl().add_to(m)
    
    # Save the map
    map_filename = 'buildings_within_1km_map.html'
    m.save(map_filename)
    
    # Prepare summary
    n_buildings = len(buildings_within_1km)
    summary_rows = buildings_within_1km[['id', 'name', 'addr:street', 'addr:housenumber', 'building']].head(5).to_dict('records')
    summary = f"There are {n_buildings} buildings within 1 km of the specified point. First 5 results: {summary_rows}"
    
    return [summary, 'buildings_within_1km_map', 'Folium map showing all buildings within 1 km of the specified OS National Grid point, with buffer and point overlay.', map_filename]

