matplotlib.use('Agg')
def filter_exeter_named_areas(data: list):
    import pandas as pd
    import geopandas as gpd
    
    gdf = data[0]
    # Filter for rows where 'name' contains 'Exeter' (case-insensitive) or 'operator' contains 'Exeter' or 'website' contains 'exeter.gov.uk'
    mask = (
        gdf['name'].str.contains('Exeter', case=False, na=False) |
        gdf['operator'].str.contains('Exeter', case=False, na=False) |
        gdf['website'].str.contains('exeter.gov.uk', case=False, na=False)
    )
    filtered_gdf = gdf[mask]
    
    summary = f"Filtered named areas relevant to 'Exeter'. Number of entries: {len(filtered_gdf)}."
    artifact_name = 'filtered_exeter_named_area'
    artifact_description = "GeoDataFrame containing only those named areas from the original data that are specifically relevant to 'Exeter', filtered using the 'name', 'operator', and 'website' columns."
    return [summary, artifact_name, artifact_description, filtered_gdf]

