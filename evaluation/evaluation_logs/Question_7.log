def filter_west_buckland_entries(data: list):
    import pandas as pd
    import geopandas as gpd
    df = data[0]
    # Use multiple columns to filter for 'West Buckland' specifically
    mask = (
        (df['name'].str.contains('West Buckland', case=False, na=False)) |
        (df['operator'].str.contains('West Buckland', case=False, na=False)) |
        (df['website'].str.contains('westbuckland', case=False, na=False)) |
        (df['addr:suburb'].str.contains('West Buckland', case=False, na=False) if 'addr:suburb' in df.columns else False) |
        (df['tags'].str.contains('West Buckland', case=False, na=False))
    )
    # Also check for postcode EX32 0SX which is in West Buckland
    mask = mask | (df['addr:postcode'].str.contains('EX32 0SX', case=False, na=False))
    # If 'tags' column contains a JSON string, check for West Buckland in it
    filtered = df[mask]
    summary = f"Filtered results for 'West Buckland': {len(filtered)} entries found."
