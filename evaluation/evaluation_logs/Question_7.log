def filter_devon_named_area(data:list):
    import pandas as pd
    import geopandas as gpd
    # The relevant columns for filtering are 'name' and possibly 'tags' for references to Devon
    gdf = data[0]
    # Filter where 'name' contains 'Devon' (case-insensitive)
    filtered = gdf[gdf['name'].str.contains('Devon', case=False, na=False)]
    summary = f"Filtered dataset for named areas related to 'Devon' contains {len(filtered)} entries."
    if len(filtered) == 0:
        return [summary, None, None, None]
    return [
        summary,
        'filtered_devon_named_area',
        'GeoDataFrame containing only named areas relevant to Devon, filtered by the name column.',
        filtered
    ]

