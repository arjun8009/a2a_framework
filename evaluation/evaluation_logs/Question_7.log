matplotlib.use('Agg')
def filter_east_and_west_buckland(data: list):
    import pandas as pd
    import geopandas as gpd
    # Assume the input is a GeoDataFrame
    gdf = data[0]
    # Filter for entries where the 'name' column contains 'East and West Buckland' (case-insensitive)
    filtered = gdf[gdf['name'].str.contains('East and West Buckland', case=False, na=False)]
    summary = f"Filtered dataset for entries relevant to 'East and West Buckland' contains {len(filtered)} entries."
    if len(filtered) == 0:
        return [summary, None, None, None]
    return [
        summary,
        'filtered_east_and_west_buckland',
        "GeoDataFrame containing only entries relevant to 'East and West Buckland', filtered by the name column.",
        filtered
    ]

