matplotlib.use('Agg')
def filter_east_buckland_entries(data: list):
    import pandas as pd
    import geopandas as gpd
    df = data[0]
    # Use multiple columns to filter for 'East Buckland' related entries
    mask = (
        (df['name'].str.contains('East Buckland', case=False, na=False)) |
        (df['addr:city'].str.contains('East Buckland', case=False, na=False)) |
        (df['addr:postcode'].str.contains('EX32', case=False, na=False)) |
        (df['tags'].str.contains('East Buckland', case=False, na=False))
    )
    filtered = df[mask]
    summary = f"Filtered results for 'East Buckland': {len(filtered)} entries found."
    artifact_name = 'filtered_east_buckland_results'
    artifact_description = "Entries from 'east_buckland_search_results' specifically related to 'East Buckland', filtered using multiple relevant columns."
    return [summary, artifact_name, artifact_description, filtered]

