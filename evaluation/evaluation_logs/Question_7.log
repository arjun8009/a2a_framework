2026-04-01 16:52:31,340 INFO Executing code import matplotlib
matplotlib.use('Agg')
def plot_buildings_between_1km_2km_from_both_points(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import Point
    import os

    # Unpack data
    buildings = data[0]
    east_buckland = data[1]
    west_buckland = data[2]

    # Ensure all CRS are the same and projected for distance calculations
    # Assume input is in British National Grid (EPSG:27700) for meter-based buffering
    buildings = buildings.to_crs(epsg=27700)
    east_buckland = east_buckland.to_crs(epsg=27700)
    west_buckland = west_buckland.to_crs(epsg=27700)

    # Get all geometries for East Buckland (should be 1 polygon)
    east_geom = east_buckland.geometry.unary_union
    # Get all geometries for West Buckland (could be 1 point and 1 polygon)
    west_geom = west_buckland.geometry.unary_union

    # Create 1km and 2km buffers for both locations
    east_buffer_1km = east_geom.buffer(1000)
    east_buffer_2km = east_geom.buffer(2000)
    west_buffer_1km = west_geom.buffer(1000)
    west_buffer_2km = west_geom.buffer(2000)

    # Area between 1km and 2km for both
    east_ring = east_buffer_2km.difference(east_buffer_1km)
    west_ring = west_buffer_2km.difference(west_buffer_1km)

    # Intersection of both rings: buildings must be in both
    intersection_area = east_ring.intersection(west_ring)

    # Select buildings whose centroid falls within the intersection area
    buildings['centroid'] = buildings.geometry.centroid
    selected = buildings[buildings['centroid'].apply(lambda x: intersection_area.contains(x))].copy()

    # Prepare summary
    summary_rows = selected[['id', 'name', 'building', 'geometry']].head(5)
    summary = f"Selected {len(selected)} buildings between 1km and 2km from BOTH East and West Buckland. First 5 results:\n" + summary_rows.to_string(index=False)

    # Prepare map (convert to EPSG:4326 for folium)
    selected = selected.to_crs(epsg=4326)
    east_buckland = east_buckland.to_crs(epsg=4326)
    west_buckland = west_buckland.to_crs(epsg=4326)

    # Center map on the centroid of the intersection area (convert to EPSG:4326)
    intersection_gdf = gpd.GeoDataFrame(geometry=[intersection_area], crs='EPSG:27700').to_crs(epsg=4326)
    centroid = intersection_gdf.geometry[0].centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=14)

    # Plot intersection area
    folium.GeoJson(intersection_gdf.geometry[0], name='Intersection Area', style_function=lambda x: {'fillColor': 'yellow', 'color': 'orange', 'weight': 2, 'fillOpacity': 0.2}).add_to(m)

    # Plot selected buildings
    for _, row in selected.iterrows():
        folium.GeoJson(row['geometry'], name=f"Building {row['id']}", style_function=lambda x: {'fillColor': 'blue', 'color': 'blue', 'weight': 2, 'fillOpacity': 0.5}).add_to(m)
        if row['name']:
            folium.Marker([row['geometry'].centroid.y, row['geometry'].centroid.x], popup=row['name']).add_to(m)

    # Plot East Buckland and West Buckland locations
    for _, row in east_buckland.iterrows():
        folium.GeoJson(row['geometry'], name='East Buckland', style_function=lambda x: {'color': 'green', 'weight': 2, 'fillOpacity': 0.1}).add_to(m)
    for _, row in west_buckland.iterrows():
        folium.GeoJson(row['geometry'], name='West Buckland', style_function=lambda x: {'color': 'red', 'weight': 2, 'fillOpacity': 0.1}).add_to(m)

    # Save map
    map_filename = 'buildings_between_1km_2km_east_west_buckland.html'
    m.save(map_filename)

    artifact_description = (
        "A folium map showing buildings located between 1km and 2km from BOTH East Buckland and West Buckland. "
        "The intersection area is highlighted in yellow, buildings in blue, East Buckland in green, and West Buckland in red. "
        "Popup labels show building names where available."
    )
    return [summary, map_filename, artifact_description, map_filename]

