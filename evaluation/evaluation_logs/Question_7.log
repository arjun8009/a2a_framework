def filter_west_buckland(data: list):
    import pandas as pd
    import geopandas as gpd
    # Assume the input is a GeoDataFrame
    gdf = data[0]
    # Filter for entries where 'name' contains 'West Buckland' (case-insensitive, exact match or substring)
    filtered = gdf[gdf['name'].str.contains('West Buckland', case=False, na=False)]
    summary = f"Filtered dataset for 'West Buckland' contains {len(filtered)} entries."
    if len(filtered) == 0:
        return [summary, None, None, None]
    return [summary, 'filtered_west_buckland', 'GeoDataFrame containing only entries relevant to West Buckland, filtered by the name column.', filtered]

