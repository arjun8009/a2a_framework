def filter_east_buckland(data: list):
    import pandas as pd
    import geopandas as gpd
    # Assume the input is a GeoDataFrame
    gdf = data[0]
    # Filter for entries where the 'name' column matches 'East Buckland' (case-insensitive, exact match)
    filtered = gdf[gdf['name'].str.lower() == 'east buckland'.lower()]
    summary = f"Filtered dataset for 'East Buckland' contains {len(filtered)} entries."
    if len(filtered) == 0:
        return [summary, None, None, None]
    return [summary, 'filtered_east_buckland', 'GeoDataFrame containing only entries relevant to East Buckland, filtered by the name column.', filtered]

