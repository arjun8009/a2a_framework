matplotlib.use('Agg')
def filter_torridge_district_named_area(data:list):
    import pandas as pd
    gdf = data[0]
    # Filter for 'Torridge District' in the 'name' column, and check for relevant admin_level and boundary
    filtered = gdf[(gdf['name'].str.lower() == 'torridge district') &
                   (gdf['boundary'].isin(['administrative', 'political'])) &
                   (gdf['admin_level'].isin(['6', '8', '5']))]
    summary = f"Filtered named areas for 'Torridge District': {len(filtered)} entry(ies) found."
    artifact_name = 'filtered_torridge_district_named_area'
    artifact_description = ("This artifact contains the filtered named area(s) for 'Torridge District' in Devon, UK. "
                           "Filtering was performed using the 'name', 'boundary', and 'admin_level' columns for best match. "
                           "The data structure includes columns such as 'name', 'boundary', 'geometry', 'tags', 'admin_level', and others. "
                           "This can be used for spatial or administrative analysis.")
    return [summary, artifact_name, artifact_description, filtered]

