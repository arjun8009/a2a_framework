def filter_bideford_named_area(data: list):
    import pandas as pd
    import geopandas as gpd
    
    gdf = data[0]
    # Filter for rows where 'name' contains 'Bideford' (case-insensitive)
    # and also check for 'North Devon' in relevant columns if available
    # Use 'name', 'tags', and possibly 'operator' for best match
    mask = (
        gdf['name'].str.contains('Bideford', case=False, na=False)
