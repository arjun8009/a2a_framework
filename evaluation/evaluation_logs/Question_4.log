matplotlib.use('Agg')
def plot_commercial_buildings_near_bideford(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import Polygon
    
    # Unpack data
    buildings = data[0].copy()
    bideford = data[1].copy()
    
    # Ensure CRS is set and convert to EPSG:4326 for folium
    if buildings.crs is None:
        buildings.set_crs(epsg=4326, inplace=True)
    else:
        buildings = buildings.to_crs(epsg=4326)
    if bideford.crs is None:
        bideford.set_crs(epsg=4326, inplace=True)
    else:
        bideford = bideford.to_crs(epsg=4326)
    
    # Buffer the Bideford boundary by 5 km (5000 meters)
    bideford_buffer = bideford.geometry.buffer(5000/111320)  # Approximate conversion for degrees
    
    # Spatial filter: buildings within 5 km of Bideford boundary
    buildings_within_5km = buildings[buildings.geometry.apply(lambda x: bideford_buffer.intersects(x).any())]
    
    # Prepare summary
    summary_rows = buildings_within_5km[['name', 'addr:street', 'addr:postcode', 'addr:city', 'id']].head(5)
    summary = f"Found {len(buildings_within_5km)} commercial buildings within 5 km of Bideford boundary. First 5 results:\n" + summary_rows.to_string(index=False)
    
    # Create folium map centered on Bideford
    centroid = bideford.geometry.centroid.iloc[0]
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=12)
    
    # Add Bideford boundary
    folium.GeoJson(bideford.geometry.iloc[0], name='Bideford Boundary', style_function=lambda x: {'color': 'blue', 'weight': 3, 'fillOpacity': 0.1}).add_to(m)
    # Add buffer
    folium.GeoJson(bideford_buffer.iloc[0], name='5km Buffer', style_function=lambda x: {'color': 'cyan', 'weight': 2, 'fillOpacity': 0.05}).add_to(m)
    # Add buildings
    for _, row in buildings_within_5km.iterrows():
        folium.GeoJson(row.geometry, name=row.get('name', 'Building'), style_function=lambda x: {'color': 'red', 'weight': 2, 'fillOpacity': 0.3}).add_to(m)
        centroid = row.geometry.centroid
        folium.Marker([centroid.y, centroid.x], popup=row.get('name', 'Building')).add_to(m)
    
    # Save map
    map_filename = 'commercial_buildings_within_5km_of_bideford.html'
    m.save(map_filename)
    
    return [summary, map_filename, 'Folium map showing commercial buildings within 5 km of Bideford boundary, with summary of first 5 buildings.', map_filename]

