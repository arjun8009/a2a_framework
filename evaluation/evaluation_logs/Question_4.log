matplotlib.use('Agg')
def filter_torridge_named_area(data:list):
    import pandas as pd
    import geopandas as gpd
    # Assume the input is a list with one GeoDataFrame
    gdf = data[0]
    # Filter for rows where 'name' is exactly 'Torridge' and boundary is administrative or political
    filtered = gdf[
        (gdf['name'].str.lower() == 'torridge') &
        (gdf['boundary'].isin(['administrative', 'political']))
    ]
    summary = f"Filtered named areas for 'Torridge': {len(filtered)} entry(ies) found."
