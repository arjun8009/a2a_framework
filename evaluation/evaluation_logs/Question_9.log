2026-04-01 16:58:54,222 INFO Executing code import matplotlib
matplotlib.use('Agg')
def plot_homes_and_boundary(data: list):
    import folium
    import geopandas as gpd
    from shapely.geometry import mapping
    
    # Unpack data
    homes_gdf = data[0].copy()
    boundary_gdf = data[1].copy()
    
    # Ensure CRS is EPSG:4326 for folium
    if homes_gdf.crs is None or homes_gdf.crs.to_epsg() != 4326:
        homes_gdf = homes_gdf.to_crs(epsg=4326)
    if boundary_gdf.crs is None or boundary_gdf.crs.to_epsg() != 4326:
        boundary_gdf = boundary_gdf.to_crs(epsg=4326)
    
    # Get centroid of boundary for map centering
    centroid = boundary_gdf.geometry.centroid.iloc[0]
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=15)
    
    # Plot boundary
    folium.GeoJson(
        boundary_gdf,
        name='Boundary',
        style_function=lambda x: {'color': 'blue', 'weight': 3, 'fillOpacity': 0.05}
    ).add_to(m)
    
    # Plot homes
    folium.GeoJson(
        homes_gdf,
        name='Homes',
        style_function=lambda x: {'color': 'red', 'weight': 2, 'fillOpacity': 0.3},
        tooltip=folium.GeoJsonTooltip(fields=['id', 'addr:housename', 'building'])
    ).add_to(m)
    
    folium.LayerControl().add_to(m)
    
    # Save map
    map_filename = 'homes_and_boundary_map.html'
    m.save(map_filename)
    
    # Prepare summary
    summary_rows = homes_gdf[['id', 'addr:housename', 'building']].head(5)
    summary = f"Plotted {len(homes_gdf)} homes within the boundary of '{boundary_gdf.iloc[0]['name']}'. First 5 homes: {summary_rows.to_dict(orient='records')}"
    artifact_name = 'homes_and_boundary_map'
    artifact_description = 'A folium map showing homes from the buildings_homes_in_st_mary_area dataset overlaid with the boundary from filtered_down_st_mary_named_area.'
    return [summary, artifact_name, artifact_description, map_filename]

