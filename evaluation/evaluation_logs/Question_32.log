matplotlib.use('Agg')
def filter_hospital_locations_in_stokenham(data: list):
    import pandas as pd
    import geopandas as gpd
    
    gdf = data[0]
    # Filter for rows where any relevant column contains the word 'hospital' (case-insensitive)
    mask = (
        gdf['name'].str.contains('hospital', case=False, na=False) |
        gdf['amenity'].str.contains('hospital', case=False, na=False) |
        gdf['tags'].str.contains('hospital', case=False, na=False)
    )
    filtered_gdf = gdf[mask]
    summary = f"Filtered hospital locations: {len(filtered_gdf)} entries found."
    artifact_name = 'filtered_hospital_locations_in_stokenham'
    artifact_description = (
        "A GeoDataFrame containing only those entries from the original hospital_locations_in_stokenham "
        "where the word 'hospital' appears in the 'name', 'amenity', or 'tags' columns."
    )
    return [summary, artifact_name, artifact_description, filtered_gdf]

