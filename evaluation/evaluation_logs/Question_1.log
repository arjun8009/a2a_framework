def filter_valid_water_network_features(data: list):
    import geopandas as gpd
    import pandas as pd
    
    gdf = data[0]
    # Criteria for valid water network features:
    # - Non-null and non-empty 'name1_text' (main name)
    # - 'theme' must be 'Water'
    # - 'description' should be one of the expected types
    valid_descriptions = [
        'Named Canal',
        'Named Stretch Of Inland Water',
        'Named Watercourse'
    ]
    filtered = gdf[
        (gdf['theme'] == 'Water') &
        (gdf['name1_text'].notnull()) & (gdf['name1_text'].str.strip() != '') &
        (gdf['description'].isin(valid_descriptions))
    ].copy()
    
    summary = (
        f"Filtered valid water network features: {len(filtered)} out of {len(gdf)} entries. "
        f"Features include: {filtered['name1_text'].tolist()}"
    )
    artifact_name = 'filtered_waterlinkset_exeter'
    artifact_description = (
        "A GeoDataFrame containing only valid water network features from the Exeter dataset. "
        "Entries have non-null names, are themed 'Water', and have a valid description type."
    )
    return [summary, artifact_name, artifact_description, filtered]

