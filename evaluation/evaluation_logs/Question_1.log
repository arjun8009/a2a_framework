matplotlib.use('Agg')
def filter_and_summarize_water_network(data: list):
    import pandas as pd
    import geopandas as gpd
    df = data[0]
    # Remove spurious entities: filter out rows with missing or suspicious values in key columns
    # Criteria: Must have a valid name, description, geometry, and reasonable geometry_length
    filtered = df[
        df['name1_text'].notnull() &
        df['description'].notnull() &
        df['geometry'].notnull() &
        (df['geometry_length'] > 50)  # Remove very short features as likely spurious
    ].copy()
    # Summary statistics
    summary = {
        'total_features': len(df),
        'filtered_features': len(filtered),
        'feature_types': filtered['description'].value_counts().to_dict(),
        'names': filtered['name1_text'].unique().tolist(),
        'geometry_length_stats': filtered['geometry_length'].describe().to_dict()
    }
    # Save filtered data as new artifact
    return [
        f"Filtered water network features: {len(filtered)} out of {len(df)} retained. Feature types: {summary['feature_types']}",
        'filtered_waterlinkset_exeter',
        'Filtered GeoDataFrame of Exeter water network features with spurious entities removed. Includes only valid named water features with reasonable geometry length.',
        filtered
    ]
filter_and_summarize_water_network(data)
