matplotlib.use('Agg')
def filter_unique_structure_types(data: list):
    import pandas as pd
    gdf = data[0]
    # Identify unique types of structures using the 'description' column
    unique_types = gdf['description'].dropna().unique()
    # Filter the dataframe to only include one example of each unique type
    filtered_gdf = gdf.drop_duplicates(subset=['description'])
    summary = f"Identified {len(unique_types)} unique structure types: {', '.join(sorted(unique_types))}. Filtered results contain {len(filtered_gdf)} entries."
    artifact_name = 'filtered_exeter_structures'
    artifact_description = 'A GeoDataFrame containing one example of each unique structure type from the Exeter structures dataset, based on the description column.'
    return [summary, artifact_name, artifact_description, filtered_gdf]

