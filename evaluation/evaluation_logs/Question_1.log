2026-02-03 15:19:40,859 INFO Executing code import matplotlib
matplotlib.use('Agg')
def filter_and_summarize_water_network_features(data: list):
    import geopandas as gpd
    import pandas as pd
    df = data[0]
    # Remove spurious entities: keep only rows with valid name, description, geometry, and reasonable geometry length
    # Criteria: non-null geometry, non-null description, geometry_length_m > 0, and (if present) name1_text is not empty or null
    filtered = df[(df['geometry'].notnull()) &
                  (df['description'].notnull()) &
                  (df['geometry_length_m'] > 0)]
    # Optionally, keep only named features or those with meaningful description
    # Named features: name1_text not null/empty
    named = filtered[(filtered['name1_text'].notnull()) & (filtered['name1_text'].str.strip() != '')]
    # If there are named features, use them; else, use all filtered
    if len(named) > 0:
        filtered = named
    # Summary statistics
    summary = {
        'total_features': len(df),
        'filtered_features': len(filtered),
        'feature_types': filtered['description'].value_counts().to_dict(),
        'named_examples': filtered['name1_text'].dropna().unique().tolist()[:10],
        'geometry_length_min': filtered['geometry_length_m'].min(),
        'geometry_length_max': filtered['geometry_length_m'].max(),
        'geometry_length_mean': filtered['geometry_length_m'].mean(),
    }
    # Save filtered results
    filtered_gdf = gpd.GeoDataFrame(filtered, geometry='geometry', crs=df.crs)
    return [
        f"Filtered {len(filtered)} out of {len(df)} water network features. Feature types: {summary['feature_types']}. Example names: {summary['named_examples']}",
        'filtered_waterlink_exeter',
        'Filtered GeoDataFrame of Exeter water network features with spurious entities removed. Includes only valid named water features.',
        filtered_gdf
    ]
