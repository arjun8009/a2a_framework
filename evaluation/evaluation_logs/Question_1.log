2026-02-06 16:33:22,876 INFO Executing code import matplotlib
matplotlib.use('Agg')
def filter_exeter_area_polygon(data: list):
    gdf = data[0]
    # Filter for polygons where the name or description is related to Exeter
    # Use both 'name1_text' and 'description' columns for high quality filtering
    filtered = gdf[(gdf['name1_text'].str.contains('Exeter', case=False, na=False)) |
                   ((gdf['description'].str.contains('City', case=False, na=False)) &
                    (gdf['name1_text'].str.lower() == 'exeter'))]
    # If nothing found, try a broader filter for 'exeter' in any name or description
    if filtered.empty:
        filtered = gdf[(gdf['name1_text'].str.contains('exeter', case=False, na=False)) |
                       (gdf['description'].str.contains('exeter', case=False, na=False))]
    summary = f"Filtered polygons for Exeter. Number of matching polygons: {len(filtered)}."
    artifact_name = 'filtered_exeter_area_polygon'
    artifact_description = 'GeoDataFrame containing only the polygon(s) specifically for Exeter, filtered using both name and description columns.'
    return [summary, artifact_name, artifact_description, filtered]
