def filter_commercial_buildings_height_gt10_bovey_tracey(data: list):
    import pandas as pd
    import geopandas as gpd
    gdf = data[0]
    # Ensure 'height' is numeric, coerce errors to NaN
    gdf['height'] = pd.to_numeric(gdf['height'], errors='coerce')
    filtered_gdf = gdf[gdf['height'] > 10]
    summary = f"Filtered commercial buildings in Bovey Tracey with height > 10. Number of buildings: {len(filtered_gdf)}."
    artifact_name = 'commercial_buildings_height_gt10_bovey_tracey'
    artifact_description = 'GeoDataFrame of commercial buildings in Bovey Tracey where the height attribute is greater than 10.'
    return [summary, artifact_name, artifact_description, filtered_gdf]
