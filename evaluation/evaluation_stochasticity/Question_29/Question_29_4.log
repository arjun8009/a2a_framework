matplotlib.use('Agg')
def filter_exeter_area_polygon(data: list):
    gdf = data[0]
    # Filter for polygons where the name is 'Exeter' in any of the name columns and relevant description
    filtered = gdf[((gdf['name1_text'].str.lower() == 'exeter') |
                    (gdf['name2_text'].str.lower() == 'exeter') |
                    (gdf['name3_text'].str.lower() == 'exeter') |
                    (gdf['name4_text'].str.lower() == 'exeter')) &
                   (gdf['description'].str.lower().isin(['city', 'town', 'suburban area', 'part of settlement', 'village']))]
    summary = f"Filtered to {len(filtered)} polygon(s) for Exeter with settlement-related descriptions."
    artifact_name = 'filtered_exeter_area_polygon'
    artifact_description = 'GeoDataFrame containing only the polygon(s) for Exeter, filtered by name and settlement-related descriptions.'
    return [summary, artifact_name, artifact_description, filtered]

