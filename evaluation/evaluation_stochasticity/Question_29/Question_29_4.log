matplotlib.use('Agg')
def filter_buildings_with_green_roofs(data: list):
    gdf = data[0]
    # Filter for buildings with green roofs using both relevant columns
    filtered = gdf[(gdf['roofmaterial_primarymaterial'] == 'Green Roof') |
                   (gdf['roofmaterial_greenroofpresence'] == 'Present')]
    summary = f"Filtered buildings with green roofs in Exeter. Total: {len(filtered)}."
    artifact_name = 'buildings_with_green_roofs_in_exeter'
    artifact_description = (
        "A GeoDataFrame containing only those buildings in the filtered Exeter area "
        "that have green roofs, as indicated by either the primary roof material being 'Green Roof' "
        "or the green roof presence marked as 'Present'. All original columns are retained."
    )
    return [summary, artifact_name, artifact_description, filtered]

