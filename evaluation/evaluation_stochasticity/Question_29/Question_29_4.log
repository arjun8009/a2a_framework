matplotlib.use('Agg')
def plot_buildings_with_green_roofs_in_exeter(data: list):
    import folium
    import geopandas as gpd
    # Get the geodataframe
    gdf = data[0].copy()
    # Convert all columns with Timestamp to string for folium compatibility
    for col in gdf.columns:
        if gdf[col].dtype.name.startswith('datetime'):
            gdf[col] = gdf[col].astype(str)
    # Ensure CRS is EPSG:4326 for folium
    if gdf.crs is not None and gdf.crs.to_epsg() != 4326:
        gdf = gdf.to_crs(epsg=4326)
    # Center map on Exeter (approximate center from data)
    centroid = gdf.geometry.unary_union.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13, tiles='cartodbpositron')
    # Add all buildings as polygons
    folium.GeoJson(
        gdf,
        name='Buildings with Green Roofs',
        style_function=lambda x: {
            'fillColor': '#4CAF50',
            'color': '#388E3C',
            'weight': 1,
            'fillOpacity': 0.6
        },
        tooltip=folium.GeoJsonTooltip(fields=['description', 'buildinguse', 'geometry_area_m2', 'numberoffloors', 'height_relativeroofbase_m'],
                                      aliases=['Description', 'Building Use', 'Area (m2)', 'Floors', 'Height (m)'],
                                      localize=True)
    ).add_to(m)
    folium.LayerControl().add_to(m)
    # Save map
    map_filename = 'buildings_with_green_roofs_in_exeter_map.html'
    m.save(map_filename)
    # Prepare summary
    preview = gdf[['description', 'buildinguse', 'geometry_area_m2', 'numberoffloors', 'height_relativeroofbase_m']].head(5)
    summary = f"Plotted {len(gdf)} buildings with green roofs in Exeter. First 5 entries:\n{preview.to_string(index=False)}"
    return [summary, map_filename, 'Folium map showing all buildings with green roofs in Exeter, polygons colored green, with tooltips for description, use, area, floors, and height.', map_filename]

