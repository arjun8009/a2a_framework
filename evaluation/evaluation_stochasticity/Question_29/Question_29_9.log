matplotlib.use('Agg')
def filter_exeter_area_polygon(data: list):
    gdf = data[0]
    # Filter for polygons where the name1_text is 'Exeter' and descriptiongroup is likely to indicate a settlement/city
    filtered = gdf[(gdf['name1_text'].str.lower() == 'exeter') & \
                  (gdf['descriptiongroup'].isin(['Settlement', 'Land Name', 'Other Name'])) & \
                  (gdf['description'].str.lower().isin(['city', 'town', 'suburban area', 'part of settlement', 'village']))]
    # If nothing found, try a broader filter for 'Exeter' in name1_text
    if filtered.empty:
        filtered = gdf[gdf['name1_text'].str.lower() == 'exeter']
    summary = f"Filtered polygons for Exeter. Number of matching polygons: {len(filtered)}."
    artifact_name = 'filtered_exeter_area_polygon'
    artifact_description = 'GeoDataFrame containing only the polygon(s) for Exeter from the original exeter_area_polygon.'
    return [summary, artifact_name, artifact_description, filtered]

