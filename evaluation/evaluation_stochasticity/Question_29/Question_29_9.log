    # Filter for polygons where the name is 'Exeter' in any of the name columns and is a settlement/city/town
    mask = (
        (
            (gdf['name1_text'].str.lower() == 'exeter') |
            (gdf['name2_text'].str.lower() == 'exeter') |
            (gdf['name3_text'].str.lower() == 'exeter') |
            (gdf['name4_text'].str.lower() == 'exeter')
        ) &
        (
            (gdf['descriptiongroup'].str.lower().isin(['settlement'])) |
            (gdf['description'].str.lower().isin(['city', 'town', 'suburban area', 'part of settlement', 'village']))
        )
    )
    filtered = gdf[mask]
    summary = f"Filtered Exeter polygon(s): {len(filtered)} entries found."
    artifact_name = 'filtered_exeter_area_polygon'
    artifact_description = "Polygon(s) from exeter_area_polygon corresponding specifically to Exeter as a settlement/city/town."
    return [summary, artifact_name, artifact_description, filtered]

