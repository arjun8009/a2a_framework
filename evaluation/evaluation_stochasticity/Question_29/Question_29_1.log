matplotlib.use('Agg')
def filter_green_roof_buildings(data: list):
    gdf = data[0]
    # Look for columns that may indicate roof type or material
    # Since metadata does not show a direct 'roof' column, search for any column containing 'roof' or similar
    roof_columns = [col for col in gdf.columns if 'roof' in col.lower() or 'material' in col.lower() or 'cover' in col.lower()]
    # Try to filter for green roofs using any such columns
    # We'll check all possible columns for the presence of 'green' (case-insensitive)
    mask = None
    for col in roof_columns:
        if gdf[col].dtype == 'object':
            col_mask = gdf[col].str.contains('green', case=False, na=False)
            mask = col_mask if mask is None else (mask | col_mask)
    if mask is None:
        # No relevant column found, return empty filtered result
        filtered = gdf.iloc[0:0].copy()
    else:
        filtered = gdf[mask].copy()
    summary = f"Filtered buildings with green roofs. Number of entries: {len(filtered)}."
    artifact_name = 'exeter_green_roof_buildings'
    artifact_description = 'GeoDataFrame of buildings in Exeter identified as having green roofs, filtered using all relevant roof/material/cover columns.'
    return [summary, artifact_name, artifact_description, filtered]

