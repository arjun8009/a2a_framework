def filter_exeter_polygon(data: list):
    gdf = data[0]
    # Filter for Exeter using multiple relevant columns
    # We look for 'Exeter' in name1_text and also ensure it's a settlement/city/town
    filtered = gdf[((gdf['name1_text'].str.lower() == 'exeter') |
                    (gdf['name1_text'].str.lower().str.contains('exeter'))) &
                   (gdf['description'].isin(['City', 'Town', 'Suburban Area', 'Part Of Settlement', 'Village']))]
    summary = f"Filtered Exeter polygon(s): {len(filtered)} entries found."
    artifact_name = 'filtered_exeter_polygon'
    artifact_description = 'GeoDataFrame containing only the polygon(s) for Exeter, filtered by name and settlement-related description.'
    return [summary, artifact_name, artifact_description, filtered]

