matplotlib.use('Agg')
def plot_houses_built_before_1960_exeter(data: list):
    import folium
    import geopandas as gpd
    import pandas as pd
    
    gdf = data[0].copy()
    # Convert all columns with Timestamp to string for folium compatibility
    for col in gdf.columns:
        if pd.api.types.is_datetime64_any_dtype(gdf[col]):
            gdf[col] = gdf[col].astype(str)
    # Ensure CRS is EPSG:4326 for folium
    if gdf.crs is not None and gdf.crs.to_epsg() != 4326:
        gdf = gdf.to_crs(epsg=4326)
    
    # Center map on Exeter (approximate center from data)
    centroid = gdf.geometry.centroid.unary_union.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13, tiles='cartodbpositron')
    
    # Add polygons for houses
    folium.GeoJson(
        gdf,
        name='Houses built before 1960',
        tooltip=folium.GeoJsonTooltip(fields=['description', 'buildingage_period', 'buildinguse'],
                                       aliases=['Type', 'Age Period', 'Use'],
                                       localize=True)
    ).add_to(m)
    
    # Save map
    map_filename = 'houses_built_before_1960_exeter_map.html'
    m.save(map_filename)
    
    # Prepare summary
    preview = gdf[['description', 'buildingage_period', 'buildinguse']].head(5)
    summary = f"Plotted {len(gdf)} houses in Exeter built before 1960. First 5 entries:\n{preview.to_string(index=False)}"
    artifact_name = 'houses_built_before_1960_exeter_map'
    artifact_description = 'Folium map showing locations of houses in Exeter built before 1960.'
    return [summary, artifact_name, artifact_description, map_filename]

