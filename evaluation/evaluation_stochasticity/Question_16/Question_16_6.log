matplotlib.use('Agg')
def filter_houses_built_before_1960(data: list):
    import geopandas as gpd
    import pandas as pd
    # Unpack the input GeoDataFrame
    gdf = data[0]
    # Step 1: Filter for houses (residential, single address)
    houses = gdf[(gdf['buildinguse_addresscount_residential'] > 0) & (gdf['buildinguse_addresscount_total'] == 1)]
    # Step 2: Filter for buildings built before 1960 using buildingage_period
    # Acceptable periods: those ending in or before 1960
    # From metadata, possible values: 'Pre-1919', '1919-1944', '1945-1959', 'Pre-1837', '1837-1869', '1870-1918'
    period_ok = [
        'Pre-1919', '1919-1944', '1945-1959', 'Pre-1837', '1837-1869', '1870-1918'
    ]
    houses_pre1960 = houses[houses['buildingage_period'].isin(period_ok)]
    # Save to geojson
    houses_pre1960.to_file('houses_built_before_1960_in_filtered_exeter.geojson', driver='GeoJSON')
    summary = f"Filtered {len(houses_pre1960)} houses built before 1960 in Exeter."
    artifact_name = 'houses_built_before_1960_in_filtered_exeter.geojson'
    artifact_description = "GeoDataFrame of houses (single residential address) in filtered Exeter dataset, built before 1960, as determined by buildingage_period."
    return [summary, artifact_name, artifact_description, houses_pre1960]

