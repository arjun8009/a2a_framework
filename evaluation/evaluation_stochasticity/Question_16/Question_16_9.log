matplotlib.use('Agg')
def plot_houses_exeter_before1960(data: list):
    import geopandas as gpd
    import folium
    import pandas as pd
    
    # Unpack data
    houses_gdf = data[0]
    exeter_boundary_gdf = data[1]
    
    # Ensure CRS is EPSG:4326 for folium
    houses_gdf = houses_gdf.to_crs(epsg=4326)
    exeter_boundary_gdf = exeter_boundary_gdf.to_crs(epsg=4326)
    
    # Filter for houses only (description column)
    house_types = [
        'End-Of-Terrace House', 'Mid-Terrace House', 'Semi-Detached House',
        'Detached House', 'Residential Building', 'Terraced House', 'House'
    ]
    houses_only = houses_gdf[
        (houses_gdf['description'].isin(house_types)) &
        (houses_gdf['buildinguse_oslandusetiera'] == 'Residential Accommodation')
    ]
    
    # Clip houses to Exeter boundary (just in case)
    houses_in_exeter = gpd.overlay(houses_only, exeter_boundary_gdf, how='intersection')
    
    # Remove non-serializable columns (like Timestamp) for folium
    def make_serializable(df):
        for col in df.columns:
            if isinstance(df[col].iloc[0], pd.Timestamp):
                df[col] = df[col].astype(str)
        return df
    houses_in_exeter = make_serializable(houses_in_exeter)
    
    # Use correct column names after overlay (they get _1 suffix)
    tooltip_fields = ['description_1', 'buildingage_period', 'constructionmaterial']
    
    # Create folium map centered on Exeter
    exeter_centroid = exeter_boundary_gdf.geometry.centroid.iloc[0]
    m = folium.Map(location=[exeter_centroid.y, exeter_centroid.x], zoom_start=13)
    
    # Add Exeter boundary
    folium.GeoJson(
        exeter_boundary_gdf.geometry.iloc[0],
        name='Exeter Boundary',
        style_function=lambda x: {'color': 'blue', 'weight': 3, 'fillOpacity': 0.05}
    ).add_to(m)
    
    # Add houses
    folium.GeoJson(
        houses_in_exeter,
        name='Houses before 1960',
        style_function=lambda x: {'color': 'red', 'weight': 1, 'fillOpacity': 0.4},
        tooltip=folium.GeoJsonTooltip(fields=tooltip_fields)
    ).add_to(m)
    
    m.save('houses_exeter_before1960_map.html')
    
    # Prepare summary
    summary = f"Plotted {len(houses_in_exeter)} houses in Exeter built before 1960. First 5: "
    summary += str(houses_in_exeter[tooltip_fields].head(5).to_dict('records'))
    
    return [
        summary,
        'houses_exeter_before1960_map.html',
        'A folium map showing houses in Exeter built before 1960, with the Exeter city boundary overlaid.',
        'houses_exeter_before1960_map.html'
    ]

