2026-03-04 12:54:12,847 INFO Executing code import matplotlib
matplotlib.use('Agg')
def filter_exeter_polygon(data: list):
    gdf = data[0]
    # Filter for Exeter using multiple relevant columns for high search quality
    # Check for 'Exeter' in name1_text and ensure it's a settlement/city/town
    mask = (
        (gdf['name1_text'].str.lower() == 'exeter') &
        (gdf['descriptiongroup'].isin(['Settlement'])) &
        (gdf['description'].isin(['City', 'Town']))
    )
    filtered = gdf[mask]
    summary = f"Filtered Exeter polygon: {len(filtered)} entries found."
    artifact_name = 'filtered_exeter_polygon_data'
    artifact_description = 'Polygon(s) representing Exeter, filtered by name and settlement type.'
    return [summary, artifact_name, artifact_description, filtered]

