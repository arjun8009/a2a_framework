 houses in Exeter built before 1960. First 5: "\n    summary += str(houses_in_exeter[[\'description\', \'buildingage_period\', \'constructionmaterial\']].head(5).to_dict(\'records\'))\n    \n    return [\n        summary,\n        \'houses_exeter_before1960_map.html\',\n        \'A folium map showing houses in Exeter built before 1960, with the Exeter city boundary overlaid.\',\n        \'houses_exeter_before1960_map.html\'\n    ]\n', 'artifact_names': ['houses_exeter_before1960.parquet', 'filtered_exeter_polygon_data']}
