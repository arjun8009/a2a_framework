matplotlib.use('Agg')
def filter_houses_exeter_before1960(data: list):
    import geopandas as gpd
    df = data[0]
    # Filter for houses: residential > 0 and total = 1
    houses = df[(df['buildinguse_addresscount_residential'] > 0) & (df['buildinguse_addresscount_total'] == 1)]
    # Filter for buildings constructed before 1960 using buildingage_period
    # Acceptable periods: 'Pre-1837', '1837-1869', '1870-1918', '1919-1944', 'Pre-1919', '1945-1959'
    periods_before_1960 = ['Pre-1837', '1837-1869', '1870-1918', '1919-1944', 'Pre-1919', '1945-1959']
    houses_before1960 = houses[houses['buildingage_period'].isin(periods_before_1960)]
    summary = f"Filtered houses in Exeter built before 1960: {len(houses_before1960)} entries."
    artifact_name = 'houses_exeter_before1960.parquet'
    artifact_description = 'GeoDataFrame of houses in Exeter (single residential address, built before 1960, as determined by buildingage_period).' 
    return [summary, artifact_name, artifact_description, houses_before1960]

