matplotlib.use('Agg')
def plot_houses_exeter_before1960(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import mapping
    from folium import GeoJson
    
    # Unpack data
    houses_gdf = data[0]
    exeter_boundary_gdf = data[1]
    
    # Ensure CRS is EPSG:4326 for folium
    houses_gdf = houses_gdf.to_crs(epsg=4326)
    exeter_boundary_gdf = exeter_boundary_gdf.to_crs(epsg=4326)
    
    # Filter for houses only (description column)
    house_types = [
        'End-Of-Terrace House', 'Mid-Terrace House', 'Semi-Detached House',
        'Detached House', 'Residential Building', 'Terraced House', 'House'
    ]
    houses_only = houses_gdf[
        (houses_gdf['description'].isin(house_types)) &
