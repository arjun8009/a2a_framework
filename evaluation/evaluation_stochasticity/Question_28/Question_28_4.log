def plot_hard_to_heat_houses_exeter(data: list):
    import folium
    import geopandas as gpd
    import pandas as pd
    # Get the geodataframe
    gdf = data[0]
    # Convert all datetime columns to string to avoid serialization issues
    for col in gdf.columns:
        if pd.api.types.is_datetime64_any_dtype(gdf[col]):
            gdf[col] = gdf[col].astype(str)
    # Ensure CRS is EPSG:4326 for folium
    if gdf.crs is not None and gdf.crs.to_string() != 'EPSG:4326':
        gdf = gdf.to_crs(epsg=4326)
    # Get centroid for map initialization
    centroid = gdf.geometry.unary_union.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13, tiles='cartodbpositron')
    # Add polygons to map
    folium.GeoJson(
        gdf,
        name='Hard to Heat Houses',
        style_function=lambda x: {
            'fillColor': '#ff7800',
            'color': '#ff7800',
            'weight': 0.5,
            'fillOpacity': 0.4
        },
        tooltip=folium.GeoJsonTooltip(fields=['description', 'buildingage_period', 'constructionmaterial', 'geometry_area_m2'],
                                        aliases=['Type', 'Age Period', 'Material', 'Area (m2)'],
                                        localize=True)
    ).add_to(m)
    folium.LayerControl().add_to(m)
    # Save map
    map_filename = 'hard_to_heat_houses_exeter_map.html'
    m.save(map_filename)
    # Prepare summary
    preview = gdf[['description', 'buildingage_period', 'constructionmaterial', 'geometry_area_m2']].head(5)
    summary = f"Visualized {len(gdf)} houses in Exeter likely hard to heat. First 5 entries:\n{preview.to_string(index=False)}"
    artifact_name = 'hard_to_heat_houses_exeter_map.html'
    artifact_description = 'Folium map showing the distribution of houses in Exeter that are likely hard to heat, colored polygons with tooltips for type, age, material, and area.'
    return [summary, artifact_name, artifact_description, map_filename]

