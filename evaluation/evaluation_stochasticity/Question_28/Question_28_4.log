2026-03-04 13:20:57,511 INFO Executing code import matplotlib
matplotlib.use('Agg')
def filter_hard_to_heat_houses_exeter(data: list):
    import geopandas as gpd
    import numpy as np
    # Step 1: Identify houses
    gdf = data[0]
    houses = gdf[(gdf['buildinguse_addresscount_residential'] > 0) & (gdf['buildinguse_addresscount_total'] == 1)]

    # Step 2: Filter for hard-to-heat (older buildings)
    # Use 'buildingage_period' for pre-1999, 'buildingage_year' for post-1999
    # Pre-1999 periods (from metadata): 'Pre-1837', '1837-1869', '1870-1918', '1919-1944', '1945-1959', '1960-1979', '1980-1989', '1990-1999'
    pre_1999_periods = [
        'Pre-1837', '1837-1869', '1870-1918', '1919-1944', '1945-1959', '1960-1979', '1980-1989', '1990-1999'
    ]
    # Houses built before 1999
    old_houses = houses[houses['buildingage_period'].isin(pre_1999_periods)]
    # Houses built after 1999 (year >= 2000)
    recent_houses = houses[(houses['buildingage_year'].notnull()) & (houses['buildingage_year'] < 1999)]
    # Combine
    hard_to_heat = old_houses.copy()
    # If there are any attributes for insulation or energy performance, filter further (not present in metadata)
    # Save to geojson
    hard_to_heat.to_file('hard_to_heat_houses_exeter.geojson', driver='GeoJSON')
    summary = f"Filtered {len(hard_to_heat)} hard-to-heat houses in Exeter (pre-1999 construction)."
    return [summary, 'hard_to_heat_houses_exeter.geojson', 'GeoDataFrame of houses in Exeter likely to be hard to heat, filtered by age (pre-1999).', hard_to_heat]

