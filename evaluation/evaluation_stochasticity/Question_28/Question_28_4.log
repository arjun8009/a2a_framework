matplotlib.use('Agg')
def filter_hard_to_heat_houses_exeter(data: list):
    import geopandas as gpd
    import numpy as np
    # Load the GeoDataFrame
    gdf = data[0]
    # Step 1: Identify houses
    houses = gdf[(gdf['buildinguse_addresscount_residential'] > 0) & (gdf['buildinguse_addresscount_total'] == 1)]
    # Step 2: Filter for likely hard-to-heat houses
    # Pre-1999: use buildingage_period
    pre_1999_periods = [
        'Pre-1837', '1837-1869', '1870-1918', '1919-1944', '1945-1959', '1960-1979', '1980-1989', '1990-1999'
    ]
    pre_1999 = houses[houses['buildingage_period'].isin(pre_1999_periods)]
    # Post-1999: use buildingage_year
    post_1999 = houses[(houses['buildingage_year'] > 1999)]
    # Combine
    hard_to_heat = pre_1999.copy()
    # If there are insulation or energy performance columns, filter further
    insulation_cols = [col for col in houses.columns if 'insulat' in col.lower() or 'energy' in col.lower() or 'epc' in col.lower()]
    if insulation_cols:
        # Try to find poor insulation or low energy performance
        for col in insulation_cols:
            # For demonstration, filter for known poor/low values if present
            if houses[col].dtype == object:
                # Look for keywords indicating poor performance
                mask = houses[col].str.contains('poor|low|none|single', case=False, na=False)
                hard_to_heat = hard_to_heat.append(houses[mask & (houses['buildingage_period'].isin(pre_1999_periods) | (houses['buildingage_year'] > 1999))])
            elif np.issubdtype(houses[col].dtype, np.number):
                # For numeric, assume lower is worse (e.g., EPC rating)
                threshold = houses[col].quantile(0.25)  # bottom quartile
                mask = houses[col] <= threshold
                hard_to_heat = hard_to_heat.append(houses[mask & (houses['buildingage_period'].isin(pre_1999_periods) | (houses['buildingage_year'] > 1999))])
    else:
        # If no insulation/energy columns, add post-1999 as well
        hard_to_heat = hard_to_heat.append(post_1999)
    # Remove duplicates
    hard_to_heat = hard_to_heat.drop_duplicates(subset='osid')
    # Save to geojson
    hard_to_heat.to_file('hard_to_heat_houses_exeter.geojson', driver='GeoJSON')
    summary = f"Filtered {len(hard_to_heat)} likely hard-to-heat houses in Exeter."
    return [summary, 'hard_to_heat_houses_exeter.geojson', 'GeoDataFrame of houses in Exeter likely to be hard to heat, prioritizing older buildings and considering insulation/energy performance if available.', hard_to_heat]

