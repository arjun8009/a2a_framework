matplotlib.use('Agg')
def filter_hard_to_heat_houses_exeter(data):
    import geopandas as gpd
    import numpy as np
    gdf = data[0]
    # Step 1: Identify houses (residential, single address)
    houses = gdf[(gdf['buildinguse_addresscount_residential'] > 0) & (gdf['buildinguse_addresscount_total'] == 1)]
    # Step 2: Prioritize older buildings (hard to heat)
    pre_1999_periods = [
        'Pre-1837', '1837-1869', '1870-1918', '1919-1944', '1945-1959', '1960-1979', '1980-1989', '1990-1999'
    ]
    mask_pre_1999 = houses['buildingage_period'].isin(pre_1999_periods)
    mask_year = (houses['buildingage_year'].notnull()) & (houses['buildingage_year'] < 1999)
    hard_to_heat = houses[mask_pre_1999 | mask_year]
    # Step 3: If available, consider poor insulation/energy performance
    insulation_cols = [col for col in houses.columns if 'insulat' in col.lower() or 'energy' in col.lower() or 'epc' in col.lower()]
    if insulation_cols:
        for col in insulation_cols:
            if houses[col].dtype == object:
                poor_vals = ['poor', 'low', 'bad', 'inefficient', 'g', 'f', 'e']
                mask_poor = houses[col].astype(str).str.lower().str.contains('|'.join(poor_vals))
                hard_to_heat = hard_to_heat[mask_poor | ~hard_to_heat[col].notnull()]
            elif np.issubdtype(houses[col].dtype, np.number):
                threshold = houses[col].quantile(0.25)
                mask_poor = houses[col] <= threshold
                hard_to_heat = hard_to_heat[mask_poor | ~hard_to_heat[col].notnull()]
    hard_to_heat = hard_to_heat.copy()
    hard_to_heat.reset_index(drop=True, inplace=True)
    hard_to_heat.to_file('hard_to_heat_houses_exeter.geojson', driver='GeoJSON')
    summary = f"Filtered {len(hard_to_heat)} hard-to-heat houses in Exeter area."
    artifact_name = 'hard_to_heat_houses_exeter.geojson'
    artifact_description = "GeoDataFrame of houses in Exeter likely to be hard to heat, prioritizing older buildings and, if available, those with poor insulation or low energy performance."
    return [summary, artifact_name, artifact_description, hard_to_heat]

