matplotlib.use('Agg')
def plot_hard_to_heat_houses_exeter(data: list):
    import folium
    import geopandas as gpd
    import pandas as pd
    # Get the geodataframe
    gdf = data[0].copy()
    # Convert all datetime columns to string for folium compatibility
    for col in gdf.columns:
        if pd.api.types.is_datetime64_any_dtype(gdf[col]):
            gdf[col] = gdf[col].astype(str)
    # Ensure CRS is EPSG:4326 for folium
    if gdf.crs is not None and gdf.crs.to_epsg() != 4326:
        gdf = gdf.to_crs(epsg=4326)
    # Create a folium map centered on the mean location
    centroid = gdf.geometry.centroid.unary_union.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13, tiles='cartodbpositron')
    # Add polygons to the map
    folium.GeoJson(
        gdf,
        name='Hard to Heat Houses',
        style_function=lambda x: {
            'fillColor': '#ff7800',
            'color': '#ff7800',
            'weight': 1,
            'fillOpacity': 0.5
        },
        tooltip=folium.GeoJsonTooltip(fields=['description', 'buildingage_period', 'constructionmaterial', 'roofmaterial_solarpanelpresence', 'roofmaterial_greenroofpresence'])
    ).add_to(m)
    # Save map
    map_filename = 'hard_to_heat_houses_exeter_map.html'
    m.save(map_filename)
    # Prepare summary
    summary = (
        f"Visualized {len(gdf)} houses in Exeter likely hard to heat. "
        "Criteria: Pre-2000 construction (see 'buildingage_period'), likely poorly insulated materials (see 'constructionmaterial'), "
        "no solar panels ('roofmaterial_solarpanelpresence' == 'Not Present'), and no green roof ('roofmaterial_greenroofpresence' == 'Not Present').\n"
        f"First 5 entries:\n"
        f"{gdf[['description', 'buildingage_period', 'constructionmaterial', 'roofmaterial_solarpanelpresence', 'roofmaterial_greenroofpresence']].head(5).to_string(index=False)}"
    )
    return [summary, map_filename, 'Folium map visualizing the distribution of houses in Exeter likely hard to heat, based on pre-2000 construction, poor insulation, no solar panels, and no green roof.', map_filename]

