matplotlib.use('Agg')
def filter_hard_to_heat_houses_exeter_area(data):
    import pandas as pd
    import numpy as np
    gdf = data[0]
    # Step 1: Filter for houses (residential, single address)
    houses = gdf[(gdf['buildinguse_addresscount_residential'] > 0) & (gdf['buildinguse_addresscount_total'] == 1)]
    # Step 2: Identify hard to heat houses
    # Criteria:
    # - Older construction: buildingage_period in ['Pre-1919', '1919-1944', '1945-1959', '1960-1979', '1980-1989', '1990-1999']
    #   (pre-1999, as post-1999 is considered better insulated)
    # - If buildingage_year is present and < 2000, also consider as old
    # - Construction material: 'Brick Or Block Or Stone', 'Timber Or Wood', 'Other Non-Standard Or System Build', 'Unknown'
    #   (these are more likely to be poorly insulated)
    # - No solar panels (roofmaterial_solarpanelpresence == 'Not Present')
    # - No green roof (roofmaterial_greenroofpresence == 'Not Present')
    #
    # Build mask for hard to heat
    period_hard = [
        'Pre-1919', '1919-1944', '1945-1959', '1960-1979', '1980-1989', '1990-1999'
    ]
    material_hard = [
        'Brick Or Block Or Stone', 'Timber Or Wood', 'Other Non-Standard Or System Build', 'Unknown'
    ]
    mask_period = houses['buildingage_period'].isin(period_hard)
    mask_year = (houses['buildingage_year'] < 2000)
    mask_year = mask_year.fillna(False)
    mask_material = houses['constructionmaterial'].isin(material_hard)
    mask_material = mask_material.fillna(True)  # If unknown, treat as hard to heat
    mask_solar = (houses['roofmaterial_solarpanelpresence'] == 'Not Present') | (houses['roofmaterial_solarpanelpresence'].isna())
    mask_greenroof = (houses['roofmaterial_greenroofpresence'] == 'Not Present') | (houses['roofmaterial_greenroofpresence'].isna())
    # Combine masks: must be old (period or year), AND poor material, AND no solar, AND no green roof
    hard_to_heat = houses[(mask_material) & (mask_solar) & (mask_greenroof) & ((mask_period) | (mask_year))]
    summary = f"Filtered {len(houses)} houses; identified {len(hard_to_heat)} likely hard-to-heat houses in Exeter area."
    artifact_name = 'hard_to_heat_houses_exeter_area'
    artifact_description = (
        "GeoDataFrame of houses (single residential address buildings) in Exeter area that are likely hard to heat. "
        "Criteria: pre-2000 construction (by period or year), construction material likely to be poorly insulated, "
        "no solar panels, and no green roof. Includes geometry and all available attributes."
    )
    return [summary, artifact_name, artifact_description, hard_to_heat]

output = filter_hard_to_heat_houses_exeter_area(data)

