matplotlib.use('Agg')
def filter_exeter_polygon(data: list):
    gdf = data[0]
    # Filter for polygons specifically representing Exeter
    # Use name1_text for 'Exeter', and also check for relevant descriptiongroup/description
    filtered = gdf[
        (gdf['name1_text'].str.lower() == 'exeter') &
        (
            (gdf['descriptiongroup'].str.lower().isin(['settlement', 'other name', 'land name'])) |
            (gdf['description'].str.lower().isin(['city', 'town', 'suburban area', 'part of settlement', 'village']))
        )
    ]
    summary = f"Filtered polygons for Exeter. Number of entries: {len(filtered)}."
    artifact_name = 'filtered_exeter_polygon_data'
    artifact_description = 'GeoDataFrame containing only the polygon(s) specifically representing Exeter, filtered by name and relevant description.'
    return [summary, artifact_name, artifact_description, filtered]

