matplotlib.use('Agg')
def plot_hard_to_heat_houses_distribution(data: list):
    import geopandas as gpd
    import folium
    from folium.plugins import MarkerCluster
    import matplotlib
    import matplotlib.cm as cm
    import matplotlib.colors as colors
    import numpy as np
    
    gdf = data[0].copy()
    # Ensure CRS is EPSG:4326 for folium
    if gdf.crs is not None and gdf.crs.to_epsg() != 4326:
        gdf = gdf.to_crs(epsg=4326)
    
    # Color by building type (description)
    building_types = gdf['description'].unique()
    color_map = cm.get_cmap('tab20', len(building_types))
    color_dict = {bt: matplotlib.colors.rgb2hex(color_map(i)) for i, bt in enumerate(building_types)}
    
    # Center map on Exeter (approximate center from data)
    centroid = gdf.geometry.centroid.unary_union.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13, tiles='cartodbpositron')
    
    # Add polygons colored by building type
    for bt in building_types:
        sub_gdf = gdf[gdf['description'] == bt]
        folium.GeoJson(
            sub_gdf,
            name=bt,
            style_function=lambda feature, color=color_dict[bt]: {
                'fillColor': color,
                'color': color,
                'weight': 0.5,
                'fillOpacity': 0.5
            },
            tooltip=folium.GeoJsonTooltip(fields=['description', 'buildingage_period', 'constructionmaterial', 'numberoffloors'],
                                           aliases=['Type', 'Age Period', 'Material', 'Floors'])
        ).add_to(m)
    
    folium.LayerControl().add_to(m)
    
    # Save map
    map_filename = 'hard_to_heat_houses_exeter_map.html'
    m.save(map_filename)
    
    # Prepare summary
    summary = f"Plotted {len(gdf)} houses likely hard to heat in Exeter. First 5 entries:\n" + \
              str(gdf[['description', 'buildingage_period', 'constructionmaterial', 'numberoffloors']].head(5))
    artifact_name = 'hard_to_heat_houses_exeter_map'
    artifact_description = 'Folium map showing the distribution of houses in Exeter likely hard to heat, colored by building type.'
    return [summary, artifact_name, artifact_description, map_filename]

