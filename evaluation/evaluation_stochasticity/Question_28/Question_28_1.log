2026-03-04 13:01:48,826 INFO Executing code import matplotlib
matplotlib.use('Agg')
def filter_exeter_area_polygon(data: list):
    gdf = data[0]
    # Filter for polygons where the main name is 'Exeter' and description is 'City' or 'Settlement' or 'Part Of Settlement' or 'Suburban Area' or 'Town'
    filtered = gdf[(gdf['name1_text'].str.lower() == 'exeter') &
                   (gdf['description'].isin(['City', 'Settlement', 'Part Of Settlement', 'Suburban Area', 'Town']))]
    summary = f"Filtered to {len(filtered)} polygon(s) for Exeter with relevant settlement descriptions."
    artifact_name = 'filtered_exeter_area_polygon'
    artifact_description = "GeoDataFrame containing only the polygon(s) for Exeter, filtered by name and relevant settlement-type descriptions."
    return [summary, artifact_name, artifact_description, filtered]

