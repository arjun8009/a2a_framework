matplotlib.use('Agg')
def identify_hard_to_heat_houses_exeter_area(data: list):
    import pandas as pd
    import geopandas as gpd
    # Extract the dataframe
    gdf = data[0]
    
    # Step 1: Identify houses (single residential address)
    houses = gdf[(gdf['buildinguse_addresscount_residential'] > 0) & (gdf['buildinguse_addresscount_total'] == 1)]
    
    # Step 2: Hard to heat criteria
    # a) Built before 1999 using 'buildingage_period'
    pre_1999_periods = [
        'Pre-1837', '1837-1869', '1870-1918', '1919-1944', '1945-1959',
        '1960-1979', '1980-1989', '1990-1999', 'Pre-1919'
    ]
    # b) Built after 1999 but before 2000 using 'buildingage_year'
    mask_period = houses['buildingage_period'].isin(pre_1999_periods)
    mask_year = (houses['buildingage_period'].isin(['2000-2009', '2010-2019', '2020-2029']) & (houses['buildingage_year'] < 2000))
    
    # Combine both masks
    hard_to_heat = houses[mask_period | mask_year]
    
    # Step 3: If available, consider construction type/material for poor thermal efficiency
    # Typical poor insulation: 'Brick Or Block Or Stone', 'Timber Or Wood', 'Other Non-Standard Or System Build', 'Unknown', 'Mixed (Plaster And Timber)', 'Mixed (Masonry And Timber)'
    poor_materials = [
        'Brick Or Block Or Stone', 'Timber Or Wood', 'Other Non-Standard Or System Build',
        'Unknown', 'Mixed (Plaster And Timber)', 'Mixed (Masonry And Timber)'
    ]
    # If constructionmaterial is available, further filter
    if 'constructionmaterial' in hard_to_heat.columns:
        mask_material = hard_to_heat['constructionmaterial'].isin(poor_materials)
        # Allow missing values (assume poor if unknown)
        mask_material = mask_material | hard_to_heat['constructionmaterial'].isna()
        hard_to_heat = hard_to_heat[mask_material]
    
    # Save result
    artifact_name = 'hard_to_heat_houses_exeter_area'
    artifact_description = (
        "GeoDataFrame of houses in Exeter area likely to be hard to heat. "
        "Criteria: (1) Single residential address (buildinguse_addresscount_residential > 0 and buildinguse_addresscount_total = 1); "
        "(2) Built before 1999 (buildingage_period) or, if built after 1999, buildingage_year < 2000; "
        "(3) Construction material is typical of poor insulation or unknown. "
        f"Total identified: {len(hard_to_heat)}."
    )
    summary = (
        f"Identified {len(hard_to_heat)} houses likely to be hard to heat in Exeter area. "
        "Criteria: single residential address, built before 1999 (or year < 2000), and poor/unknown construction material."
    )
    return [summary, artifact_name, artifact_description, hard_to_heat]

