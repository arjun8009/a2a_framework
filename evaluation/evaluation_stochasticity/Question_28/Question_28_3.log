matplotlib.use('Agg')
def extract_houses_in_filtered_exeter_area(data: list):
    gdf = data[0]
    # Filter for houses: residential address count > 0 and total address count == 1
    houses = gdf[(gdf['buildinguse_addresscount_residential'] > 0) & (gdf['buildinguse_addresscount_total'] == 1)]
    summary = f"Filtered houses in Exeter area: {len(houses)} entries out of {len(gdf)} total buildings."
    artifact_name = 'houses_in_filtered_exeter_area'
    artifact_description = (
        "A GeoDataFrame containing only houses in the filtered Exeter area, "
        "where 'buildinguse_addresscount_residential' > 0 and 'buildinguse_addresscount_total' == 1. "
        "All original columns are retained."
    )
    return [summary, artifact_name, artifact_description, houses]

