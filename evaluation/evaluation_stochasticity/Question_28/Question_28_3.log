matplotlib.use('Agg')
def filter_hard_to_heat_houses_in_exeter_area(data: list):
    import pandas as pd
    import geopandas as gpd
    df = data[0]
    # 1. Age: Pre-1945 (using buildingage_period for pre-1999, buildingage_year for post-1999)
    pre_1945_periods = ['Pre-1837', '1837-1869', '1870-1918', '1919-1944', 'Pre-1919']
    mask_period = df['buildingage_period'].isin(pre_1945_periods)
    mask_year = (df['buildingage_year'].notnull()) & (df['buildingage_year'] < 1945)
    mask_age = mask_period | mask_year

    # 2. Construction type: solid walls or single glazing (if available)
    solid_wall_types = [
        'Brick Or Block Or Stone',
        'Mixed (Masonry And Timber)',
        'Mixed (Masonry And Metal)',
        'Other Non-Standard Or System Build',
        'Unknown'  # treat unknown as potentially hard to heat
    ]
    mask_material = df['constructionmaterial'].isin(solid_wall_types)

    # 3. Any other indicators: basement presence (if present, may be harder to heat)
    mask_basement = df['basementpresence'].isin(['Present', 'Unknown'])

    # Combine all criteria: must be old AND (solid wall OR basement present/unknown)
    mask = mask_age & (mask_material | mask_basement)
    filtered = df[mask].copy()
    summary = f"Filtered hard-to-heat houses: {len(filtered)} out of {len(df)} total houses. Criteria: pre-1945 age and (solid wall or basement present/unknown)."
    artifact_name = 'hard_to_heat_houses_in_exeter_area'
    artifact_description = (
        "A GeoDataFrame of houses in Exeter area likely hard to heat: built before 1945 (by 'buildingage_period' or 'buildingage_year'), "
        "and either solid wall construction (by 'constructionmaterial') or basement present/unknown (by 'basementpresence'). All columns retained."
    )
    return [summary, artifact_name, artifact_description, filtered]

