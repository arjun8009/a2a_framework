matplotlib.use('Agg')
def filter_exeter_area_polygon(data: list):
    gdf = data[0]
    # Filter for polygons where the main name is 'Exeter' and the description is 'City' or 'Settlement' or 'Town'
    filtered = gdf[(gdf['name1_text'].str.lower() == 'exeter') & 
                   (gdf['description'].str.lower().isin(['city', 'settlement', 'town']))]
    summary = f"Filtered to {len(filtered)} polygon(s) for Exeter with description as City, Settlement, or Town."
    return [summary, 'filtered_exeter_area_polygon', 'GeoDataFrame containing only the polygon(s) for Exeter (city/settlement/town).', filtered]

