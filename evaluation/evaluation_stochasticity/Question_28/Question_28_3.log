def plot_hard_to_heat_houses_distribution(data: list):
    import geopandas as gpd
    import folium
    from folium.plugins import MarkerCluster
    import os
    
    gdf = data[0].copy()
    # Ensure CRS is EPSG:4326 for folium
    if gdf.crs is not None and gdf.crs.to_string() != 'EPSG:4326':
        gdf = gdf.to_crs(epsg=4326)
    
    # Create folium map centered on Exeter
    centroid = gdf.geometry.centroid.unary_union.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13, tiles='cartodbpositron')
    
    # Add polygons for hard to heat houses
    folium.GeoJson(
        gdf,
        name='Hard to Heat Houses',
        style_function=lambda x: {
            'fillColor': '#ff7800',
            'color': '#ff7800',
            'weight': 1,
            'fillOpacity': 0.5
        },
        tooltip=folium.GeoJsonTooltip(fields=['description', 'buildingage_period', 'constructionmaterial', 'geometry_area_m2'])
    ).add_to(m)
    
    folium.LayerControl().add_to(m)
    
    # Save map
    map_filename = 'hard_to_heat_houses_exeter_map.html'
    m.save(map_filename)
    
    # Prepare summary
    n_houses = len(gdf)
    desc_counts = gdf['description'].value_counts().to_dict()
    age_counts = gdf['buildingage_period'].value_counts().to_dict()
    material_counts = gdf['constructionmaterial'].value_counts().to_dict()
    
    summary = (
        f"There are {n_houses} houses in Exeter identified as likely hard to heat. "
        f"Most common house types: {list(desc_counts.items())[:3]}. "
        f"Most common construction periods: {list(age_counts.items())[:3]}. "
        f"Most common construction materials: {list(material_counts.items())[:3]}.\n"
        f"First 5 houses:\n"
        f"{gdf[['description', 'buildingage_period', 'constructionmaterial', 'geometry_area_m2']].head(5).to_string(index=False)}"
    )
    
    return [
        summary,
        'hard_to_heat_houses_exeter_map',
        'A folium map showing the spatial distribution of houses in Exeter that are likely hard to heat, colored orange. Includes tooltips for house type, age period, construction material, and area.',
        map_filename
    ]

