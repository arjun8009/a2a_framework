matplotlib.use('Agg')
def filter_hard_to_heat_houses_exeter(data: list):
    import geopandas as gpd
    import numpy as np
    
    gdf = data[0]
    # 1. Definition of a house: residential > 0 and total = 1
    houses = gdf[(gdf['buildinguse_addresscount_residential'] > 0) & (gdf['buildinguse_addresscount_total'] == 1)]
    
    # 2. Detached houses: Use 'description' and 'connectivity'
    detached_mask = (
        houses['description'].str.contains('Detached', case=False, na=False) |
        (houses['connectivity'].str.lower() == 'standalone')
    )
    houses = houses[detached_mask]
    
    # 3. Older houses: constructed before 1999
    # Use buildingage_period for older, buildingage_year for newer
    period_old = [
        'Pre-1919', '1919-1944', '1870-1918', '1960-1979', '1945-1959',
        '1980-1989', 'Pre-1837', '1837-1869', 'Unknown', '1990-1999'
    ]
    # If period is present and not in 2000+, or year < 1999
    old_mask = (
        (houses['buildingage_period'].isin(period_old)) |
        (houses['buildingage_year'].notnull() & (houses['buildingage_year'] < 1999))
    )
    houses = houses[old_mask]
    
    # 4. Large houses: Use geometry_area_m2 (top 25% by area)
    area_threshold = houses['geometry_area_m2'].quantile(0.75)
    large_mask = houses['geometry_area_m2'] >= area_threshold
    houses = houses[large_mask]
    
    # 5. Poor insulation: constructionmaterial, roofmaterial_primarymaterial
    poor_wall_types = [
        'Brick Or Block Or Stone', 'Timber Or Wood', 'Other Non-Standard Or System Build',
        'Mixed (Masonry And Timber)', 'Unknown', 'Other Artificial Material (Not Concrete)',
        'Mixed (Masonry And Metal)', 'Mixed (Plaster And Timber)', 'Static Caravan Or Mobile Home'
    ]
    poor_roof_types = [
        'Thatch', 'Unknown', 'Fabric', 'Other', 'Mixed'
    ]
    insulation_mask = (
        houses['constructionmaterial'].isin(poor_wall_types) |
        houses['roofmaterial_primarymaterial'].isin(poor_roof_types)
    )
    houses = houses[insulation_mask]
    
    # Save to geojson
    houses.to_file('hard_to_heat_houses_exeter.geojson', driver='GeoJSON')
    
    summary = f"Filtered to {len(houses)} hard-to-heat detached houses in Exeter. Area threshold for large houses: {area_threshold:.2f} m2."
    artifact_name = 'hard_to_heat_houses_exeter.geojson'
    artifact_description = (
        'GeoDataFrame of houses in Exeter likely to be hard to heat, filtered by: single residential address, detached/standalone, built before 1999, large area (top 25%), and poor insulation (wall/roof type). Includes geometry and all attributes.'
    )
    return [summary, artifact_name, artifact_description, houses]

