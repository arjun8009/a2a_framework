matplotlib.use('Agg')
def plot_hard_to_heat_houses_exeter(data: list):
    import geopandas as gpd
    import folium
    from folium.plugins import MarkerCluster
    import matplotlib.pyplot as plt
    
    # Load the geodataframe
    gdf = data[0].copy()
    
    # Ensure CRS is EPSG:4326 for folium
    if gdf.crs is not None and gdf.crs.to_epsg() != 4326:
        gdf = gdf.to_crs(epsg=4326)
    
    # Create a folium map centered on Exeter
    centroid = gdf.geometry.unary_union.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13, tiles='cartodbpositron')
    
    # Add houses polygons to the map
    folium.GeoJson(
        gdf,
        name='Hard to Heat Houses',
        style_function=lambda x: {
            'fillColor': '#ff7800',
            'color': '#ff7800',
            'weight': 1,
            'fillOpacity': 0.5
        },
        tooltip=folium.GeoJsonTooltip(fields=['description', 'buildingage_period', 'constructionmaterial', 'numberoffloors'])
    ).add_to(m)
    
    # Save the map
    map_filename = 'hard_to_heat_houses_exeter_map.html'
    m.save(map_filename)
    
    # Distribution summary
    summary = f"There are {len(gdf)} houses in Exeter identified as likely hard to heat. "
    summary += "These are distributed across the city, with a variety of building types and ages. "
    summary += "First 5 entries:\n"
    summary += str(gdf[['description', 'buildingage_period', 'constructionmaterial', 'numberoffloors']].head(5))
    
    artifact_name = 'hard_to_heat_houses_exeter_map'
    artifact_description = 'A folium map showing the spatial distribution of houses in Exeter that are likely hard to heat. Each polygon represents a house, with tooltip information on building type, age period, construction material, and number of floors.'
    
    return [summary, artifact_name, artifact_description, map_filename]

