matplotlib.use('Agg')
def filter_exeter_area_polygon(data: list):
    gdf = data[0]
    # Filter for polygons where the name is 'Exeter' in any of the name columns and relevant description
    mask = (
        (gdf['name1_text'].str.lower() == 'exeter') |
        (gdf['name2_text'].str.lower() == 'exeter') |
        (gdf['name3_text'].str.lower() == 'exeter') |
        (gdf['name4_text'].str.lower() == 'exeter')
    ) & (
        gdf['description'].str.lower().isin([
            'city', 'suburban area', 'town', 'part of settlement', 'village'
        ])
    )
    filtered = gdf[mask]
    summary = f"Filtered to {len(filtered)} polygon(s) for Exeter with relevant settlement descriptions."
    return [summary, 'filtered_exeter_area_polygon', 'GeoDataFrame containing only the polygon(s) for Exeter, filtered by name and settlement-related descriptions.', filtered]


