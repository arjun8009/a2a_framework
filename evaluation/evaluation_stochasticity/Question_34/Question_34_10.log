matplotlib.use('Agg')
def filter_exeter_rivers(data: list):
    gdf = data[0]
    # Filter for rivers in Exeter
    # Use 'catchmentname' for 'Exe', and 'description' for river-like features
    # Possible river-like descriptions: 'Watercourse', 'Canal', 'Leat', 'Brook', 'Stream', 'Beck', 'River'
    river_keywords = ['Watercourse', 'Canal', 'Leat', 'Brook', 'Stream', 'Beck', 'River']
    filtered = gdf[
        (gdf['catchmentname'].str.contains('Exe', case=False, na=False)) &
        (
            gdf['description'].str.contains('|'.join(river_keywords), case=False, na=False)
        )
    ]
    summary = f"Filtered rivers in Exeter (catchment 'Exe') with river-like descriptions. Total entries: {len(filtered)}."
    artifact_name = 'exeter_rivers_filtered'
    artifact_description = "GeoDataFrame of all river-like water features in the Exeter (Exe) catchment, filtered by relevant 'description' values."
    return [summary, artifact_name, artifact_description, filtered]

