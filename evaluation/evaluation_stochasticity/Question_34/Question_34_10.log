).add_to(m)\n\n    folium.LayerControl().add_to(m)\n\n    # Save map\n    map_filename = \'buildings_within_150m_of_river_exeter.html\'\n    m.save(map_filename)\n\n    # Prepare summary\n    summary_rows = buildings_within_150m[[\'osid\', \'description\', \'buildinguse\', \'geometry_area_m2\']].head(5)\n    summary = f"Total buildings within 150m of a river: {len(buildings_within_150m)}. First 5 entries:\\n" + summary_rows.to_string(index=False)\n\n    artifact_name = \'buildings_within_150m_of_river_map\'\n    artifact_description = \'Folium map showing all buildings in Exeter within 150m of any river, with river buffer and rivers plotted.\'\n    artifact_data = map_filename\n\n    return [summary, artifact_name, artifact_description, artifact_data]\n', 'artifact_names': ['buildings_exeter_all_buildings.geojson', 'exeter_rivers_filtered']}
2026-03-04 15:03:58,523 INFO Executing code import matplotlib
matplotlib.use('Agg')
def plot_buildings_within_150m_of_river(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import Polygon, LineString
    from shapely.ops import unary_union
    import os

    # Unpack data
    buildings = data[0]
    rivers = data[1]

    # Ensure CRS is the same and projected for buffering
    if buildings.crs != rivers.crs:
        rivers = rivers.to_crs(buildings.crs)

    # Buffer all river geometries by 150m
    river_buffer = rivers.buffer(150)
    # Merge all buffers into a single geometry (multi-polygon)
    river_buffer_union = gpd.GeoSeries(unary_union(river_buffer), crs=buildings.crs)

    # Select buildings that intersect with the river buffer
    buildings_within_150m = buildings[buildings.intersects(river_buffer_union.iloc[0])].copy()

    # Convert everything to EPSG:4326 for folium
    buildings_within_150m = buildings_within_150m.to_crs(epsg=4326)
    rivers = rivers.to_crs(epsg=4326)
    river_buffer_union = river_buffer_union.to_crs(epsg=4326)

    # Create folium map centered on Exeter
    centroid = buildings_within_150m.geometry.unary_union.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13, tiles='cartodbpositron')

    # Plot river buffer
    folium.GeoJson(river_buffer_union.geometry.iloc[0], name='150m River Buffer',
                  style_function=lambda x: {'color': 'blue', 'fillColor': 'blue', 'weight': 1, 'fillOpacity': 0.1}).add_to(m)

    # Plot rivers
    folium.GeoJson(rivers.geometry, name='Rivers',
                  style_function=lambda x: {'color': 'navy', 'weight': 2}).add_to(m)

    # Plot buildings within 150m
    folium.GeoJson(buildings_within_150m.geometry, name='Buildings within 150m of River',
                  style_function=lambda x: {'color': 'red', 'fillColor': 'red', 'weight': 1, 'fillOpacity': 0.3}).add_to(m)

    folium.LayerControl().add_to(m)

    # Save map
    map_filename = 'buildings_within_150m_of_river_exeter.html'
    m.save(map_filename)

    # Prepare summary
    summary_rows = buildings_within_150m[['osid', 'description', 'buildinguse', 'geometry_area_m2']].head(5)
    summary = f"Total buildings within 150m of a river: {len(buildings_within_150m)}. First 5 entries:\n" + summary_rows.to_string(index=False)

    artifact_name = 'buildings_within_150m_of_river_map'
    artifact_description = 'Folium map showing all buildings in Exeter within 150m of any river, with river buffer and rivers plotted.'
    artifact_data = map_filename

    return [summary, artifact_name, artifact_description, artifact_data]

