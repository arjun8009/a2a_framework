matplotlib.use('Agg')
def filter_exeter_polygon(data: list):
    gdf = data[0]
    # Filter for Exeter using multiple relevant columns for high quality
    # Use name1_text for 'Exeter', and also check for descriptiongroup and description for settlement/city
    filtered = gdf[((gdf['name1_text'].str.lower() == 'exeter') |
                    (gdf['name1_text'].str.lower().str.contains('exeter'))) &
                   (gdf['descriptiongroup'].isin(['Settlement', 'Land Name', 'Other Name'])) &
                   (gdf['description'].isin(['City', 'Town', 'Suburban Area', 'Part Of Settlement', 'Village']))]
    summary = f"Filtered Exeter polygon(s): {len(filtered)} row(s) found."
    artifact_name = 'filtered_exeter_polygon_data'
    artifact_description = 'GeoDataFrame containing only the polygon(s) for Exeter, filtered using name1_text, descriptiongroup, and description.'
    return [summary, artifact_name, artifact_description, filtered]

