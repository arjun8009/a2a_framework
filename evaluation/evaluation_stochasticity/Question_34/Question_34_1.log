matplotlib.use('Agg')
def plot_buildings_and_rivers_within_150m(data: list):
    import geopandas as gpd
    import folium
    from shapely.ops import unary_union
    import pandas as pd
    import os

    # Unpack data
    buildings = data[0]
    rivers = data[1]

    # Ensure CRS is the same and projected for distance calculation
    if buildings.crs is None:
        buildings = buildings.set_crs(epsg=27700)  # Assume British National Grid if missing
    if rivers.crs is None:
        rivers = rivers.set_crs(epsg=27700)
    if buildings.crs != rivers.crs:
        rivers = rivers.to_crs(buildings.crs)

    # Create a 150m buffer around all rivers
    rivers_buffer = rivers.copy()
    rivers_buffer['geometry'] = rivers_buffer.geometry.buffer(150)
    buffer_union = unary_union(rivers_buffer.geometry)

    # Find buildings within 150m of any river
    buildings_within_150m = buildings[buildings.geometry.intersects(buffer_union)]

    # Convert all to EPSG:4326 for folium
    buildings = buildings.to_crs(epsg=4326)
    rivers = rivers.to_crs(epsg=4326)
    buildings_within_150m = buildings_within_150m.to_crs(epsg=4326)
    rivers_buffer = rivers_buffer.to_crs(epsg=4326)

    # Remove non-serializable columns (like Timestamp) for folium
    def remove_nonserializable(gdf):
        for col in gdf.columns:
            if gdf[col].dtype == 'datetime64[ns]' or gdf[col].dtype == 'datetime64[ns, UTC]':
                gdf[col] = gdf[col].astype(str)
        return gdf
    buildings = remove_nonserializable(buildings)
    rivers = remove_nonserializable(rivers)
    buildings_within_150m = remove_nonserializable(buildings_within_150m)
    rivers_buffer = remove_nonserializable(rivers_buffer)

    # Center map on Exeter (approximate centroid of buildings)
    centroid = buildings.geometry.unary_union.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13, tiles='cartodbpositron')

    # Plot all buildings (light gray)
    folium.GeoJson(
        buildings,
        name='All Buildings',
        style_function=lambda x: {'color': 'gray', 'weight': 0.5, 'fillOpacity': 0.1},
        tooltip=folium.GeoJsonTooltip(fields=['description', 'buildinguse'], aliases=['Description', 'Use'])
    ).add_to(m)

    # Plot all rivers (blue)
    folium.GeoJson(
        rivers,
        name='Rivers',
        style_function=lambda x: {'color': 'blue', 'weight': 2},
        tooltip=folium.GeoJsonTooltip(fields=['description', 'name1_text'], aliases=['Type', 'Name'])
    ).add_to(m)

    # Plot 150m buffer (transparent blue)
    folium.GeoJson(
        rivers_buffer,
        name='150m River Buffer',
        style_function=lambda x: {'color': 'blue', 'weight': 1, 'fillColor': 'blue', 'fillOpacity': 0.1},
        tooltip=folium.GeoJsonTooltip(fields=['description', 'name1_text'], aliases=['Type', 'Name'])
    ).add_to(m)

    # Plot buildings within 150m (red)
    folium.GeoJson(
        buildings_within_150m,
        name='Buildings within 150m of River',
        style_function=lambda x: {'color': 'red', 'weight': 1, 'fillColor': 'red', 'fillOpacity': 0.5},
        tooltip=folium.GeoJsonTooltip(fields=['description', 'buildinguse'], aliases=['Description', 'Use'])
    ).add_to(m)

    folium.LayerControl().add_to(m)

    # Save map
    map_filename = 'exeter_buildings_rivers_150m_buffer.html'
    m.save(map_filename)

    # Prepare summary
    summary = f"Plotted {len(buildings)} buildings and {len(rivers)} rivers in Exeter. {len(buildings_within_150m)} buildings are within 150m of any river. First 5 buildings within 150m: "
    if not buildings_within_150m.empty:
        summary += str(buildings_within_150m[['osid', 'description', 'buildinguse']].head(5).to_dict('records'))
    else:
        summary += 'None found.'

    artifact_name = 'exeter_buildings_rivers_150m_buffer_map'
    artifact_description = 'Folium map showing all buildings, all rivers, 150m river buffer, and buildings within 150m of any river in Exeter.'
    return [summary, artifact_name, artifact_description, map_filename]

