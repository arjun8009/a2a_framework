matplotlib.use('Agg')
def filter_exeter_rivers(data: list):
    gdf = data[0]
    # Filter for relevant river data in Exeter
    # Use multiple columns: 'theme', 'description', 'catchmentname', and 'name1_text'
    river_descriptions = ['Watercourse', 'Canal']
    # Catchment name for Exeter is 'Exe', but also check for known river names in Exeter
    exeter_river_names = [
        'River Exe', 'Exeter Canal', 'River Clyst', 'Matford Brook', 'Alphin Brook',
        'Pin Brook', 'Northbrook', 'Mincinglake Stream', 'Fordland Brook',
        'Higher Leat', 'Nadder Brook', 'Taddiforde Brook', 'Exwick Leat', 'River Creedy'
    ]
    filtered = gdf[
        (gdf['theme'] == 'Water') &
        (gdf['description'].isin(river_descriptions)) &
        (
            (gdf['catchmentname'] == 'Exe') |
            (gdf['name1_text'].isin(exeter_river_names))
        )
    ]
    return [
        f"Filtered river data for Exeter. Number of features: {len(filtered)}.",
        'filtered_exeter_rivers',
        'GeoDataFrame containing only the relevant river and canal features in Exeter, filtered by theme, description, catchment, and known river names.',
        filtered
    ]

