matplotlib.use('Agg')
def filter_exeter_polygon(data: list):
    gdf = data[0]
    # Filter for polygons where the name is 'Exeter' in any of the name columns and is a settlement/city/town
    mask = (
        (
            (gdf['name1_text'].str.lower() == 'exeter') |
            (gdf['name2_text'].str.lower() == 'exeter') |
            (gdf['name3_text'].str.lower() == 'exeter') |
            (gdf['name4_text'].str.lower() == 'exeter')
        ) &
        (
            (gdf['descriptiongroup'].str.lower().isin(['settlement'])) |
            (gdf['description'].str.lower().isin(['city', 'town']))
        )
    )
    filtered = gdf[mask]
    summary = f"Filtered polygons for Exeter. Number of matching polygons: {len(filtered)}."
    artifact_name = 'filtered_exeter_polygon_data'
    artifact_description = 'GeoDataFrame containing only the polygon(s) for Exeter, filtered by name and settlement/city/town description.'
    return [summary, artifact_name, artifact_description, filtered]

