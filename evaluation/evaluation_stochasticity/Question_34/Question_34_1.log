matplotlib.use('Agg')
def filter_exeter_rivers(data: list):
    import geopandas as gpd
    import pandas as pd
    # The relevant columns for filtering river data in Exeter are:
    # 'description', 'catchmentname', 'name1_text', 'theme'
    gdf = data[0]
    # Only keep rows where the theme is 'Water' and description is relevant to rivers
    # Use all relevant river-like descriptions: 'Watercourse', 'Canal', 'Leat', 'Brook', 'Stream', 'River', 'Drain', 'Exeter Canal', etc.
    river_keywords = ['Watercourse', 'Canal', 'Leat', 'Brook', 'Stream', 'River', 'Drain']
    # Also filter by catchmentname 'Exe' (for Exeter area) or name1_text containing 'Exe', 'Exeter', or known Exeter rivers
    exeter_river_names = ['Exe', 'Exeter', 'Clyst', 'Creedy', 'Alphin', 'Pin', 'Northbrook', 'Mincinglake', 'Fordland', 'Nadder', 'Taddiforde', 'Exwick']
    # Build mask for river-like features
    mask_river = gdf['description'].isin(river_keywords)
    # Build mask for Exeter catchment or river names
    mask_exeter = (
        (gdf['catchmentname'].str.contains('Exe', case=False, na=False)) |
        (gdf['name1_text'].fillna('').str.contains('|'.join(exeter_river_names), case=False))
    )
    # Combine masks
    filtered = gdf[mask_river & mask_exeter]
    summary = f"Filtered Exeter river data: {len(filtered)} features found out of {len(gdf)}."
    artifact_name = 'filtered_exeter_rivers'
    artifact_description = 'GeoDataFrame containing only river-related features in the Exeter area, filtered by relevant descriptions and catchment/river names.'
    return [summary, artifact_name, artifact_description, filtered]

