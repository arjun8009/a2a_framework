matplotlib.use('Agg')
def filter_exeter_polygon(data: list):
    gdf = data[0]
    # Filter for polygons specifically representing Exeter
    # Use both name1_text and description/descriptiongroup for accuracy
    filtered = gdf[((gdf['name1_text'].str.lower() == 'exeter') |
                    (gdf['name1_text'].str.lower().str.contains('exeter'))) &
                   (
                       (gdf['descriptiongroup'].str.lower().isin(['settlement', 'part of settlement', 'city', 'town'])) |
                       (gdf['description'].str.lower().isin(['city', 'town']))
                   )]
    summary = f"Filtered Exeter polygon(s): {len(filtered)} entries found."
    artifact_name = 'filtered_exeter_polygon'
    artifact_description = 'GeoDataFrame containing only the polygon(s) representing the area of Exeter, filtered using name and settlement/city/town description.'
    return [summary, artifact_name, artifact_description, filtered]

