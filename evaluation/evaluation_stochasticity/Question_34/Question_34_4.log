matplotlib.use('Agg')
def plot_buildings_within_150m_of_rivers(data: list):
    import geopandas as gpd
    import folium
    # Unpack data
    buildings = data[0]
    rivers = data[1]

    # Ensure CRS is the same and projected for distance calculation
    if buildings.crs is None:
        buildings = buildings.set_crs(epsg=4326)
    if rivers.crs is None:
        rivers = rivers.set_crs(epsg=4326)
    
    # Project to British National Grid for accurate distance (meters)
    buildings_proj = buildings.to_crs(epsg=27700)
    rivers_proj = rivers.to_crs(epsg=27700)

    # Create a 150m buffer around all river geometries
    rivers_buffer = rivers_proj.copy()
    rivers_buffer['geometry'] = rivers_proj.geometry.buffer(150)

    # Dissolve all buffers into one (for efficiency)
    rivers_buffer_dissolved = rivers_buffer.dissolve()

    # Spatial join: buildings within 150m of any river
    buildings_within_150m = gpd.sjoin(buildings_proj, rivers_buffer_dissolved, how='inner', predicate='intersects')

    # Reproject back to EPSG:4326 for folium
    buildings_within_150m = buildings_within_150m.to_crs(epsg=4326)
    rivers = rivers.to_crs(epsg=4326)
    rivers_buffer = rivers_buffer.to_crs(epsg=4326)

    # Create folium map centered on Exeter
    centroid = buildings_within_150m.geometry.unary_union.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13)

    # Plot river lines
    folium.GeoJson(rivers[['geometry']], name='Rivers', style_function=lambda x: {'color': 'blue', 'weight': 2}).add_to(m)
    # Plot river buffer
    folium.GeoJson(rivers_buffer[['geometry']], name='150m River Buffer', style_function=lambda x: {'color': 'cyan', 'weight': 1, 'fillOpacity': 0.1}).add_to(m)
    # Plot buildings within 150m
    folium.GeoJson(buildings_within_150m[['geometry']], name='Buildings within 150m', style_function=lambda x: {'color': 'red', 'weight': 1, 'fillOpacity': 0.5}).add_to(m)

    folium.LayerControl().add_to(m)
    
    # Save map
    map_filename = 'buildings_within_150m_of_rivers_exeter.html'
    m.save(map_filename)

    # Prepare summary using available columns
    available_cols = [col for col in ['osid', 'description', 'buildinguse', 'geometry_area_m2'] if col in buildings_within_150m.columns]
    summary_rows = buildings_within_150m.head(5)[available_cols]
    summary = f"Total buildings within 150m of any river: {len(buildings_within_150m)}. First 5 results:\n" + summary_rows.to_string(index=False)
    
    return [summary, 'buildings_within_150m_of_rivers_map', 'Folium map showing all buildings within 150m of any river in Exeter, with river lines, 150m buffer, and highlighted buildings.', map_filename]

