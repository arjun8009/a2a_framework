matplotlib.use('Agg')
def summarize_exeter_rivers(data: list):
    import pandas as pd
    import geopandas as gpd
    df = data[0]
    # Filter for Exeter rivers using multiple relevant columns
    # Use catchmentname, name1_text, and description to increase specificity
    exeter_keywords = [
        'Exe', 'Exeter', 'Clyst', 'Canal', 'Matford', 'Alphin', 'Pin', 'Northbrook',
        'Mincinglake', 'Fordland', 'Higher Leat', 'Nadder', 'Taddiforde', 'Exwick', 'Creedy'
    ]
    # Filter rows where catchmentname is 'Exe' or name1_text contains any Exeter river names
    mask = (
        (df['catchmentname'].fillna('').str.contains('Exe', case=False)) |
        (df['name1_text'].fillna('').str.contains('|'.join(exeter_keywords), case=False)) |
        (df['description'].fillna('').str.contains('Canal|Leat|Watercourse|Brook|River', case=False))
    )
    exeter_rivers = df[mask].copy()
    # Summarize: count, total length, unique river names
    summary = {
        'total_features': len(exeter_rivers),
        'total_length_m': exeter_rivers['geometry_length_m'].sum(),
        'unique_river_names': exeter_rivers['name1_text'].dropna().unique().tolist(),
        'description_types': exeter_rivers['description'].unique().tolist()
    }
    # Save summary as a DataFrame for artifact
    summary_df = pd.DataFrame({
        'total_features': [summary['total_features']],
        'total_length_m': [summary['total_length_m']],
        'unique_river_names': [', '.join(summary['unique_river_names'])],
        'description_types': [', '.join(summary['description_types'])]
    })
    return [
        f"Summary of Exeter river data: {summary['total_features']} features, total length {summary['total_length_m']:.2f} m, rivers: {', '.join(summary['unique_river_names'])}",
        'exeter_rivers_summary',
        'Summary table of river features in Exeter, including total count, total length, unique river names, and description types.',
        summary_df
    ]

output = summarize_exeter_rivers(data)

