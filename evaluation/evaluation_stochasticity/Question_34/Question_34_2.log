2026-03-04 14:33:11,254 INFO Executing code import matplotlib
matplotlib.use('Agg')
def plot_buildings_within_150m_of_rivers(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import Polygon, LineString, MultiLineString
    from shapely.ops import unary_union
    import os

    # Unpack data
    buildings = data[0].copy()
    rivers = data[1].copy()

    # Ensure both are in EPSG:4326 for folium
    buildings = buildings.to_crs(epsg=4326)
    rivers = rivers.to_crs(epsg=4326)

    # Create a single geometry for all rivers (union)
    river_union = unary_union(rivers['geometry'])
    # Buffer the river geometries by 150 meters
    river_buffer = gpd.GeoSeries([river_union], crs=4326).buffer(150/111320)  # 1 deg ~ 111.32km

    # Select buildings that intersect the buffer
    buildings['intersects'] = buildings['geometry'].intersects(river_buffer.iloc[0])
    buildings_near_river = buildings[buildings['intersects']].copy()

    # Prepare folium map
    if not buildings_near_river.empty:
        centroid = buildings_near_river.geometry.iloc[0].centroid
        m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13)
    else:
        m = folium.Map(location=[50.72, -3.53], zoom_start=13)

    # Plot river buffer
    folium.GeoJson(river_buffer.iloc[0], name='150m River Buffer', style_function=lambda x: {'color': 'blue', 'fillColor': 'blue', 'weight': 2, 'fillOpacity': 0.1}).add_to(m)
    # Plot rivers
    folium.GeoJson(rivers, name='Rivers', style_function=lambda x: {'color': 'navy', 'weight': 3}).add_to(m)
    # Plot buildings
    folium.GeoJson(buildings_near_river, name='Buildings within 150m', style_function=lambda x: {'color': 'red', 'weight': 1, 'fillColor': 'red', 'fillOpacity': 0.4}).add_to(m)

    folium.LayerControl().add_to(m)

    # Save map
    map_filename = 'buildings_within_150m_of_rivers.html'
    m.save(map_filename)

    # Prepare summary
    summary_rows = buildings_near_river[['osid', 'description', 'geometry_area_m2']].head(5).to_dict('records')
    summary = f"{len(buildings_near_river)} buildings found within 150m of any river. First 5: {summary_rows}"
    artifact_name = 'buildings_within_150m_of_rivers_map'
    artifact_description = 'Folium map showing all buildings within 150m of any river in Exeter, with river buffer and river geometries.'
    return [summary, artifact_name, artifact_description, map_filename]

