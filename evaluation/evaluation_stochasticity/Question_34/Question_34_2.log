2026-03-04 14:31:41,988 INFO Executing code import matplotlib
matplotlib.use('Agg')
def plot_buildings_within_150m_of_rivers(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import Polygon, LineString
    from shapely.ops import unary_union
    
    # Unpack data
    buildings = data[0]
    rivers = data[1]
    
    # Ensure CRS is set and convert to EPSG:4326 for folium
    if buildings.crs is None:
        buildings = buildings.set_crs(epsg=27700)  # Assume British National Grid if not set
    if rivers.crs is None:
        rivers = rivers.set_crs(epsg=27700)
    buildings = buildings.to_crs(epsg=4326)
    rivers = rivers.to_crs(epsg=4326)
    
    # Create a 150m buffer around all river geometries
    rivers_buffer = rivers.buffer(150)
    # Merge all buffers into a single geometry
    buffer_union = gpd.GeoSeries(unary_union(rivers_buffer))
    
    # Select buildings that intersect with the buffer
    buildings_within_150m = buildings[buildings.intersects(buffer_union.iloc[0])]
    
    # Prepare folium map centered on Exeter
    centroid = buildings_within_150m.geometry.unary_union.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13)
    
    # Plot river buffer
    folium.GeoJson(buffer_union.to_crs(epsg=4326), name='150m River Buffer', style_function=lambda x: {'color': 'blue', 'fillColor': 'blue', 'weight': 1, 'fillOpacity': 0.1}).add_to(m)
    # Plot rivers
    folium.GeoJson(rivers, name='Rivers', style_function=lambda x: {'color': 'navy', 'weight': 2}).add_to(m)
    # Plot buildings within 150m
    folium.GeoJson(buildings_within_150m, name='Buildings within 150m', style_function=lambda x: {'color': 'red', 'fillColor': 'red', 'weight': 1, 'fillOpacity': 0.4}).add_to(m)
    
    folium.LayerControl().add_to(m)
    
    # Save map
    map_filename = 'buildings_within_150m_of_rivers.html'
    m.save(map_filename)
    
    # Prepare summary
    summary_rows = buildings_within_150m[['osid', 'description', 'buildinguse', 'geometry_area_m2']].head(5)
    summary = f"Total buildings within 150m of any river: {len(buildings_within_150m)}. First 5 entries:\n{summary_rows.to_string(index=False)}"
    
    return [summary, map_filename, 'Folium map showing all buildings within 150m of any river in Exeter, with river buffer and rivers plotted.', map_filename]

