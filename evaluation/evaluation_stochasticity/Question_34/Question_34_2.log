matplotlib.use('Agg')
def filter_exeter_polygon(data: list):
    gdf = data[0]
    # Filter for polygons where name1_text is 'Exeter' and descriptiongroup is 'Settlement' or description is 'City' or 'Town'
    filtered = gdf[((gdf['name1_text'].str.lower() == 'exeter') & 
                   (gdf['descriptiongroup'].str.lower() == 'settlement')) |
                  ((gdf['name1_text'].str.lower() == 'exeter') & 
                   (gdf['description'].str.lower().isin(['city', 'town'])))]
    summary = f"Filtered Exeter polygon: {len(filtered)} entries found."
    artifact_name = 'filtered_exeter_polygon_data'
    artifact_description = 'Polygon(s) for Exeter filtered by name and settlement/city/town description.'
    return [summary, artifact_name, artifact_description, filtered]

