matplotlib.use('Agg')
def filter_exeter_rivers_data(data: list):
    import geopandas as gpd
    import pandas as pd
    # Unpack the two dataframes
    df_set, df = data
    # --- Step 1: Identify valid river/canal/stream entities from authoritative set ---
    # Use 'description' and 'name1_text' from df_set as the reference list
    valid_types = [
        'Named Canal', 'Named Watercourse', 'Named Stretch Of Inland Water'
    ]
    # Only keep those with a valid name
    valid_names = df_set[df_set['description'].isin(valid_types) & df_set['name1_text'].notnull()]['name1_text'].unique()
    # --- Step 2: Filter the main dataset for these names and valid types ---
    # Acceptable types in the main dataset
    valid_desc = ['Watercourse', 'Canal', 'Leat', 'Still Water']
    # Use both name1_text and description for filtering
    mask = (
        df['name1_text'].isin(valid_names) &
        df['description'].isin(valid_desc)
    )
    filtered = df[mask].copy()
    # --- Step 3: Remove spurious/duplicate entities (e.g., unnamed, wrong type) ---
    # Remove rows with missing or empty name1_text
    filtered = filtered[filtered['name1_text'].notnull() & (filtered['name1_text'].str.strip() != '')]
    # Drop duplicates based on name and geometry
    filtered = filtered.drop_duplicates(subset=['name1_text', 'geometry'])
    # --- Step 4: Save as artifact ---
    summary = f"Filtered rivers/canals/streams in Exeter area: {len(filtered)} entities. Names: {sorted(filtered['name1_text'].unique())}"
    artifact_name = 'filtered_exeter_rivers_data'
    artifact_description = (
        "A refined GeoDataFrame of rivers, canals, and streams in the Exeter area, "
        "filtered to remove spurious or duplicate entities. Only named and valid water features are included. "
        "Columns preserved from the original dataset."
    )
    return [summary, artifact_name, artifact_description, filtered]

