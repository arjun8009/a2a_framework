matplotlib.use('Agg')
def filter_exeter_polygon(data: list):
    gdf = data[0]
    # Filter for polygons where the area is named 'Exeter' in any of the name columns
    filtered = gdf[(gdf['name1_text'].str.lower() == 'exeter') |
                   (gdf['name2_text'].str.lower() == 'exeter') |
                   (gdf['name3_text'].str.lower() == 'exeter') |
                   (gdf['name4_text'].str.lower() == 'exeter')]
    summary = f"Filtered polygons for area named 'Exeter'. Number of matching polygons: {len(filtered)}."
    artifact_name = 'filtered_exeter_polygon_data'
    artifact_description = "GeoDataFrame containing only the polygon(s) for the area named 'Exeter', filtered from the original dataset using all available name columns."
    return [summary, artifact_name, artifact_description, filtered]

