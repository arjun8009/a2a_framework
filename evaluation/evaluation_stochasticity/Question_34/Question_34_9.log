2026-03-04 15:00:08,557 INFO Executing code import matplotlib
matplotlib.use('Agg')
def plot_buildings_within_150m_of_rivers(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import Polygon, LineString
    from shapely.ops import unary_union
    import os

    # Unpack data
    buildings = data[0].copy()
    rivers = data[1].copy()

    # Ensure CRS is the same and projected for distance calculation
    if buildings.crs is None:
        buildings.set_crs(epsg=27700, inplace=True)  # Assume British National Grid if missing
    if rivers.crs is None:
        rivers.set_crs(epsg=27700, inplace=True)
    buildings = buildings.to_crs(epsg=27700)
    rivers = rivers.to_crs(epsg=27700)

    # Create a 150m buffer around all river geometries
    river_buffer = rivers.buffer(150)
    river_buffer_union = gpd.GeoSeries(unary_union(river_buffer), crs=rivers.crs)

    # Find buildings that intersect with the buffer
    buildings_within_150m = buildings[buildings.intersects(river_buffer_union.unary_union)]

    # Prepare for plotting: convert everything to EPSG:4326 for folium
    buildings_within_150m = buildings_within_150m.to_crs(epsg=4326)
    rivers = rivers.to_crs(epsg=4326)
    river_buffer_union = river_buffer_union.to_crs(epsg=4326)

    # Create folium map centered on Exeter
    if not buildings_within_150m.empty:
        centroid = buildings_within_150m.geometry.iloc[0].centroid
        m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13)
    else:
        m = folium.Map(location=[50.7218, -3.5336], zoom_start=13)  # Exeter fallback

    # Plot river buffer
    folium.GeoJson(river_buffer_union.geometry.iloc[0],
                  name='150m River Buffer',
                  style_function=lambda x: {'color': 'blue', 'fillColor': 'blue', 'weight': 1, 'fillOpacity': 0.1}).add_to(m)

    # Plot rivers
    folium.GeoJson(rivers,
                  name='Rivers',
                  style_function=lambda x: {'color': 'navy', 'weight': 2}).add_to(m)

    # Plot buildings within 150m
    folium.GeoJson(buildings_within_150m,
                  name='Buildings within 150m of River',
                  style_function=lambda x: {'color': 'red', 'fillColor': 'red', 'weight': 1, 'fillOpacity': 0.4}).add_to(m)

    folium.LayerControl().add_to(m)

    # Save map
    map_filename = 'buildings_within_150m_of_rivers_exeter.html'
    m.save(map_filename)

    # Prepare summary
    summary_rows = buildings_within_150m[['osid', 'description', 'buildinguse', 'geometry_area_m2']].head(5)
    summary = f"Found {len(buildings_within_150m)} buildings within 150m of any river in Exeter. First 5 results:\n" + summary_rows.to_string(index=False)

    return [summary, map_filename, "Folium map showing all buildings within 150m of any river in Exeter, with river buffer and rivers plotted.", map_filename]

