    import geopandas as gpd
    import folium
    from shapely.geometry import shape
    from shapely.ops import unary_union
    import pandas as pd

    # Helper to find geometry column
    def find_geometry_column(df):
        for col in df.columns:
            if df[col].apply(lambda x: hasattr(x, 'geom_type')).all():
                return col
        return None

    # Convert to GeoDataFrame using the correct geometry column
    buildings = data[0].copy()
    rivers = data[1].copy()

    b_geom_col = find_geometry_column(buildings)
    r_geom_col = find_geometry_column(rivers)

    if b_geom_col is not None:
        buildings = gpd.GeoDataFrame(buildings, geometry=b_geom_col)
    else:
        return ["No geometry column found in buildings data", None, None, None]
    if r_geom_col is not None:
        rivers = gpd.GeoDataFrame(rivers, geometry=r_geom_col)
    else:
        return ["No geometry column found in rivers data", None, None, None]

    # Set CRS if not present
    if buildings.crs is None:
        buildings.set_crs(epsg=27700, inplace=True)
    if rivers.crs is None:
        rivers.set_crs(epsg=27700, inplace=True)

    # Reproject to EPSG:27700 for accurate buffering (meters)
    buildings = buildings.to_crs(epsg=27700)
    rivers = rivers.to_crs(epsg=27700)

    # Create a single geometry for all rivers (union)
    river_union = unary_union(rivers.geometry)

    # Buffer the river union by 150 meters
    river_buffer = gpd.GeoSeries([river_union], crs=rivers.crs).buffer(150)

    # Select buildings that intersect with the buffer
    buildings_within_150m = buildings[buildings.geometry.intersects(river_buffer.unary_union)]

    # Convert everything to EPSG:4326 for folium
    buildings_within_150m = buildings_within_150m.to_crs(epsg=4326)
    river_buffer = river_buffer.to_crs(epsg=4326)
    rivers = rivers.to_crs(epsg=4326)

    # Create folium map centered on Exeter
    centroid = buildings_within_150m.geometry.unary_union.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13)

    # Plot river buffer
    folium.GeoJson(river_buffer.geometry.iloc[0], name='150m River Buffer', style_function=lambda x: {'color': 'blue', 'fillColor': 'blue', 'weight': 2, 'fillOpacity': 0.1}).add_to(m)
    # Plot rivers
    folium.GeoJson(rivers.geometry.unary_union, name='Rivers', style_function=lambda x: {'color': 'navy', 'weight': 3}).add_to(m)
    # Plot buildings
    folium.GeoJson(buildings_within_150m.geometry, name='Buildings within 150m', style_function=lambda x: {'color': 'red', 'fillColor': 'red', 'weight': 1, 'fillOpacity': 0.5}).add_to(m)

    folium.LayerControl().add_to(m)

    # Save map
    map_filename = 'buildings_within_150m_of_rivers_map.html'
    m.save(map_filename)

    # Prepare summary
    summary_rows = buildings_within_150m[['osid', 'description', 'buildinguse', 'geometry_area_m2']].head(5)
    summary = f"Total buildings within 150m of any river: {len(buildings_within_150m)}. First 5 entries:\n{summary_rows.to_string(index=False)}"

    return [summary, map_filename, 'Folium map showing all buildings within 150m of any river in Exeter, with river buffer and rivers plotted.', map_filename]

