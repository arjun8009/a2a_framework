def filter_valid_exeter_river_geometries(data: list):
    import geopandas as gpd
    # Unpack the two GeoDataFrames
    gdf1, gdf2 = data
    # For waterlinkset_exeter_river_geometries:
    # Valid river geometries: description in ['Named Watercourse', 'Named Canal', 'Named Stretch Of Inland Water']
    valid_desc1 = ['Named Watercourse', 'Named Canal', 'Named Stretch Of Inland Water']
    filtered1 = gdf1[gdf1['description'].isin(valid_desc1)]
    # For waterlink_exeter_river_geometries:
    # Valid river geometries: description in ['Watercourse', 'Leat', 'Canal']
    valid_desc2 = ['Watercourse', 'Leat', 'Canal']
    filtered2 = gdf2[gdf2['description'].isin(valid_desc2)]
    # Combine both filtered GeoDataFrames
    filtered_combined = gpd.GeoDataFrame(pd.concat([filtered1, filtered2], ignore_index=True), crs=gdf1.crs)
    summary = f"Filtered valid river geometries in Exeter: {len(filtered_combined)} features from both sources."
    artifact_name = 'filtered_exeter_river_geometries'
    artifact_description = 'GeoDataFrame of valid river geometries within Exeter, filtered from both input sources using authoritative description columns.'
    return [summary, artifact_name, artifact_description, filtered_combined]

