2026-03-04 14:37:55,695 INFO Executing code import matplotlib
matplotlib.use('Agg')
def plot_buildings_within_150m_of_rivers(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import Polygon, MultiPolygon
    from shapely.ops import unary_union
    
    # Unpack data
    buildings = data[0].copy()
    rivers = data[1].copy()

    # Ensure both are in the same CRS (EPSG:4326 for folium)
    if buildings.crs is None:
        buildings.set_crs(epsg=27700, inplace=True)  # Assume British National Grid if missing
    if rivers.crs is None:
        rivers.set_crs(epsg=27700, inplace=True)
    buildings = buildings.to_crs(epsg=4326)
    rivers = rivers.to_crs(epsg=4326)

    # Create a 150m buffer around all river geometries
    rivers_buffer = rivers.to_crs(epsg=3857).buffer(150).to_crs(epsg=4326)
    buffer_union = unary_union(rivers_buffer)

    # Select buildings whose geometry intersects the buffer
    buildings['intersects_buffer'] = buildings['geometry'].intersects(buffer_union)
    buildings_within_150m = buildings[buildings['intersects_buffer']].copy()
    buildings_within_150m.drop(columns=['intersects_buffer'], inplace=True)

    # Prepare folium map
    if not buildings_within_150m.empty:
        centroid = buildings_within_150m.geometry.iloc[0].centroid
        m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13, tiles='cartodbpositron')
    else:
        m = folium.Map(location=[50.72, -3.53], zoom_start=13, tiles='cartodbpositron')

    # Plot river geometries
    folium.GeoJson(rivers[['geometry']], name='Rivers', style_function=lambda x: {'color': 'blue', 'weight': 2}).add_to(m)
    # Plot buffer
    folium.GeoJson(gpd.GeoSeries([buffer_union], crs='EPSG:4326'), name='150m Buffer', style_function=lambda x: {'color': 'cyan', 'weight': 1, 'fillOpacity': 0.1}).add_to(m)
    # Plot buildings within 150m
    folium.GeoJson(buildings_within_150m[['geometry']], name='Buildings within 150m', style_function=lambda x: {'color': 'red', 'weight': 1, 'fillOpacity': 0.3}).add_to(m)
    folium.LayerControl().add_to(m)

    # Save map
    map_filename = 'buildings_within_150m_of_rivers_map.html'
    m.save(map_filename)

    # Prepare summary
    summary_rows = buildings_within_150m[['osid', 'description', 'buildinguse', 'geometry_area_m2']].head(5)
    summary = f"Found {len(buildings_within_150m)} buildings within 150m of any river. First 5 results:\n" + summary_rows.to_string(index=False)
    artifact_name = 'buildings_within_150m_of_rivers_map'
    artifact_description = 'Folium map showing all buildings within 150m of any river in Exeter, with river lines, buffer, and selected buildings.'
    return [summary, artifact_name, artifact_description, map_filename]

# The function will be called by the system with the correct data inputs.
