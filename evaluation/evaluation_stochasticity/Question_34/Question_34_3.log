2026-03-04 14:35:13,424 INFO Executing code import matplotlib
matplotlib.use('Agg')
def summarize_exeter_rivers(data: list):
    import pandas as pd
    gdf = data[0]
    # Focus on river features: description likely 'Watercourse', 'Canal', 'Leat', 'Brook', etc.
    river_types = [
        'Watercourse', 'Canal', 'Leat', 'Brook', 'Stream', 'River', 'Lock', 'Drain', 'Still Water', 'Marsh', 'Foreshore'
    ]
    # Filter for river-like features
    rivers = gdf[gdf['description'].isin(river_types)]
    # Group by name, summarize length and count
    summary = (
        rivers.groupby('name1_text', dropna=False)
        .agg(
            feature_count=('osid', 'count'),
            total_length_m=('geometry_length_m', 'sum'),
            avg_width_m=('width_average', 'mean'),
            min_width_m=('width_minimum', 'min'),
            max_width_m=('width_maximum', 'max')
        )
        .reset_index()
        .sort_values(by='total_length_m', ascending=False)
    )
    # Add a column for river/canal/other type
    summary['type'] = summary['name1_text'].map(
        lambda n: 'Canal' if n and 'canal' in str(n).lower() else (
            'Leat' if n and 'leat' in str(n).lower() else (
                'Brook' if n and 'brook' in str(n).lower() else (
                    'River' if n and 'river' in str(n).lower() else 'Other'))))
    # Save as artifact
    return [
        f"Summary of rivers in Exeter: {len(summary)} named features, total features: {len(rivers)}.",
        'exeter_rivers_summary',
        'A summary table of named rivers and river-like features in Exeter, including feature count, total length, and width statistics.',
        summary
    ]

