matplotlib.use('Agg')
def filter_exeter_polygon(data: list):
    gdf = data[0]
    # Filter for polygons where the main name is 'Exeter' and descriptiongroup is relevant for a city/settlement
    filtered = gdf[((gdf['name1_text'].str.lower() == 'exeter') |
                    (gdf['name2_text'].str.lower() == 'exeter') |
                    (gdf['name3_text'].str.lower() == 'exeter') |
                    (gdf['name4_text'].str.lower() == 'exeter')) &
                   (gdf['descriptiongroup'].isin(['Settlement', 'City', 'Town', 'Part Of Settlement', 'Suburban Area']))]
    summary = f"Filtered polygons for Exeter. Number of matching polygons: {len(filtered)}."
    artifact_name = 'filtered_exeter_polygon_data'
    artifact_description = 'GeoDataFrame containing only the polygon(s) for Exeter, filtered by name and relevant settlement/city/town categories.'
    return [summary, artifact_name, artifact_description, filtered]

