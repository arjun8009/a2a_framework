matplotlib.use('Agg')
def analyze_natural_land_features_exeter(data: list):
    import pandas as pd
    import geopandas as gpd
    # Unpack the data
    land_gdf = data[0]
    landform_gdf = data[1]

    # --- Analyze land_natural_land_features_exeter ---
    # Focus on coniferous trees, heath, rough grassland (if present)
    land_features = [
        'Coniferous Trees', 'Heath', 'Rough Grassland',
        'coniferous trees', 'heath', 'rough grassland'
    ]
    # Use both 'description' and 'oslandcovertierb' for robust filtering
    land_mask = (
        land_gdf['description'].str.lower().isin([x.lower() for x in land_features]) |
        land_gdf['oslandcovertierb'].str.lower().isin([x.lower() for x in land_features])
    )
    filtered_land = land_gdf[land_mask].copy()
    filtered_land['feature_type'] = filtered_land['description'].combine_first(filtered_land['oslandcovertierb'])

    # --- Analyze landform_natural_land_features_exeter ---
    # Focus on cliffs, heath, rough grassland (if present)
    landform_features = [
        'Cliff', 'Heath', 'Rough Grassland',
        'cliff', 'heath', 'rough grassland'
    ]
    landform_mask = landform_gdf['description'].str.lower().isin([x.lower() for x in landform_features])
    filtered_landform = landform_gdf[landform_mask].copy()
    filtered_landform['feature_type'] = filtered_landform['description']

    # --- Combine results ---
    # Standardize columns for concatenation
    land_cols = ['osid', 'toid', 'feature_type', 'geometry_area_m2', 'geometry', 'theme', 'capturespecification']
    landform_cols = ['osid', 'toid', 'feature_type', 'geometry_area', 'geometry', 'theme', 'capturespecification']
    # Rename geometry_area columns for consistency
    filtered_land = filtered_land.rename(columns={'geometry_area_m2': 'geometry_area'})
    filtered_land = filtered_land[land_cols]
    filtered_landform = filtered_landform[landform_cols]
    combined = pd.concat([filtered_land, filtered_landform], ignore_index=True)

    # --- Summary ---
    summary = (
        f"Analyzed natural land features in Exeter: {len(combined)} features found. "
        f"Breakdown: {combined['feature_type'].value_counts().to_dict()}"
    )
    artifact_name = 'analyzed_natural_land_features_exeter'
    artifact_description = (
        "GeoDataFrame containing all coniferous trees, cliffs, heath, and rough grassland features "
        "from both land and landform datasets for Exeter. Includes geometry, area, and feature type."
    )
    return [summary, artifact_name, artifact_description, combined]

