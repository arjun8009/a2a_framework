    # Center map on Exeter (mean of all geometries)
    centroid = gdf.unary_union.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13, tiles='cartodbpositron')

    # Plot Coniferous Trees
    folium.GeoJson(
        coniferous,
        name='Coniferous Trees',
        style_function=lambda x: {'fillColor': '#228B22', 'color': '#228B22', 'weight': 1, 'fillOpacity': 0.5},
        tooltip=folium.GeoJsonTooltip(fields=['feature_type', 'geometry_area'])
    ).add_to(m)

    # Plot Cliffs
    folium.GeoJson(
        cliffs,
        name='Cliffs',
        style_function=lambda x: {'fillColor': '#8B4513', 'color': '#8B4513', 'weight': 1, 'fillOpacity': 0.5},
        tooltip=folium.GeoJsonTooltip(fields=['feature_type', 'geometry_area'])
    ).add_to(m)

    folium.LayerControl().add_to(m)

    # Save map
    map_filename = 'natural_areas_coniferous_cliffs_exeter.html'
    m.save(map_filename)

    # Prepare summary
    summary = (
        f"Plotted {len(coniferous)} coniferous tree areas and {len(cliffs)} cliff areas in Exeter.\n"
        f"First 5 coniferous tree areas: {coniferous[['osid','geometry_area']].head().to_dict('records')}\n"
        f"First 5 cliff areas: {cliffs[['osid','geometry_area']].head().to_dict('records')}"
    )
    artifact_name = 'natural_areas_coniferous_cliffs_map'
    artifact_description = 'Folium map showing the distribution of coniferous trees and cliffs within the Exeter area polygon.'
    return [summary, artifact_name, artifact_description, map_filename]

