matplotlib.use('Agg')
def filter_exeter_polygon(data: list):
    gdf = data[0]
    # Filter for Exeter using multiple relevant columns for accuracy
    filtered = gdf[
        (
            (gdf['name1_text'].str.lower() == 'exeter') &
            (
                (gdf['descriptiongroup'].str.lower().isin(['settlement', 'other name'])) |
                (gdf['description'].str.lower().isin(['city', 'town', 'suburban area', 'part of settlement']))
            )
        )
    ]
    summary = f"Filtered polygon(s) for Exeter. Number of entries: {len(filtered)}."
    artifact_name = 'filtered_exeter_polygon_data'
    artifact_description = 'GeoDataFrame containing only the polygon(s) representing Exeter, filtered using name and settlement/city/town/suburban area attributes.'
    return [summary, artifact_name, artifact_description, filtered]

