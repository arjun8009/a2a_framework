matplotlib.use('Agg')
def filter_exeter_polygon(data: list):
    gdf = data[0]
    # Filter for Exeter using multiple relevant columns for high quality
    # We look for 'Exeter' in name1_text and ensure it's a settlement/city/town
    mask = (
        (gdf['name1_text'].str.lower() == 'exeter') &
        (gdf['descriptiongroup'].isin(['Settlement'])) &
        (gdf['description'].isin(['City', 'Town']))
    )
    filtered = gdf[mask]
    summary = f"Filtered Exeter polygon: {len(filtered)} entries found."
    artifact_name = 'filtered_exeter_polygon_data'
    artifact_description = (
        "GeoDataFrame containing only the polygon(s) for Exeter, "
        "filtered by name1_text='Exeter', descriptiongroup='Settlement', and description in ['City', 'Town']. "
        "Includes all geometry and attribute columns."
    )
    return [summary, artifact_name, artifact_description, filtered]

