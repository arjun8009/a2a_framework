2026-03-04 15:05:56,194 INFO Executing code import matplotlib
matplotlib.use('Agg')
def plot_natural_land_features_exeter(data: list):
    import geopandas as gpd
    import folium
    from folium import GeoJson
    import os
    
    # Unpack the data
    land_natural = data[0].copy()
    landform_natural = data[1].copy()
    exeter_extent = data[2].copy()

    # Ensure all are in EPSG:4326
    land_natural = land_natural.to_crs(epsg=4326)
    landform_natural = landform_natural.to_crs(epsg=4326)
    exeter_extent = exeter_extent.to_crs(epsg=4326)

    # Get centroid of Exeter for map centering
    centroid = exeter_extent.geometry.iloc[0].centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=12, tiles='cartodbpositron')

    # Plot Exeter extent
    folium.GeoJson(
        exeter_extent.geometry,
        name='Exeter Extent',
        style_function=lambda x: {'color': 'black', 'weight': 2, 'fillOpacity': 0.05}
    ).add_to(m)

    # Plot land natural features (e.g. Heath, Trees, etc.)
    folium.GeoJson(
        land_natural[['geometry', 'description']],
        name='Natural Land Features',
        style_function=lambda x: {'color': 'green', 'weight': 1, 'fillOpacity': 0.3},
        tooltip=folium.GeoJsonTooltip(fields=['description'])
    ).add_to(m)

    # Plot landform features (e.g. Cliffs)
    folium.GeoJson(
        landform_natural[['geometry', 'description']],
        name='Landform Features',
        style_function=lambda x: {'color': 'brown', 'weight': 1, 'fillOpacity': 0.3},
        tooltip=folium.GeoJsonTooltip(fields=['description'])
    ).add_to(m)

    folium.LayerControl().add_to(m)

    # Save map
    map_filename = 'natural_land_features_exeter_map.html'
    m.save(map_filename)

    # Prepare summary
    summary = (
        f"Plotted {len(land_natural)} natural land features and {len(landform_natural)} landform features in Exeter. "
        f"Exeter extent is shown for context.\n"
        f"First 5 natural land features: {land_natural['description'].head(5).tolist()}\n"
        f"First 5 landform features: {landform_natural['description'].head(5).tolist()}"
    )
    
    return [
        summary,
        'natural_land_features_exeter_map',
        'A folium map showing natural land features and landform features in Exeter, with the city extent as context.',
        map_filename
    ]

