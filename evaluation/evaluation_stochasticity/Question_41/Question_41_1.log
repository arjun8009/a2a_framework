2026-03-04 15:04:52,845 INFO Executing code import matplotlib
matplotlib.use('Agg')
def filter_exeter_polygon_data(data: list):
    gdf = data[0]
    # Filter for polygons specifically representing Exeter
    # Use multiple columns for accuracy: name1_text, descriptiongroup, description
    exeter_mask = (
        (gdf['name1_text'].str.lower() == 'exeter') &
        (
            (gdf['descriptiongroup'].str.lower().isin(['settlement', 'other name'])) |
            (gdf['description'].str.lower().isin(['city', 'town', 'suburban area', 'part of settlement', 'village']))
        )
    )
    filtered = gdf[exeter_mask]
    summary = f"Filtered polygon data for Exeter. Number of matching polygons: {len(filtered)}."
    artifact_name = 'filtered_exeter_polygon_data'
    artifact_description = 'Polygon data filtered to only include entries specifically for Exeter, using name1_text, descriptiongroup, and description columns.'
    return [summary, artifact_name, artifact_description, filtered]

