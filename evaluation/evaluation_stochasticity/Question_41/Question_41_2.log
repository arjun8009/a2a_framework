2026-03-04 15:06:42,944 INFO Executing code import matplotlib
matplotlib.use('Agg')
def filter_exeter_area_polygon(data: list):
    gdf = data[0]
    # Filter for polygons where the name is 'Exeter' in any of the name columns and relevant description
    mask = (
        (gdf['name1_text'].str.lower() == 'exeter') |
        (gdf['name2_text'].str.lower() == 'exeter') |
        (gdf['name3_text'].str.lower() == 'exeter') |
        (gdf['name4_text'].str.lower() == 'exeter')
    ) & (
        (gdf['descriptiongroup'].isin(['Settlement', 'Part Of Settlement'])) |
        (gdf['description'].isin(['City', 'Town', 'Suburban Area', 'Village']))
    )
    filtered = gdf[mask]
    summary = f"Filtered polygons for Exeter. Number of matching polygons: {len(filtered)}."
    artifact_name = 'filtered_exeter_area_polygon'
    artifact_description = 'GeoDataFrame containing only the polygon(s) for Exeter, filtered by name and relevant settlement/city/town/village descriptions.'
    return [summary, artifact_name, artifact_description, filtered]

