matplotlib.use('Agg')
def plot_natural_land_features_exeter(data: list):
    import geopandas as gpd
    import folium
    from folium import GeoJson
    import matplotlib
    import matplotlib.colors as mcolors
    import random
    
    # Load the GeoDataFrame
    gdf = data[0].copy()
    
    # Ensure CRS is EPSG:4326 for folium
    if gdf.crs is not None and gdf.crs.to_string() != 'EPSG:4326':
        gdf = gdf.to_crs(epsg=4326)
    
    # Filter for the required natural features
    features = [
        'Coniferous Trees',
        'Cliff',
        'Heath',
        'Rough Grassland'
    ]
    filtered_gdf = gdf[gdf['feature_type'].isin(features)]
    
    # Assign a color to each feature type
    feature_types = filtered_gdf['feature_type'].unique()
    color_map = dict(zip(feature_types, random.sample(list(mcolors.TABLEAU_COLORS.values()), len(feature_types))))
    
    # Create a folium map centered on Exeter
    centroid = filtered_gdf.unary_union.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13)
    
    # Add each feature type as a separate layer
    for feature in feature_types:
        sub_gdf = filtered_gdf[filtered_gdf['feature_type'] == feature]
        geojson = folium.GeoJson(
            sub_gdf,
            name=feature,
            style_function=lambda x, color=color_map[feature]: {
                'fillColor': color,
                'color': color,
                'weight': 2,
                'fillOpacity': 0.5
            }
        )
        geojson.add_to(m)
    
    folium.LayerControl().add_to(m)
    map_filename = 'natural_land_features_exeter_map.html'
    m.save(map_filename)
    
    # Prepare summary
    summary = f"Plotted {len(filtered_gdf)} natural land features in Exeter. First 5 entries:\n" + \
              str(filtered_gdf[['feature_type', 'area_m2']].head(5))
    artifact_name = 'natural_land_features_exeter_map'
    artifact_description = 'A folium map showing the spatial distribution of coniferous trees, cliffs, heath, and rough grassland in Exeter.'
    return [summary, artifact_name, artifact_description, map_filename]

plot_natural_land_features_exeter
