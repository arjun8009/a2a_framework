matplotlib.use('Agg')
def analyze_natural_land_features_exeter(data: list):
    import pandas as pd
    import geopandas as gpd
    # Unpack the data
    land_natural, landform_natural = data

    # --- Coniferous Trees (from land_natural) ---
    coniferous = land_natural[
        (land_natural['description'].str.lower() == 'coniferous trees') |
        (land_natural['oslandcovertierb'].str.lower() == 'coniferous trees')
    ]

    # --- Cliffs, Heath, Rough Grassland (from landform_natural) ---
    # We'll use description column for these
    cliff = landform_natural[landform_natural['description'].str.lower() == 'cliff']
    heath = landform_natural[landform_natural['description'].str.lower().str.contains('heath', na=False)]
    rough_grassland = landform_natural[landform_natural['description'].str.lower().str.contains('rough grassland', na=False)]

    # Combine all features into a single GeoDataFrame
    features = []
    if not coniferous.empty:
        coniferous = coniferous.copy()
        coniferous['feature_type'] = 'Coniferous Trees'
        features.append(coniferous)
    if not cliff.empty:
        cliff = cliff.copy()
        cliff['feature_type'] = 'Cliff'
        features.append(cliff)
    if not heath.empty:
        heath = heath.copy()
        heath['feature_type'] = 'Heath'
        features.append(heath)
    if not rough_grassland.empty:
        rough_grassland = rough_grassland.copy()
        rough_grassland['feature_type'] = 'Rough Grassland'
        features.append(rough_grassland)

    if features:
        combined = pd.concat(features, ignore_index=True)
        # For area, use the correct column name from each source
        if 'geometry_area_m2' in combined.columns:
            combined['area_m2'] = combined['geometry_area_m2']
        elif 'geometry_area' in combined.columns:
            combined['area_m2'] = combined['geometry_area']
        else:
            combined['area_m2'] = None
        # Clean up columns for summary
        summary_cols = ['feature_type', 'description', 'area_m2', 'geometry']
        summary_gdf = gpd.GeoDataFrame(combined[summary_cols], geometry='geometry')
        summary_gdf = summary_gdf.reset_index(drop=True)
        summary = f"Distribution of natural land features: {summary_gdf['feature_type'].value_counts().to_dict()} (total {len(summary_gdf)} features)."
        return [summary, 'analyzed_natural_land_features_exeter',
                'GeoDataFrame of coniferous trees, cliffs, heath, and rough grassland in Exeter with area and geometry.',
                summary_gdf]
    else:
        return ["No relevant natural land features found.", None, None, None]

