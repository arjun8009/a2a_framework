2026-03-04 11:58:48,280 INFO Executing code import matplotlib
matplotlib.use('Agg')
def plot_buildings_with_solar_panels_exeter(data: list):
    import folium
    import geopandas as gpd
    from folium.plugins import MarkerCluster
    
    gdf = data[0].copy()
    # Ensure CRS is EPSG:4326 for folium
    if gdf.crs is not None and gdf.crs.to_epsg() != 4326:
        gdf = gdf.to_crs(epsg=4326)
    
    # Prepare map centered on Exeter
    centroid = gdf.geometry.unary_union.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13, tiles='cartodbpositron')
    
    # Add buildings as polygons
    folium.GeoJson(
        gdf,
        name='Buildings with Solar Panels',
        style_function=lambda x: {
            'fillColor': '#FFD700',
            'color': '#FF8C00',
            'weight': 1,
            'fillOpacity': 0.6
        },
        tooltip=folium.GeoJsonTooltip(fields=['description', 'buildinguse', 'roofmaterial_primarymaterial', 'numberoffloors', 'geometry_area_m2'])
    ).add_to(m)
    
    # Cluster analysis: group by area and description for summary
    summary = gdf.groupby(['description', 'buildinguse']).size().reset_index(name='count').sort_values('count', ascending=False)
    top5 = summary.head(5)
    
    # Save map
    map_filename = 'buildings_with_solar_panels_exeter_map.html'
    m.save(map_filename)
    
    # Find notable clusters (e.g., areas with >10 buildings with solar panels)
    gdf['centroid'] = gdf.geometry.centroid
    gdf['lat'] = gdf['centroid'].y
    gdf['lon'] = gdf['centroid'].x
    # Use a simple grid clustering for summary
    gdf['lat_bin'] = (gdf['lat'] * 100).astype(int)
    gdf['lon_bin'] = (gdf['lon'] * 100).astype(int)
    cluster_counts = gdf.groupby(['lat_bin', 'lon_bin']).size().reset_index(name='count')
    notable_clusters = cluster_counts[cluster_counts['count'] > 10]
    
    summary_text = (
        f"Total buildings with solar panels: {len(gdf)}.\n"
        f"Top 5 building types/uses:\n{top5.to_string(index=False)}\n"
        f"Number of notable spatial clusters (>10 buildings in a grid cell): {len(notable_clusters)}.\n"
        f"First 5 clusters (lat_bin, lon_bin, count):\n{notable_clusters.head(5).to_string(index=False)}"
    )
    
    return [
        summary_text,
        'buildings_with_solar_panels_exeter_map',
        'A folium map showing all buildings with solar panels in Exeter, colored polygons, with tooltip info. Includes summary of building types and spatial clusters.',
        map_filename
    ]

