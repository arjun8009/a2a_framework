2026-03-04 11:55:26,629 INFO Executing code import matplotlib
matplotlib.use('Agg')
def filter_exeter_polygon(data: list):
    gdf = data[0]
    # Filter for polygons where name1_text is 'Exeter' and description is 'City' or 'Town' or 'Settlement'
    filtered = gdf[(gdf['name1_text'].str.lower() == 'exeter') &
                   (gdf['description'].isin(['City', 'Town', 'Settlement']))]
    summary = f"Filtered to {len(filtered)} polygon(s) for Exeter with relevant city/town/settlement description."
    return [summary, 'filtered_exeter_polygon_data',
            'GeoDataFrame containing only the polygon(s) for Exeter, filtered by name and relevant description.', filtered]

