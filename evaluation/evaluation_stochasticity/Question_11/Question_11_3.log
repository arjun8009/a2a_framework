matplotlib.use('Agg')
def filter_buildings_with_solar_panels(data: list):
    import geopandas as gpd
    # The relevant column for solar panel presence is 'roofmaterial_solarpanelpresence'
    gdf = data[0]
    # Filter for buildings where solar panels are present
    filtered = gdf[gdf['roofmaterial_solarpanelpresence'] == 'Present']
    # Save to geojson
    filtered.to_file('buildings_with_solar_panels_exeter.geojson', driver='GeoJSON')
    summary = f"Filtered {len(filtered)} buildings with solar panels out of {len(gdf)} total buildings."
    description = "GeoDataFrame of all buildings within Exeter that have solar panels present, based on the 'roofmaterial_solarpanelpresence' column. Includes all original attributes and geometry."
    return [summary, 'buildings_with_solar_panels_exeter.geojson', description, filtered]

