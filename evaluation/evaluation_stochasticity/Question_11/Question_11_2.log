2026-03-04 11:52:56,847 INFO Executing code import matplotlib
matplotlib.use('Agg')
def filter_exeter_polygon(data: list):
    gdf = data[0]
    # Filter for polygons where the main name is 'Exeter' and the description is 'City' or 'Settlement' or 'Town'
    filtered = gdf[(gdf['name1_text'].str.lower() == 'exeter') & 
                   (gdf['description'].isin(['City', 'Settlement', 'Town']))]
    summary = f"Filtered to {len(filtered)} polygon(s) for Exeter with description as City, Settlement, or Town."
    artifact_name = 'filtered_exeter_polygon_data'
    artifact_description = 'GeoDataFrame containing only the polygon(s) for Exeter, filtered by name and relevant settlement descriptions.'
    return [summary, artifact_name, artifact_description, filtered]

