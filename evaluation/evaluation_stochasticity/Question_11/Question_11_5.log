matplotlib.use('Agg')
def filter_buildings_adjacent_to_solar_panels(data: list):
    import geopandas as gpd
    from shapely.geometry import Polygon, MultiPolygon

    # Unpack input data
    buildings = data[0]
    solar_structures = data[1]

    # Ensure both are in the same CRS
    if buildings.crs != solar_structures.crs:
        solar_structures = solar_structures.to_crs(buildings.crs)

    # Get the geometry of the solar panel structures (could be MultiPolygon)
    solar_geom = solar_structures.iloc[0].geometry

    # Find buildings that intersect or touch the solar panel structure
    # (adjacent or spatially associated)
    mask = buildings.geometry.apply(lambda x: x.intersects(solar_geom) or x.touches(solar_geom))
    filtered_buildings = buildings[mask].copy()

    # Save to file
    filtered_buildings.to_file('buildings_adjacent_to_solar_panels_exeter.geojson', driver='GeoJSON')

    summary = f"Filtered {len(filtered_buildings)} buildings that are spatially associated with or adjacent to the solar panel structures."
    artifact_name = 'buildings_adjacent_to_solar_panels_exeter'
    artifact_description = 'GeoDataFrame of buildings in Exeter that are spatially associated with or adjacent to the solar panel structures.'
    return [summary, artifact_name, artifact_description, filtered_buildings]

output = filter_buildings_adjacent_to_solar_panels(data)
