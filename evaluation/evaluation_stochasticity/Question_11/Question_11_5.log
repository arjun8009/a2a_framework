matplotlib.use('Agg')
def filter_exeter_polygon(data: list):
    gdf = data[0]
    # Filter for polygons where name1_text is 'Exeter' and descriptiongroup is relevant to settlements
    filtered = gdf[(gdf['name1_text'].str.lower() == 'exeter') & \
                   (gdf['descriptiongroup'].isin(['Settlement', 'Part Of Settlement', 'City', 'Town', 'Village']))]
    return [
        f"Filtered to {len(filtered)} polygon(s) for Exeter.",
        'filtered_exeter_polygon_data',
        'GeoDataFrame containing only the polygon(s) representing Exeter, filtered by name and relevant settlement categories.',
        filtered
    ]
