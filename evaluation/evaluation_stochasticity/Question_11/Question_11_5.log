    solar_cols = [col for col in df.columns if 'solar' in col.lower() or 'panel' in col.lower()]
    # If no such column, try searching in description columns for mentions of solar panels
    if not solar_cols:
        # Try searching in all object columns for 'solar' or 'panel' in their values
