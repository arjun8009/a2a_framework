matplotlib.use('Agg')
def filter_buildings_with_solar_panels(data: list):
    import geopandas as gpd
    df = data[0]
    # Search for columns that may indicate solar panels
    # We'll look for any column containing 'solar' or 'panel' in its name or values
    solar_cols = [col for col in df.columns if 'solar' in col.lower() or 'panel' in col.lower()]
    # If no such column, try searching in description columns for mentions of solar panels
    if not solar_cols:
        # Try searching in all object columns for 'solar' or 'panel' in their values
        mask = df.apply(lambda row: any(
            isinstance(val, str) and ('solar' in val.lower() or 'panel' in val.lower())
            for val in row
        ), axis=1)
        filtered = df[mask]
    else:
        # If there are columns, filter where any of those columns mention solar/panel
        mask = df[solar_cols].apply(lambda x: x.astype(str).str.lower().str.contains('solar|panel', na=False)).any(axis=1)
        filtered = df[mask]
    # Save to geojson
    filtered.to_file('exeter_buildings_with_solar_panels.geojson', driver='GeoJSON')
    summary = f"Filtered {len(filtered)} buildings with solar panels from {len(df)} total buildings."
    return [summary, 'exeter_buildings_with_solar_panels.geojson', 'GeoDataFrame of Exeter buildings identified as having solar panels, saved as GeoJSON.', filtered]

