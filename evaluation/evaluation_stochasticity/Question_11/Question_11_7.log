matplotlib.use('Agg')
def filter_exeter_polygon(data: list):
    gdf = data[0]
    # Filter for polygons where name1_text is 'Exeter' and descriptiongroup is likely to indicate a settlement/city
    filtered = gdf[(gdf['name1_text'].str.lower() == 'exeter') & 
                   (gdf['descriptiongroup'].isin(['Settlement', 'Part Of Settlement'])) &
                   (gdf['description'].str.lower().isin(['city', 'town', 'village', 'suburban area']))]
    # If not found, try a broader filter for 'exeter' in name1_text
    if filtered.empty:
        filtered = gdf[gdf['name1_text'].str.lower() == 'exeter']
    summary = f"Filtered polygons for Exeter. Number of matching polygons: {len(filtered)}."
    return [summary, 'filtered_exeter_polygon_data', 'GeoDataFrame containing only the polygon(s) for Exeter, filtered by name and settlement/city/town/village description.', filtered]

