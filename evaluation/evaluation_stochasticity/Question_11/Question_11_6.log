matplotlib.use('Agg')
def filter_buildings_with_solar_panels(data: list):
    # The relevant column for solar panel presence is 'roofmaterial_solarpanelpresence'
    # We consider only those with value 'Present' as having solar panels
    gdf = data[0]
    filtered = gdf[gdf['roofmaterial_solarpanelpresence'] == 'Present']
    summary = f"Filtered {len(filtered)} buildings with solar panels out of {len(gdf)} total buildings."
    artifact_name = 'buildings_with_solar_panels_exeter.geojson'
    artifact_description = (
        "GeoDataFrame of all buildings in Exeter within the polygon that have solar panels present, "
        "as indicated by the 'roofmaterial_solarpanelpresence' column. Includes all original attributes and geometry."
    )
    return [summary, artifact_name, artifact_description, filtered]

