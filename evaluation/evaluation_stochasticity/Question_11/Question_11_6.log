matplotlib.use('Agg')
def filter_exeter_polygon(data: list):
    gdf = data[0]
    # Filter for Exeter using multiple relevant columns for high quality
    filtered = gdf[
        (
            (gdf['name1_text'].str.lower() == 'exeter') &
            (gdf['descriptiongroup'].isin(['Settlement', 'Other Name', 'Land Name', 'Part Of Settlement', 'City', 'Town', 'Suburban Area'])) &
            (gdf['description'].str.lower().isin(['city', 'town', 'suburban area', 'part of settlement', 'named other geographic area']))
        )
    ]
    summary = f"Filtered Exeter polygon: {len(filtered)} entries found."
    artifact_name = 'filtered_exeter_polygon'
    artifact_description = 'Polygon(s) representing the area of Exeter, filtered by name and relevant settlement/area categories.'
    return [summary, artifact_name, artifact_description, filtered]

