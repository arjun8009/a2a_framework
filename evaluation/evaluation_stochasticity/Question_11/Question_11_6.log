matplotlib.use('Agg')
def plot_buildings_with_solar_panels_exeter(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import mapping
    
    # Unpack data
    buildings_gdf = data[0].copy()
    exeter_poly_gdf = data[1].copy()
    
    # Ensure CRS is EPSG:4326 for folium
    if buildings_gdf.crs is not None and buildings_gdf.crs.to_epsg() != 4326:
        buildings_gdf = buildings_gdf.to_crs(epsg=4326)
    if exeter_poly_gdf.crs is not None and exeter_poly_gdf.crs.to_epsg() != 4326:
        exeter_poly_gdf = exeter_poly_gdf.to_crs(epsg=4326)
    
    # Clip buildings to Exeter boundary (should already be, but for safety)
    exeter_boundary = exeter_poly_gdf.iloc[0].geometry
    buildings_in_exeter = buildings_gdf[buildings_gdf.geometry.within(exeter_boundary)]
    
    # Create folium map centered on Exeter
    centroid = exeter_boundary.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13, tiles='cartodbpositron')
    
    # Add Exeter boundary
    folium.GeoJson(
        mapping(exeter_boundary),
        name='Exeter Boundary',
        style_function=lambda x: {'color': 'blue', 'weight': 3, 'fillOpacity': 0.05}
    ).add_to(m)
    
    # Add buildings with solar panels
    folium.GeoJson(
        buildings_in_exeter,
        name='Buildings with Solar Panels',
        style_function=lambda x: {'color': 'orange', 'weight': 1, 'fillOpacity': 0.4},
        tooltip=folium.GeoJsonTooltip(fields=['description', 'buildinguse', 'roofmaterial_primarymaterial'])
    ).add_to(m)
    
    folium.LayerControl().add_to(m)
    
    # Save map
    map_filename = 'buildings_with_solar_panels_exeter_map.html'
    m.save(map_filename)
    
    # Prepare summary
    summary_rows = buildings_in_exeter[['description', 'buildinguse', 'roofmaterial_primarymaterial']].head(5)
    summary = f"Plotted {len(buildings_in_exeter)} buildings with solar panels in Exeter. First 5:\n" + summary_rows.to_string(index=False)
    
    return [summary, map_filename, "Folium map showing buildings with solar panels in Exeter overlaid with the Exeter city boundary. Buildings are orange polygons, boundary is blue.", map_filename]

