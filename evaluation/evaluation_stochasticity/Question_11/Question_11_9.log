matplotlib.use('Agg')
def filter_exeter_polygon(data: list):
    gdf = data[0]
    # Filter for polygons where name1_text is 'Exeter' and descriptiongroup is likely to indicate a settlement/city
    filtered = gdf[(gdf['name1_text'].str.lower() == 'exeter') & \
                  (gdf['descriptiongroup'].isin(['Settlement', 'Part Of Settlement', 'City', 'Town']))]
    return [
        f"Filtered polygons for Exeter. Number of matching entries: {len(filtered)}.",
        'filtered_exeter_polygon_data',
        'GeoDataFrame containing only the polygon(s) for Exeter, filtered by name and relevant description group.',
        filtered
    ]
