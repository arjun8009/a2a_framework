matplotlib.use('Agg')
def plot_exeter_buildings_with_solar_panels(data: list):
    import folium
    import geopandas as gpd
    # Get the GeoDataFrame
    gdf = data[0]
    # Ensure CRS is EPSG:4326 for folium
    if gdf.crs is not None and gdf.crs.to_epsg() != 4326:
        gdf = gdf.to_crs(epsg=4326)
    # Center map on Exeter (approximate center from data bounds)
    centroid = gdf.geometry.unary_union.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13, tiles='cartodbpositron')
    # Add buildings polygons
    folium.GeoJson(
        gdf,
        name='Buildings with Solar Panels',
        style_function=lambda x: {
            'fillColor': '#FFD700',
            'color': '#FF8C00',
            'weight': 1,
            'fillOpacity': 0.6
        },
        tooltip=folium.GeoJsonTooltip(fields=['description', 'buildinguse', 'roofmaterial_primarymaterial', 'numberoffloors'],
                                      aliases=['Description', 'Building Use', 'Roof Material', 'Floors'])
    ).add_to(m)
    m.save('exeter_buildings_with_solar_panels_map.html')
    # Prepare summary
    preview = gdf[['description', 'buildinguse', 'roofmaterial_primarymaterial', 'numberoffloors']].head(5)
    summary = f"Plotted {len(gdf)} buildings in Exeter with solar panels. First 5 entries:\n{preview.to_string(index=False)}"
    artifact_name = 'exeter_buildings_with_solar_panels_map.html'
    artifact_description = 'A folium map showing the locations and outlines of all buildings in Exeter that have solar panels.'
    return [summary, artifact_name, artifact_description, artifact_name]

