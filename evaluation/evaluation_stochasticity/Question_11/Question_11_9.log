matplotlib.use('Agg')
def filter_buildings_with_solar_panels(data: list):
    import geopandas as gpd
    # The relevant column for solar panel presence is 'roofmaterial_solarpanelpresence'
    gdf = data[0]
    # Filter for buildings where solar panels are present
