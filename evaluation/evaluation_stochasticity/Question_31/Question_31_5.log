2026-03-05 08:27:57,937 INFO Executing code import matplotlib
matplotlib.use('Agg')
import folium
import geopandas as gpd
from shapely.geometry import Polygon

def plot_special_education_needs_schools_exeter(data: list):
    # Unpack the data
    schools_gdf = data[0].copy()
    exeter_gdf = data[1].copy()

    # Ensure CRS is EPSG:4326 for folium
    if schools_gdf.crs is None or schools_gdf.crs.to_epsg() != 4326:
        schools_gdf = schools_gdf.to_crs(epsg=4326)
    if exeter_gdf.crs is None or exeter_gdf.crs.to_epsg() != 4326:
        exeter_gdf = exeter_gdf.to_crs(epsg=4326)

    # Get centroid of Exeter for map centering
    exeter_centroid = exeter_gdf.geometry.centroid.iloc[0]
    m = folium.Map(location=[exeter_centroid.y, exeter_centroid.x], zoom_start=12, tiles='cartodbpositron')

    # Plot Exeter boundary
    folium.GeoJson(
        exeter_gdf.geometry.iloc[0],
        name='Exeter Boundary',
        style_function=lambda x: {'color': 'blue', 'weight': 3, 'fillOpacity': 0.05}
    ).add_to(m)

    # Plot each special education needs school site
    for idx, row in schools_gdf.iterrows():
        folium.GeoJson(
            row['geometry'],
            name=row['name1_text'],
            style_function=lambda x: {'color': 'red', 'weight': 2, 'fillOpacity': 0.3}
        ).add_to(m)
        # Add a popup with the school name
        folium.Popup(row['name1_text']).add_to(
            folium.Marker(
                location=[row['geometry'].centroid.y, row['geometry'].centroid.x],
                icon=folium.Icon(color='red', icon='info-sign')
            ).add_to(m)
        )

    m.save('special_education_needs_schools_exeter_map.html')

    # Prepare summary
    summary_rows = schools_gdf[['name1_text', 'geometry_area_m2']].head(5)
    summary = f"Plotted {len(schools_gdf)} special education needs school sites in Exeter. First 5: " + ", ".join(summary_rows['name1_text'])
    artifact_name = 'special_education_needs_schools_exeter_map.html'
    artifact_description = 'Folium map showing the boundary of Exeter and the locations of special education needs school sites.'
    artifact_data = artifact_name
    return [summary, artifact_name, artifact_description, artifact_data]

# The function will be called by the system with the correct data

