matplotlib.use('Agg')
def filter_special_education_needs_schools(data: list):
    gdf = data[0]
    # Filter for special education needs schools using oslandusetierb
    filtered = gdf[gdf['oslandusetierb'].str.contains('Special Needs', case=False, na=False)]
    summary = f"Filtered special education needs school sites: {len(filtered)} entries found."
    artifact_name = 'filtered_special_education_needs_schools_exeter'
    artifact_description = 'GeoDataFrame containing only the special education needs school sites in Exeter, filtered using the oslandusetierb column.'
    return [summary, artifact_name, artifact_description, filtered]

