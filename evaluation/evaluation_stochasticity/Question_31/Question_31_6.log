matplotlib.use('Agg')
def plot_special_education_needs_schools_within_exeter(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import mapping
    
    # Unpack data
    schools = data[0]
    exeter_poly = data[1]
    
    # Ensure both are in the same CRS (EPSG:4326 for folium)
    if schools.crs != 'EPSG:4326':
        schools = schools.to_crs('EPSG:4326')
    if exeter_poly.crs != 'EPSG:4326':
        exeter_poly = exeter_poly.to_crs('EPSG:4326')
    
    # Get the Exeter polygon geometry
    exeter_geom = exeter_poly.iloc[0].geometry
    
    # Filter schools that are within the Exeter polygon
    schools_within = schools[schools.geometry.within(exeter_geom)]
    
    # Create a folium map centered on Exeter
    centroid = exeter_geom.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=12)
    
    # Add Exeter area polygon
    folium.GeoJson(mapping(exeter_geom), name='Exeter Area', style_function=lambda x: {'fillColor': '#00000020', 'color': 'blue', 'weight': 2}).add_to(m)
    
    # Add special education needs schools
    for idx, row in schools_within.iterrows():
        # Use the centroid of the school polygon for marker
        school_centroid = row.geometry.centroid
        folium.Marker(
            location=[school_centroid.y, school_centroid.x],
            popup=f"{row['name1_text']}<br>Area: {row['geometry_area_m2']:.1f} m²",
            icon=folium.Icon(color='red', icon='info-sign')
        ).add_to(m)
        # Also add the school polygon outline
        folium.GeoJson(mapping(row.geometry), name=row['name1_text'], style_function=lambda x: {'fillColor': '#ff000020', 'color': 'red', 'weight': 2}).add_to(m)
    
    # Save map
    map_filename = 'special_education_needs_schools_within_exeter.html'
    m.save(map_filename)
    
    # Prepare summary
    n = len(schools_within)
    summary_rows = schools_within[['name1_text', 'geometry_area_m2']].head(5).to_dict('records')
    summary = f"{n} special education needs school site(s) found within the Exeter area. First 5: {summary_rows}"
    
    return [summary, 'special_education_needs_schools_within_exeter_map', 'Folium map showing special education needs school sites within the Exeter area polygon, with school names and areas.', map_filename]

