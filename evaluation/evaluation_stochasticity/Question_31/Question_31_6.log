matplotlib.use('Agg')
def filter_special_education_needs_schools(data: list):
    gdf = data[0]
    # Filter for school sites with special education needs using both description and oslandusetierb columns
    # We'll look for relevant keywords in both columns
    mask = (
        (gdf['description'].str.contains('special', case=False, na=False) &
         gdf['description'].str.contains('education', case=False, na=False)) |
        (gdf['oslandusetierb'].str.contains('special', case=False, na=False) &
         gdf['oslandusetierb'].str.contains('education', case=False, na=False)) |
        (gdf['oslandusetierb'].str.contains('special needs', case=False, na=False)) |
        (gdf['oslandusetierb'].str.contains('special educational needs', case=False, na=False))
    )
    filtered = gdf[mask]
    summary = f"Filtered special education needs school sites: {len(filtered)} entries found."
    artifact_name = 'special_education_needs_schools_exeter'
    artifact_description = (
        "GeoDataFrame of land use sites in Exeter identified as special education needs schools, "
        "filtered using both the 'description' and 'oslandusetierb' columns for relevant keywords."
    )
    return [summary, artifact_name, artifact_description, filtered]

