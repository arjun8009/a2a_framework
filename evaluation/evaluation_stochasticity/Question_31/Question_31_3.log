matplotlib.use('Agg')
def filter_special_education_needs_schools(data: list):
    gdf = data[0]
    # Filter for special education needs schools using oslandusetierb
    filtered = gdf[gdf['oslandusetierb'].str.contains('Special Needs', case=False, na=False)]
    summary = f"Filtered {len(filtered)} special education needs school site(s) from {len(gdf)} total entries in Exeter."
    artifact_name = 'filtered_special_education_needs_schools_exeter'
    artifact_description = (
        "A GeoDataFrame containing only the school sites in Exeter identified as 'School For Special Needs' "
        "according to the 'oslandusetierb' column. Includes all available attributes and geometry."
    )
    return [summary, artifact_name, artifact_description, filtered]

