2026-03-05 08:23:43,454 INFO Executing code import matplotlib
matplotlib.use('Agg')
def plot_special_education_needs_school_sites(data: list):
    import folium
    import geopandas as gpd
    from shapely.geometry import mapping
    
    gdf = data[0].copy()
    # Ensure CRS is EPSG:4326 for folium
    if gdf.crs is not None and gdf.crs.to_epsg() != 4326:
        gdf = gdf.to_crs(epsg=4326)
    
    # Create folium map centered on the mean location
    centroid = gdf.geometry.centroid.unary_union.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=12)
    
    # Add polygons for each school
    for idx, row in gdf.iterrows():
        folium.GeoJson(
            mapping(row['geometry']),
            name=row['name1_text'],
            tooltip=f"{row['name1_text']}<br>Area: {row['geometry_area_m2']:.0f} m²"
        ).add_to(m)
        folium.Marker(
            location=[row['geometry'].centroid.y, row['geometry'].centroid.x],
            popup=row['name1_text'],
            icon=folium.Icon(color='blue', icon='info-sign')
        ).add_to(m)
    
    # Save map
    map_filename = 'special_education_needs_schools_exeter_map.html'
    m.save(map_filename)
    
    # Prepare summary
    summary_rows = gdf[['name1_text', 'geometry_area_m2', 'address_primarydescription', 'status']].head(5)
    summary = (
        f"There are {len(gdf)} special education needs school sites in Exeter. "
        f"First 5 schools: "
        + ", ".join(summary_rows['name1_text']) + ". "
        "All sites are currently active. Areas range from "
        f"{gdf['geometry_area_m2'].min():.0f} m² to {gdf['geometry_area_m2'].max():.0f} m²."
    )
    
    return [
        summary,
        'special_education_needs_schools_exeter_map',
        'A folium map showing the locations and boundaries of special education needs school sites in Exeter. Each site is shown as a polygon with a marker and tooltip containing the school name and area.',
        map_filename
    ]

