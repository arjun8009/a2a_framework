    artifact_name = 'filtered_special_education_needs_schools_exeter'
    artifact_description = (
        "A GeoDataFrame containing only the special education needs school sites in Exeter, "
        "filtered using the 'oslandusetierb' column for relevant categories."
    )
    return [summary, artifact_name, artifact_description, filtered]

