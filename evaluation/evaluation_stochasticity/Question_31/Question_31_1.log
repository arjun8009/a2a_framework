    <i style="background:{};width:18px;height:18px;float:left;margin-right:8px;opacity:0.7;"></i> Special Education Needs Schools<br>
    </div>
    '''.format(land_color, landform_color, sen_color)
    m.get_root().html.add_child(folium.Element(legend_html))

    # Add layer control
    folium.LayerControl().add_to(m)

    # Save map
    map_filename = 'exeter_natural_areas_and_sen_schools_map.html'
    m.save(map_filename)

    # Prepare summary
    summary = (
        f"Map of Exeter showing: "
        f"\n- {len(gdf_land)} natural land features (e.g., {gdf_land['description'].unique()[:3]})"
        f"\n- {len(gdf_landform)} natural landforms (e.g., {gdf_landform['description'].unique()[:3]})"
        f"\n- {len(gdf_sen)} special education needs schools (first 5: {gdf_sen['name1_text'].head(5).tolist()})"
    )
    artifact_desc = (
        "Folium map showing all natural land features and landforms in Exeter, "
        "as well as all special education needs school sites. Each feature type is colored distinctly and a legend is provided. "
        "Pop-up tooltips provide further details for each feature."
    )
    return [summary, 'exeter_natural_areas_and_sen_schools_map', artifact_desc, map_filename]

