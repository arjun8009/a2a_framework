matplotlib.use('Agg')
def plot_natural_areas_and_sen_schools(data: list):
    import geopandas as gpd
    import folium
    from folium import features
    import branca
    
    # Unpack data
    gdf_land = data[0].copy()
    gdf_landform = data[1].copy()
    gdf_sen = data[2].copy()
    
    # Ensure all are in EPSG:4326
    gdf_land = gdf_land.to_crs(epsg=4326)
    gdf_landform = gdf_landform.to_crs(epsg=4326)
    gdf_sen = gdf_sen.to_crs(epsg=4326)

    # Get centroid of all data for map center
    all_bounds = gdf_land.total_bounds
    all_bounds2 = gdf_landform.total_bounds
    all_bounds3 = gdf_sen.total_bounds
    minx = min(all_bounds[0], all_bounds2[0], all_bounds3[0])
    miny = min(all_bounds[1], all_bounds2[1], all_bounds3[1])
    maxx = max(all_bounds[2], all_bounds2[2], all_bounds3[2])
    maxy = max(all_bounds[3], all_bounds2[3], all_bounds3[3])
    center = [(miny+maxy)/2, (minx+maxx)/2]

    # Create folium map
    m = folium.Map(location=center, zoom_start=13, tiles='cartodbpositron')

    # Color for each layer
    land_color = '#228B22'  # ForestGreen
    landform_color = '#8B4513'  # SaddleBrown
    sen_color = '#1E90FF'  # DodgerBlue

    # Add land natural features polygons
    folium.GeoJson(
        gdf_land,
        name='Natural Land Features',
        style_function=lambda x: {
            'fillColor': land_color,
            'color': land_color,
            'weight': 1,
            'fillOpacity': 0.4
        },
        tooltip=folium.GeoJsonTooltip(fields=['description', 'oslandcovertiera', 'oslandcovertierb'],
                                        aliases=['Description', 'Land Cover Tier A', 'Land Cover Tier B'])
    ).add_to(m)

    # Add landform polygons
    folium.GeoJson(
        gdf_landform,
        name='Natural Landforms',
        style_function=lambda x: {
            'fillColor': landform_color,
            'color': landform_color,
            'weight': 1,
            'fillOpacity': 0.5
        },
        tooltip=folium.GeoJsonTooltip(fields=['description'], aliases=['Landform Description'])
    ).add_to(m)

    # Add SEN schools polygons
    folium.GeoJson(
        gdf_sen,
        name='Special Education Needs Schools',
        style_function=lambda x: {
            'fillColor': sen_color,
            'color': sen_color,
            'weight': 2,
            'fillOpacity': 0.7
        },
        tooltip=folium.GeoJsonTooltip(fields=['name1_text', 'description', 'oslandusetierb'],
                                        aliases=['School Name', 'Description', 'Land Use Tier B'])
    ).add_to(m)

    # Add legend using branca
    legend_html = '''
    <div style="position: fixed; 
                bottom: 50px; left: 50px; width: 270px; height: 120px; 
                border:2px solid grey; z-index:9999; font-size:14px;
                background-color: white; opacity: 0.95; padding: 10px;">
    <b>Legend</b><br>
    <i style="background:{};width:18px;height:18px;float:left;margin-right:8px;opacity:0.7;"></i> Natural Land Features<br>
    <i style="background:{};width:18px;height:18px;float:left;margin-right:8px;opacity:0.7;"></i> Natural Landforms<br>
    <i style="background:{};width:18px;height:18px;float:left;margin-right:8px;opacity:0.7;"></i> Special Education Needs Schools<br>
    </div>
    '''.format(land_color, landform_color, sen_color)
    m.get_root().html.add_child(folium.Element(legend_html))

    # Add layer control
    folium.LayerControl().add_to(m)

    # Save map
    map_filename = 'exeter_natural_areas_and_sen_schools_map.html'
    m.save(map_filename)

    # Prepare summary
    summary = (
        f"Map of Exeter showing: "
        f"\n- {len(gdf_land)} natural land features (e.g., {gdf_land['description'].unique()[:3]})"
        f"\n- {len(gdf_landform)} natural landforms (e.g., {gdf_landform['description'].unique()[:3]})"
        f"\n- {len(gdf_sen)} special education needs schools (first 5: {gdf_sen['name1_text'].head(5).tolist()})"
    )
    artifact_desc = (
        "Folium map showing all natural land features and landforms in Exeter, "
        "as well as all special education needs school sites. Each feature type is colored distinctly and a legend is provided. "
        "Pop-up tooltips provide further details for each feature."
    )
    return [summary, 'exeter_natural_areas_and_sen_schools_map', artifact_desc, map_filename]

