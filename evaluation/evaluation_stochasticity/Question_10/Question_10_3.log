matplotlib.use('Agg')
def plot_buildings_between_1km_2km_from_university(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import Point
    from shapely.ops import unary_union
    import os

    # Unpack data
    buildings_gdf = data[0].copy()
    university_gdf = data[1].copy()

    # Ensure CRS is projected for distance calculations (British National Grid: EPSG:27700)
    if buildings_gdf.crs is None:
        buildings_gdf.set_crs(epsg=27700, inplace=True)
    else:
        buildings_gdf = buildings_gdf.to_crs(epsg=27700)
    if university_gdf.crs is None:
        university_gdf.set_crs(epsg=27700, inplace=True)
    else:
        university_gdf = university_gdf.to_crs(epsg=27700)

    # Get the centroid of all university points (for a single reference point)
    university_point = unary_union(university_gdf.geometry)
    if university_point.geom_type == 'MultiPoint':
        university_point = university_point.centroid
    elif university_point.geom_type == 'GeometryCollection':
        # fallback: take centroid of all points
        university_point = unary_union([g for g in university_gdf.geometry if g.geom_type == 'Point']).centroid

    # Create 1km and 2km buffers
    buffer_1km = university_point.buffer(1000)
    buffer_2km = university_point.buffer(2000)

    # Select buildings between 1km and 2km
    buildings_gdf['centroid'] = buildings_gdf.geometry.centroid
    buildings_gdf['dist_to_uni'] = buildings_gdf['centroid'].distance(university_point)
    mask = (buildings_gdf['dist_to_uni'] >= 1000) & (buildings_gdf['dist_to_uni'] <= 2000)
    buildings_ring = buildings_gdf[mask].copy()

    # Convert everything to EPSG:4326 for folium
    buildings_ring = buildings_ring.to_crs(epsg=4326)
    university_gdf = university_gdf.to_crs(epsg=4326)
    buffer_1km_4326 = gpd.GeoSeries([buffer_1km], crs=27700).to_crs(epsg=4326).iloc[0]
    buffer_2km_4326 = gpd.GeoSeries([buffer_2km], crs=27700).to_crs(epsg=4326).iloc[0]

    # Center map on university
    uni_latlon = [university_gdf.geometry.iloc[0].y, university_gdf.geometry.iloc[0].x]
    m = folium.Map(location=uni_latlon, zoom_start=13, tiles='cartodbpositron')

    # Plot 2km ring
    folium.GeoJson(buffer_2km_4326, name='2km Ring', style_function=lambda x: {'color': 'blue', 'fill': False, 'weight': 2, 'dashArray': '10,10'}).add_to(m)
    # Plot 1km ring
    folium.GeoJson(buffer_1km_4326, name='1km Ring', style_function=lambda x: {'color': 'red', 'fill': False, 'weight': 2, 'dashArray': '5,5'}).add_to(m)

    # Plot university location(s)
    for idx, row in university_gdf.iterrows():
        folium.Marker([row.geometry.y, row.geometry.x], popup=row['name'] if 'name' in row else 'University of Exeter', icon=folium.Icon(color='green', icon='university', prefix='fa')).add_to(m)

    # Plot buildings in the ring (no tooltip fields to avoid error)
    folium.GeoJson(
        buildings_ring,
        name='Buildings 1-2km',
        style_function=lambda x: {'color': 'orange', 'fillColor': 'orange', 'weight': 2, 'fillOpacity': 0.4}
    ).add_to(m)

    m.save('buildings_1km_2km_ring_map.html')

    summary = f"Plotted {len(buildings_ring)} buildings between 1km and 2km from the University of Exeter. First 5: "
    summary += str(buildings_ring[['description', 'buildinguse', 'geometry_area_m2']].head(5).to_dict('records'))
    artifact_name = 'buildings_1km_2km_ring_map.html'
    artifact_description = 'Folium map showing buildings between 1km and 2km from the University of Exeter, with 1km and 2km rings highlighted.'
    return [summary, artifact_name, artifact_description, artifact_name]

