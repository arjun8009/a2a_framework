matplotlib.use('Agg')
def plot_buildings_between_1km_2km_from_university(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import Point
    
    # Unpack data
    buildings = data[0].copy()
    university_points = data[1].copy()
    
    # Ensure CRS is projected for distance calculation (meters)
    if buildings.crs is None:
        buildings.set_crs(epsg=27700, inplace=True)  # Assume British National Grid if missing
    if university_points.crs is None:
        university_points.set_crs(epsg=27700, inplace=True)
    
    # Reproject to British National Grid for accurate distance calculation
    buildings = buildings.to_crs(epsg=27700)
    university_points = university_points.to_crs(epsg=27700)
    
    # Use all university points as possible reference points
    university_union = university_points.unary_union
    
    # Create 1km and 2km buffers
    buffer_1km = gpd.GeoSeries([university_union.buffer(1000)], crs=buildings.crs)
    buffer_2km = gpd.GeoSeries([university_union.buffer(2000)], crs=buildings.crs)
    ring = gpd.GeoSeries([buffer_2km.iloc[0].difference(buffer_1km.iloc[0])], crs=buildings.crs)
    
    # Filter buildings whose centroid falls within the ring
    buildings['centroid'] = buildings.geometry.centroid
    buildings_in_ring = buildings[buildings['centroid'].apply(lambda x: ring.iloc[0].contains(x))].copy()
    
    # Prepare for plotting: convert everything to EPSG:4326
    buildings_in_ring = buildings_in_ring.set_geometry('geometry').to_crs(epsg=4326)
    buffer_1km = buffer_1km.to_crs(epsg=4326)
    buffer_2km = buffer_2km.to_crs(epsg=4326)
    ring = ring.to_crs(epsg=4326)
    university_points = university_points.to_crs(epsg=4326)
    
    # Create folium map centered at the mean of university points
    center_lat = university_points.geometry.y.mean()
    center_lon = university_points.geometry.x.mean()
    m = folium.Map(location=[center_lat, center_lon], zoom_start=13)
    
    # Plot 1km and 2km buffers
    folium.GeoJson(buffer_1km.iloc[0], name='1km Buffer', style_function=lambda x: {'color': 'blue', 'fill': False, 'weight': 2, 'dashArray': '5, 5'}).add_to(m)
    folium.GeoJson(buffer_2km.iloc[0], name='2km Buffer', style_function=lambda x: {'color': 'red', 'fill': False, 'weight': 2, 'dashArray': '5, 5'}).add_to(m)
    folium.GeoJson(ring.iloc[0], name='1-2km Ring', style_function=lambda x: {'color': 'purple', 'fill': True, 'fillOpacity': 0.1, 'weight': 1}).add_to(m)
    
    # Plot university points
    for idx, row in university_points.iterrows():
        folium.Marker(location=[row.geometry.y, row.geometry.x], popup=row['name'] if 'name' in row else 'University Point', icon=folium.Icon(color='green', icon='university', prefix='fa')).add_to(m)
    
    # Plot buildings in ring
    folium.GeoJson(buildings_in_ring.set_geometry('geometry'), name='Buildings 1-2km', style_function=lambda x: {'color': 'orange', 'fill': True, 'fillOpacity': 0.4, 'weight': 1}).add_to(m)
    
    folium.LayerControl().add_to(m)
    
    # Save map
    map_filename = 'buildings_1km_2km_from_university.html'
    m.save(map_filename)
    
    # Prepare summary
    summary_rows = buildings_in_ring[['osid', 'description', 'buildinguse', 'geometry_area_m2']].head(5)
    summary = f"Found {len(buildings_in_ring)} buildings between 1km and 2km from any University of Exeter location. First 5 results:\n" + summary_rows.to_string(index=False)
    
    return [summary, map_filename, "Folium map showing all buildings between 1km and 2km from any University of Exeter location, with buffers and university points marked. Only buildings within this ring are shown.", map_filename]

