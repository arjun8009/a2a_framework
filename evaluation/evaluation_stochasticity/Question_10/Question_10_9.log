matplotlib.use('Agg')
def filter_university_of_exeter_location(data: list):
    gdf = data[0]
    # Filter for University of Exeter using multiple relevant columns for best match
    filtered = gdf[
        (
            (gdf['organisationname'].str.contains('University of Exeter', case=False, na=False)) |
            (gdf['fulladdress'].str.contains('University of Exeter', case=False, na=False)) |
            (gdf['name'].str.contains('University of Exeter', case=False, na=False))
        ) &
        (gdf['townname'].str.upper() == 'EXETER')
    ]
    return [
        f"Filtered locations for 'University of Exeter'. Number of entries: {len(filtered)}.",
        'filtered_university_of_exeter_location',
        "A GeoDataFrame containing only the point locations specifically for 'University of Exeter' in Exeter, filtered using organisationname, fulladdress, and name columns.",
        filtered
    ]
