matplotlib.use('Agg')
def plot_buildings_between_1km_2km_from_university(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import Point
    
    # Unpack data
    buildings = data[0]
    university = data[1]
    
    # Ensure CRS is projected for distance calculations (assume British National Grid EPSG:27700)
    if buildings.crs is None or buildings.crs.to_epsg() != 27700:
        buildings = buildings.to_crs(epsg=27700)
    if university.crs is None or university.crs.to_epsg() != 27700:
        university = university.to_crs(epsg=27700)
    
    # Get the university location as a representative point (mean of multipoint)
    uni_geom = university.iloc[0].geometry
    if uni_geom.geom_type == 'MultiPoint':
        uni_point = Point([p.x for p in uni_geom.geoms], [p.y for p in uni_geom.geoms]).centroid
    else:
        uni_point = uni_geom.centroid
    
    # Create 1km and 2km buffers
    buffer_1km = uni_point.buffer(1000)
    buffer_2km = uni_point.buffer(2000)
    ring = buffer_2km.difference(buffer_1km)
    
    # Select buildings whose centroid falls within the ring
    buildings['centroid'] = buildings.geometry.centroid
    buildings_in_ring = buildings[buildings['centroid'].within(ring)].copy()
    
    # Convert everything to EPSG:4326 for folium
    buildings_in_ring = buildings_in_ring.set_geometry('geometry').to_crs(epsg=4326)
    buffer_1km_gdf = gpd.GeoDataFrame(geometry=[buffer_1km], crs='EPSG:27700').to_crs(epsg=4326)
    buffer_2km_gdf = gpd.GeoDataFrame(geometry=[buffer_2km], crs='EPSG:27700').to_crs(epsg=4326)
    ring_gdf = gpd.GeoDataFrame(geometry=[ring], crs='EPSG:27700').to_crs(epsg=4326)
    uni_point_gdf = gpd.GeoDataFrame(geometry=[uni_point], crs='EPSG:27700').to_crs(epsg=4326)
    
    # Create folium map
    center = [uni_point_gdf.geometry.y[0], uni_point_gdf.geometry.x[0]]
    m = folium.Map(location=center, zoom_start=13)
    
    # Plot 1km and 2km buffers
    folium.GeoJson(buffer_1km_gdf.geometry.iloc[0], name='1km Buffer', style_function=lambda x: {'color': 'blue', 'fill': False, 'weight': 2}).add_to(m)
    folium.GeoJson(buffer_2km_gdf.geometry.iloc[0], name='2km Buffer', style_function=lambda x: {'color': 'red', 'fill': False, 'weight': 2}).add_to(m)
    folium.GeoJson(ring_gdf.geometry.iloc[0], name='1-2km Ring', style_function=lambda x: {'color': 'green', 'fill': True, 'fillOpacity': 0.1, 'weight': 1}).add_to(m)
    
    # Plot university point
    folium.Marker(location=center, popup='University of Exeter', icon=folium.Icon(color='purple')).add_to(m)
    
    # Plot buildings
    for _, row in buildings_in_ring.iterrows():
        folium.GeoJson(row.geometry, style_function=lambda x: {'color': 'orange', 'weight': 1, 'fillOpacity': 0.3}).add_to(m)
    
    m.save('buildings_1km_2km_from_university.html')
    
    # Prepare summary
    summary_rows = buildings_in_ring[['osid', 'description', 'buildinguse', 'geometry_area_m2']].head(5)
    summary = f"Found {len(buildings_in_ring)} buildings between 1km and 2km from the University of Exeter. First 5 results:\n" + summary_rows.to_string(index=False)
    
    return [summary, 'buildings_1km_2km_from_university_map', 'Folium map showing all buildings between 1km and 2km from the University of Exeter, with 1km and 2km buffers and the university location.', 'buildings_1km_2km_from_university.html']

output = plot_buildings_between_1km_2km_from_university(data)
