matplotlib.use('Agg')
def filter_university_of_exeter_location(data: list):
    gdf = data[0]
    # Filter for rows that are likely to represent the University of Exeter location
    # Use multiple columns for accuracy: streetname, townname, locality, snnauthoritydescription
    filtered = gdf[
        (
            gdf['streetname'].str.contains('UNIVERSITY', case=False, na=False)
            | gdf['locality'].str.contains('UNIVERSITY', case=False, na=False)
        )
        & (gdf['townname'].str.upper() == 'EXETER')
        & (gdf['snnauthoritydescription'].str.upper() == 'EXETER')
    ]
    summary = f"Filtered {len(filtered)} entries for 'University of Exeter' location."
    artifact_name = 'filtered_university_of_exeter_location'
    artifact_description = (
        "GeoDataFrame containing only the point(s) or street(s) specifically associated with the University of Exeter, "
        "filtered using streetname, locality, townname, and authority columns."
    )
    return [summary, artifact_name, artifact_description, filtered]

