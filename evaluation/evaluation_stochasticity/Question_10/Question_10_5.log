matplotlib.use('Agg')
def filter_exeter_polygon(data: list):
    gdf = data[0]
    # Filter for polygons where any name column matches 'Exeter' and descriptiongroup/description are relevant
    mask = (
        (gdf['name1_text'].str.lower() == 'exeter') |
        (gdf['name2_text'].str.lower() == 'exeter') |
        (gdf['name3_text'].str.lower() == 'exeter') |
        (gdf['name4_text'].str.lower() == 'exeter')
    )
    # Further restrict to relevant description groups for settlements/cities/towns
    mask = mask & (
        gdf['descriptiongroup'].isin(['Settlement', 'Other Name', 'Land Name']) |
        gdf['description'].str.lower().isin(['city', 'town', 'suburban area', 'village', 'part of settlement'])
    )
    filtered = gdf[mask]
    summary = f"Filtered polygons for 'Exeter'. Number of matching polygons: {len(filtered)}."
    artifact_name = 'filtered_exeter_polygon_data'
    artifact_description = "GeoDataFrame containing only the polygon(s) corresponding to 'Exeter', filtered using all name columns and relevant description groups."
    return [summary, artifact_name, artifact_description, filtered]

