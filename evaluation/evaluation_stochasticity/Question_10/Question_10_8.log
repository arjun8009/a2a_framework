matplotlib.use('Agg')
def plot_buildings_between_1km_2km_from_university(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import Point
    from shapely.ops import nearest_points
    
    # Unpack data
    buildings = data[0].copy()
    university = data[1].copy()
    
    # Ensure CRS is set and convert to EPSG:4326 for folium
    if buildings.crs is None:
        buildings.set_crs(epsg=27700, inplace=True)  # Assume British National Grid if not set
    if university.crs is None:
        university.set_crs(epsg=27700, inplace=True)
    buildings = buildings.to_crs(epsg=4326)
    university = university.to_crs(epsg=4326)
    
    # Get the university point (use the first point in the multipoint geometry)
    uni_geom = university.iloc[0].geometry
    if uni_geom.geom_type == 'MultiPoint':
        uni_point = list(uni_geom.geoms)[0]
    elif uni_geom.geom_type == 'Point':
        uni_point = uni_geom
    else:
        raise ValueError('University geometry is not a point or multipoint')
    
    # Convert university point to EPSG:4326 for distance calculation in meters
    uni_point_27700 = gpd.GeoSeries([uni_point], crs=4326).to_crs(epsg=27700).iloc[0]
    buildings_27700 = buildings.to_crs(epsg=27700)
    
    # Calculate distance from each building to the university point (in meters)
    buildings_27700['distance_to_uni'] = buildings_27700.geometry.centroid.distance(uni_point_27700)
    
    # Filter buildings between 1km and 2km
    filtered_buildings = buildings_27700[(buildings_27700['distance_to_uni'] >= 1000) & (buildings_27700['distance_to_uni'] <= 2000)]
    filtered_buildings = filtered_buildings.to_crs(epsg=4326)
    
    # Create buffer polygons for 1km and 2km for visualization
    buffer_1km = gpd.GeoSeries([uni_point_27700.buffer(1000)], crs=27700).to_crs(epsg=4326)
    buffer_2km = gpd.GeoSeries([uni_point_27700.buffer(2000)], crs=27700).to_crs(epsg=4326)
    
    # Create folium map centered at university
    m = folium.Map(location=[uni_point.y, uni_point.x], zoom_start=13)
    
    # Plot 1km and 2km buffers
    folium.GeoJson(buffer_2km.iloc[0], name='2km Buffer', style_function=lambda x: {'color': 'blue', 'fill': False, 'weight': 2, 'dashArray': '5, 5'}).add_to(m)
    folium.GeoJson(buffer_1km.iloc[0], name='1km Buffer', style_function=lambda x: {'color': 'red', 'fill': False, 'weight': 2, 'dashArray': '5, 5'}).add_to(m)
    
    # Plot university point
    folium.Marker([uni_point.y, uni_point.x], popup='University of Exeter', icon=folium.Icon(color='green')).add_to(m)
    
    # Plot filtered buildings
    folium.GeoJson(filtered_buildings[['geometry']], name='Buildings 1-2km').add_to(m)
    
    m.save('buildings_1km_2km_from_university.html')
    
    # Prepare summary
    summary_rows = filtered_buildings.head(5)[['osid', 'description', 'buildinguse', 'geometry_area_m2', 'distance_to_uni']]
    summary = f"Plotted {len(filtered_buildings)} buildings between 1km and 2km from the University of Exeter. First 5 results:\n" + summary_rows.to_string(index=False)
    
    return [summary, 'buildings_1km_2km_from_university_map', 'Folium map showing all buildings between 1km and 2km from the University of Exeter, with 1km and 2km buffer rings and the university location.', 'buildings_1km_2km_from_university.html']

