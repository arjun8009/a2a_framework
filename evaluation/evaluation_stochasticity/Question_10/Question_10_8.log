matplotlib.use('Agg')
def filter_university_of_exeter_location(data: list):
    gdf = data[0]
    # Filter for University of Exeter using multiple relevant columns for accuracy
    filtered = gdf[
        (
            gdf['streetname'].str.contains('EXETER', case=False, na=False) |
            gdf['locality'].str.contains('EXETER', case=False, na=False) |
            gdf['townname'].str.contains('EXETER', case=False, na=False)
        ) & (
            gdf['streetname'].str.contains('UNIVERSITY', case=False, na=False) |
            gdf['locality'].str.contains('UNIVERSITY', case=False, na=False)
        )
    ]
    summary = f"Filtered for University of Exeter location. {len(filtered)} entries found."
    artifact_name = 'university_of_exeter_filtered'
    artifact_description = 'Filtered point locations for University of Exeter from exeter_metadata.'
    return [summary, artifact_name, artifact_description, filtered]

