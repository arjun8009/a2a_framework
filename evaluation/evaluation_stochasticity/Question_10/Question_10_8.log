matplotlib.use('Agg')
def filter_exeter_polygon_data(data: list):
    gdf = data[0]
    # Filter for polygons specifically representing 'Exeter' as an area
    # Use all name columns and description columns to ensure accuracy
    mask = (
        ((gdf['name1_text'].str.lower() == 'exeter') |
         (gdf['name2_text'].str.lower() == 'exeter') |
         (gdf['name3_text'].str.lower() == 'exeter') |
         (gdf['name4_text'].str.lower() == 'exeter')) &
        (
            (gdf['descriptiongroup'].str.lower().isin(['settlement', 'land name', 'part of settlement'])) |
            (gdf['description'].str.lower().isin(['city', 'town', 'suburban area', 'village', 'part of settlement']))
        )
    )
    filtered = gdf[mask]
    summary = f"Filtered polygons for 'Exeter' as an area. Number of matching polygons: {len(filtered)}."
    artifact_name = 'filtered_exeter_polygon_data'
    artifact_description = "GeoDataFrame containing only the area polygons specifically representing 'Exeter' (city, town, or settlement) from the original dataset."
    return [summary, artifact_name, artifact_description, filtered]

