matplotlib.use('Agg')
def filter_university_of_exeter_location(data: list):
    gdf = data[0]
    # Filter for University of Exeter using both organisationname and fulladdress for high accuracy
    filtered = gdf[(gdf['organisationname'].str.contains('University of Exeter', case=False, na=False)) |
                   (gdf['fulladdress'].str.contains('University of Exeter', case=False, na=False))]
    summary = f"Filtered locations for 'University of Exeter'. Number of matching entries: {len(filtered)}."
    artifact_name = 'university_of_exeter_filtered_location'
    artifact_description = "Filtered GeoDataFrame containing only the point locations for 'University of Exeter' from the original dataset. Includes all columns and geometry."
    return [summary, artifact_name, artifact_description, filtered]

