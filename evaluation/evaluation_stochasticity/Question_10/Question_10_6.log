matplotlib.use('Agg')
def filter_university_of_exeter_polygon(data: list):
    gdf = data[0]
    # Filter for University of Exeter using all name columns
    mask = (
        (gdf['name1_text'].str.lower() == 'university of exeter') |
        (gdf['name2_text'].str.lower() == 'university of exeter') |
        (gdf['name3_text'].str.lower() == 'university of exeter') |
        (gdf['name4_text'].str.lower() == 'university of exeter')
    )
    filtered = gdf[mask]
    summary = f"Filtered to {len(filtered)} polygon(s) for 'University of Exeter'."
    artifact_name = 'filtered_university_of_exeter_polygon'
    artifact_description = "GeoDataFrame containing only the polygon(s) corresponding to 'University of Exeter', filtered using all available name columns."
    return [summary, artifact_name, artifact_description, filtered]

