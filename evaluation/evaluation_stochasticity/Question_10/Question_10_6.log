matplotlib.use('Agg')
def plot_buildings_between_1km_2km_from_university(data: list):
    import geopandas as gpd
    import folium
    from shapely.geometry import Point
    
    # Unpack data
    buildings = data[0]
    university_points = data[1]
    
    # Set CRS if missing (assume British National Grid EPSG:27700)
    if buildings.crs is None:
        buildings = buildings.set_crs(epsg=27700)
    if university_points.crs is None:
        university_points = university_points.set_crs(epsg=27700)
    
    # Reproject to British National Grid for accurate distance calculations
    buildings = buildings.to_crs(epsg=27700)
    university_points = university_points.to_crs(epsg=27700)
    
    # Create a unary union of all university points
    university_union = university_points.unary_union
    
    # Create 1km and 2km buffers around all university points
    buffer_1km = gpd.GeoSeries([university_union], crs=27700).buffer(1000)
    buffer_2km = gpd.GeoSeries([university_union], crs=27700).buffer(2000)
    
    # The ring is the area between 1km and 2km
    ring = buffer_2km.difference(buffer_1km)
    
    # Select buildings whose centroid falls within the ring
    buildings['centroid'] = buildings.geometry.centroid
    buildings_in_ring = buildings[buildings['centroid'].apply(lambda x: ring.contains(x)[0])].copy()
    
    # Prepare for plotting: convert everything to EPSG:4326 for folium
    buildings_in_ring = buildings_in_ring.to_crs(epsg=4326)
    university_points = university_points.to_crs(epsg=4326)
    ring = ring.to_crs(epsg=4326)
    
    # Create folium map centered on the mean of university points
    mean_lat = university_points.geometry.y.mean()
    mean_lon = university_points.geometry.x.mean()
    m = folium.Map(location=[mean_lat, mean_lon], zoom_start=13)
    
    # Plot the 1km-2km ring
    folium.GeoJson(ring.geometry[0], name='1km-2km Ring', style_function=lambda x: {'fillColor': 'yellow', 'color': 'orange', 'weight': 2, 'fillOpacity': 0.2}).add_to(m)
    
    # Plot university points
    for idx, row in university_points.iterrows():
        folium.Marker(location=[row.geometry.y, row.geometry.x], popup=row.get('name', 'University Point'), icon=folium.Icon(color='blue', icon='university', prefix='fa')).add_to(m)
    
    # Plot buildings in ring
    folium.GeoJson(buildings_in_ring.geometry, name='Buildings 1-2km', style_function=lambda x: {'fillColor': 'red', 'color': 'red', 'weight': 1, 'fillOpacity': 0.4}).add_to(m)
    
    m.save('buildings_1km_2km_from_university.html')
    
    # Prepare summary
    summary_rows = buildings_in_ring[['osid', 'description', 'buildinguse', 'geometry_area_m2']].head(5)
    summary = f"Found {len(buildings_in_ring)} buildings between 1km and 2km from university points. First 5 results:\n" + summary_rows.to_string(index=False)
    
    return [summary, 'buildings_1km_2km_from_university_map', 'Folium map showing all buildings between 1km and 2km from any University of Exeter filtered location, with the buffer ring and university points.', 'buildings_1km_2km_from_university.html']

