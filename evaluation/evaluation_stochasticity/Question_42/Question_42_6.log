matplotlib.use('Agg')
import pandas as pd
def extract_bungalows_in_filtered_exeter(data: list):
    gdf = data[0]
    # Bungalows are typically residential, standalone, 1 floor, no basement
    bungalow_mask = (
        (gdf['buildinguse'].str.contains('Residential', na=False)) &
        (gdf['numberoffloors'] == 1) &
        (gdf['connectivity'] == 'Standalone') &
        (gdf['basementpresence'].isin(['Not Present', None, 'Unknown'])) &
        (gdf['description'].isin([
            'Detached House', 'End-Of-Terrace House', 'Semi-Detached House', 'Mid-Terrace House', 'Residential Building', 'Unknown Building'
        ]))
    )
    bungalows = gdf[bungalow_mask].copy()
    summary = f"Filtered {len(bungalows)} bungalows from {len(gdf)} buildings in Exeter."
    artifact_name = 'bungalows_in_filtered_exeter'
    artifact_description = (
        "GeoDataFrame of buildings in filtered Exeter dataset that are likely bungalows. "
        "Criteria: Residential use, 1 floor, standalone, no basement, and relevant building descriptions."
    )
    return [summary, artifact_name, artifact_description, bungalows]

