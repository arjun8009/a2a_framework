matplotlib.use('Agg')
def plot_bungalows_in_exeter(data: list):
    import geopandas as gpd
    import folium
    import pandas as pd
    from shapely.geometry import mapping
    
    # Unpack data
    bungalows_gdf = data[0].copy()
    exeter_poly_gdf = data[1].copy()
    
    # Filter Exeter boundary (City only, not Topsham)
    exeter_boundary = exeter_poly_gdf[(exeter_poly_gdf['name1_text'] == 'Exeter') & (exeter_poly_gdf['description'] == 'City')]
    
    # Ensure CRS is EPSG:4326 for folium
    if bungalows_gdf.crs is None or bungalows_gdf.crs.to_epsg() != 4326:
        bungalows_gdf = bungalows_gdf.to_crs(epsg=4326)
    if exeter_boundary.crs is None or exeter_boundary.crs.to_epsg() != 4326:
        exeter_boundary = exeter_boundary.to_crs(epsg=4326)
    
    # Remove non-serializable columns for folium plotting
    def remove_non_serializable(df):
        for col in df.columns:
            if pd.api.types.is_datetime64_any_dtype(df[col]):
                df[col] = df[col].astype(str)
        return df
    bungalows_gdf = remove_non_serializable(bungalows_gdf)
    
    # Only keep columns needed for plotting and tooltip
    keep_cols = ['osid', 'description', 'buildinguse', 'geometry_area_m2', 'geometry']
    bungalows_gdf = bungalows_gdf[keep_cols]
    
    # Get centroid for map initialization
    centroid = exeter_boundary.geometry.iloc[0].centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=12, tiles='cartodbpositron')
    
    # Plot Exeter boundary
    folium.GeoJson(
        exeter_boundary.geometry.iloc[0],
        name='Exeter Boundary',
        style_function=lambda x: {'color': 'blue', 'weight': 3, 'fillOpacity': 0.05}
    ).add_to(m)
    
    # Plot bungalows
    folium.GeoJson(
        bungalows_gdf,
        name='Bungalows',
        style_function=lambda x: {'color': 'orange', 'weight': 1, 'fillOpacity': 0.4},
        tooltip=folium.GeoJsonTooltip(fields=['osid', 'description', 'buildinguse', 'geometry_area_m2'])
    ).add_to(m)
    
    m.save('bungalows_in_exeter_map.html')
    # Prepare summary
    preview = bungalows_gdf[['osid', 'description', 'buildinguse', 'geometry_area_m2']].head(5).to_dict('records')
    summary = f"Plotted {len(bungalows_gdf)} bungalows in Exeter. First 5 entries: {preview}"
    return [summary, 'bungalows_in_exeter_map.html', 'Folium map showing all bungalows in Exeter with the city boundary.', 'bungalows_in_exeter_map.html']

