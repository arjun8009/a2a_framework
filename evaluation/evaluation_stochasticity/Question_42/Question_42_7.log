2026-03-05 09:02:10,352 INFO Executing code import matplotlib
matplotlib.use('Agg')
def extract_bungalows_in_filtered_exeter(data: list):
    import pandas as pd
    import geopandas as gpd
    # Assume data[0] is the GeoDataFrame for buildings_all_buildings_in_filtered_exeter
    gdf = data[0]
    # Criteria for bungalows:
    # - Residential use (buildinguse_oslandusetiera == 'Residential Accommodation')
    # - 1 floor (numberoffloors == 1)
    # - No basement (basementpresence == 'Not Present' or is null/unknown)
    # - Description may help, but if not explicit, rely on above
    bungalows = gdf[
        (gdf['buildinguse_oslandusetiera'] == 'Residential Accommodation') &
        (gdf['numberoffloors'] == 1) &
        (
            (gdf['basementpresence'].isnull()) |
            (gdf['basementpresence'].str.lower().isin(['not present', 'unknown']))
        )
    ]
    # Save to CSV (geometry will be dropped for CSV)
    bungalows_no_geom = bungalows.drop(columns=['geometry'])
    bungalows_no_geom.to_csv('bungalows_in_filtered_exeter.csv', index=False)
    summary = f"Extracted {len(bungalows)} bungalows from filtered Exeter buildings."
    artifact_name = 'bungalows_in_filtered_exeter.csv'
    artifact_description = 'CSV file containing all buildings identified as bungalows (single-storey, residential, no basement) in filtered Exeter.'
    return [summary, artifact_name, artifact_description, bungalows_no_geom]
output = extract_bungalows_in_filtered_exeter(data)
