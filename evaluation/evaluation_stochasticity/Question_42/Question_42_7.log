matplotlib.use('Agg')
def plot_bungalows_in_exeter(data: list):
    import geopandas as gpd
    import folium
    from shapely import wkt
    
    df = data[0]
    # Try to find the geometry column (case-insensitive)
    geom_col = None
    for col in df.columns:
        if col.lower() == 'geometry':
            geom_col = col
            break
    if geom_col is None:
        # Try to find a column that looks like WKT
        for col in df.columns:
            if df[col].astype(str).str.startswith('POLYGON').any() or df[col].astype(str).str.startswith('MULTIPOLYGON').any():
                geom_col = col
                break
    if geom_col is None:
        raise ValueError('No geometry column found in the data.')
    # Convert geometry column to shapely objects
    df[geom_col] = df[geom_col].apply(wkt.loads)
    gdf = gpd.GeoDataFrame(df, geometry=geom_col, crs='EPSG:4326')
    
    # Create a folium map centered on Exeter (approximate center)
    exeter_center = [50.7218, -3.5336]
    m = folium.Map(location=exeter_center, zoom_start=13)
    
    # Add all bungalows to the map
    folium.GeoJson(
        gdf,
        name='Bungalows',
        tooltip=folium.GeoJsonTooltip(fields=['osid', 'description', 'buildinguse', 'numberoffloors', 'geometry_area_m2'],
                                      aliases=['OSID', 'Description', 'Building Use', 'Floors', 'Area (m2)'])
    ).add_to(m)
    
    # Save map
    map_filename = 'bungalows_in_exeter_map.html'
    m.save(map_filename)
    
    # Prepare summary
    summary_rows = gdf[['osid', 'description', 'buildinguse', 'numberoffloors', 'geometry_area_m2']].head(5)
    summary = f"Plotted {len(gdf)} bungalows in Exeter. First 5 entries:\n" + summary_rows.to_string(index=False)
    
    return [summary, map_filename, 'Folium map showing all bungalows in Exeter with key attributes in tooltip.', map_filename]

