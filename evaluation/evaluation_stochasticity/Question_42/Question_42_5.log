matplotlib.use('Agg')
def filter_bungalows_in_exeter(data: list):
    import pandas as pd
    import geopandas as gpd
    # Get the first (and only) GeoDataFrame
    gdf = data[0]
    # Filter for residential buildings with only one address and one floor
    filtered = gdf[
        (gdf['buildinguse_addresscount_residential'] > 0) &
        (gdf['buildinguse_addresscount_total'] == 1) &
        (gdf['numberoffloors'] == 1)
    ]
    # Save to CSV
    filtered.to_csv('bungalows_in_filtered_exeter.csv', index=False)
    summary = f"Filtered {len(filtered)} bungalows from {len(gdf)} buildings in Exeter."
    artifact_name = 'bungalows_in_filtered_exeter.csv'
    artifact_description = (
        "A CSV file containing all buildings in Exeter that are likely bungalows: "
        "single-story (numberoffloors == 1), residential (buildinguse_addresscount_residential > 0), "
        "and with only one address (buildinguse_addresscount_total == 1)."
    )
    return [summary, artifact_name, artifact_description, filtered]

