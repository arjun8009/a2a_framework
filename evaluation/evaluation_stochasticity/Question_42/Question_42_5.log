matplotlib.use('Agg')
def plot_bungalows_in_exeter(data: list):
    import geopandas as gpd
    import folium
    import pandas as pd
    # Unpack data
    bungalows_gdf = data[0]
    exeter_boundary_gdf = data[1]

    # Drop all columns with dtype 'datetime64' to avoid serialization issues
    bungalows_gdf = bungalows_gdf[[col for col in bungalows_gdf.columns if not pd.api.types.is_datetime64_any_dtype(bungalows_gdf[col])]]
    exeter_boundary_gdf = exeter_boundary_gdf[[col for col in exeter_boundary_gdf.columns if not pd.api.types.is_datetime64_any_dtype(exeter_boundary_gdf[col])]]

    # Ensure CRS is EPSG:4326 for folium
    if bungalows_gdf.crs is None or bungalows_gdf.crs.to_epsg() != 4326:
        bungalows_gdf = bungalows_gdf.to_crs(epsg=4326)
    if exeter_boundary_gdf.crs is None or exeter_boundary_gdf.crs.to_epsg() != 4326:
        exeter_boundary_gdf = exeter_boundary_gdf.to_crs(epsg=4326)

    # Get centroid of Exeter for map centering
    exeter_centroid = exeter_boundary_gdf.geometry.iloc[0].centroid
    m = folium.Map(location=[exeter_centroid.y, exeter_centroid.x], zoom_start=12, tiles='cartodbpositron')

    # Plot Exeter boundary
    folium.GeoJson(
        exeter_boundary_gdf,
        name='Exeter Boundary',
        style_function=lambda x: {'color': 'blue', 'weight': 3, 'fillOpacity': 0.05}
    ).add_to(m)

    # Plot bungalows
    folium.GeoJson(
        bungalows_gdf,
        name='Bungalows',
        style_function=lambda x: {'color': 'red', 'weight': 1, 'fillOpacity': 0.4}
    ).add_to(m)

    folium.LayerControl().add_to(m)
    
    # Save map
    map_filename = 'bungalows_in_exeter_map.html'
    m.save(map_filename)

    # Prepare summary
    preview = bungalows_gdf.head(5)[['osid', 'description', 'geometry_area_m2', 'buildinguse', 'numberoffloors']]
    summary = f"Plotted {len(bungalows_gdf)} bungalows in Exeter. First 5 entries: {preview.to_dict(orient='records')}"
    artifact_name = 'bungalows_in_exeter_map'
    artifact_description = 'Folium map showing all bungalows in Exeter overlaid with the Exeter city boundary.'
    return [summary, artifact_name, artifact_description, map_filename]
