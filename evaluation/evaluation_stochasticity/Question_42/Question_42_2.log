def extract_bungalows_in_filtered_exeter(data: list):
    import pandas as pd
    import geopandas as gpd
    # Bungalows are typically residential, detached or semi-detached, standalone or semi-connected, and have only 1 floor, and no basement
    gdf = data[0]
    # Use all relevant columns for best accuracy
    bungalow_mask = (
        (gdf['buildinguse'].str.contains('Residential', case=False, na=False)) &
        (gdf['description'].isin(['Detached House', 'Semi-Detached House', 'End-Of-Terrace House', 'Mid-Terrace House', 'Residential Building'])) &
        (gdf['numberoffloors'] == 1) &
        (gdf['basementpresence'].isin(['Not Present', None, 'Unknown']))
    )
    bungalows = gdf[bungalow_mask].copy()
    summary = f"Filtered {len(bungalows)} bungalows from {len(gdf)} buildings in filtered Exeter. Bungalows were identified as residential buildings (detached, semi-detached, end/mid-terrace, or residential building) with exactly 1 floor and no basement (or unknown basement status)."
    artifact_name = 'bungalows_in_filtered_exeter'
    artifact_description = "GeoDataFrame of buildings in filtered Exeter identified as bungalows using the following logic: building is residential, description is one of ['Detached House', 'Semi-Detached House', 'End-Of-Terrace House', 'Mid-Terrace House', 'Residential Building'], number of floors is 1, and basement is not present or unknown."
    return [summary, artifact_name, artifact_description, bungalows]

