matplotlib.use('Agg')
def plot_bungalows_in_exeter(data: list):
    import folium
    import geopandas as gpd
    import pandas as pd
    # Get the GeoDataFrame
    gdf = data[0].copy()
    # Convert all datetime columns to string for folium compatibility
    for col in gdf.columns:
        if pd.api.types.is_datetime64_any_dtype(gdf[col]):
            gdf[col] = gdf[col].astype(str)
    # Ensure CRS is EPSG:4326 for folium
    if gdf.crs is not None and gdf.crs.to_epsg() != 4326:
        gdf = gdf.to_crs(epsg=4326)
    # Center map on Exeter (approximate center from data)
    centroid = gdf.geometry.unary_union.centroid
    m = folium.Map(location=[centroid.y, centroid.x], zoom_start=13, tiles='cartodbpositron')
    # Add polygons to map
    folium.GeoJson(
        gdf,
        name='Bungalows',
        tooltip=folium.GeoJsonTooltip(fields=['osid', 'description', 'buildinguse', 'numberoffloors', 'geometry_area_m2'],
                                      aliases=['OSID', 'Description', 'Building Use', 'Floors', 'Area (m2)'])
    ).add_to(m)
    # Save map
    map_filename = 'bungalows_in_exeter_map.html'
    m.save(map_filename)
    # Prepare summary
    preview = gdf[['osid', 'description', 'buildinguse', 'numberoffloors', 'geometry_area_m2']].head(5).to_dict('records')
    summary = f"Plotted {len(gdf)} bungalows in Exeter. First 5 entries: {preview}"
    artifact_name = 'bungalows_in_exeter_map'
    artifact_description = 'Folium map showing all bungalows in Exeter as polygons with tooltips for OSID, description, use, floors, and area.'
    return [summary, artifact_name, artifact_description, map_filename]

